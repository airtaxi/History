@inherits MvvmCardBase<BasePostViewModel>

<article class="card" @onclick="OnCardClicked">
    <div class="card-header">
        <img class="avatar avatar-36" src="@ViewModel.ProfileMedia?.Uri" @onclick="OnProfileClicked" @onclick:stopPropagation="true" />
        <div class="header-text">
            <div class="name-row">
                <span class="name">@ViewModel.Nickname</span>
                @if (ViewModel.IsAdmin)
                {
                    <span class="badge-icon badge-crown">@Solid.Crown</span>
                }
                @if (ViewModel.IsModerator)
                {
                    <span class="badge-icon badge-gavel">@Solid.Gavel</span>
                }
            </div>
            <div class="time-row">
                <span class="time">@ViewModel.TimestampText</span>
            </div>
        </div>
        <button type="button" class="icon-button more-button" @onclick="OnMoreClicked" @onclick:stopPropagation="true"><span class="mi">@MaterialSharp.More_horiz</span></button>
    </div>

    @if (ViewModel.TimelineContents != null)
    {
        <PostContents ViewModel="ViewModel.TimelineContents" />
    }

    @if (ViewModel.IsShare && ViewModel.ParentPost != null)
    {
        <div class="shared-post" @onclick="OnParentPostClicked" @onclick:stopPropagation="true">
            <div class="divider"></div>
            <div class="shared-header">
                <img class="avatar avatar-28" src="@ViewModel.ParentPost.ProfileMedia?.Uri" />
                <div class="shared-name-row">
                    <span class="name">@ViewModel.ParentPost.Nickname</span>
                    @if (ViewModel.ParentPost.IsAdmin)
                    {
                        <span class="badge-icon badge-crown">@Solid.Crown</span>
                    }
                    @if (ViewModel.ParentPost.IsModerator)
                    {
                        <span class="badge-icon badge-gavel">@Solid.Gavel</span>
                    }
                </div>
                <span class="share-count">
                    <span class="mi">@MaterialSharp.Share</span>
                    <span class="share-count-text">@ViewModel.ParentPost.SharedUsersCount</span>
                </span>
            </div>
            @if (ViewModel.ParentPost.TimelineContents != null)
            {
                <PostContents ViewModel="ViewModel.ParentPost.TimelineContents" />
            }
        </div>
    }
</article>

@code {
    // The whole card opens the author's profile, mirroring the XAML PublicPostTemplate.
    private Task OnCardClicked() => ViewModel.HandleProfileTapCommand.ExecuteAsync(null);

    private Task OnProfileClicked() => ViewModel.HandleProfileTapCommand.ExecuteAsync(null);

    private Task OnMoreClicked() => ViewModel is HistoryPublicPostViewModel publicViewModel ? publicViewModel.HandlePublicPostMoreTapCommand.ExecuteAsync(null) : Task.CompletedTask;

    private Task OnParentPostClicked() => ViewModel.ParentPost.HandleTapCommand.ExecuteAsync(null);
}
