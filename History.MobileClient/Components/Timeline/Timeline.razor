<MasonryFeed Feed="ViewModel">
    <Header>
        <div class="pills">
            <button type="button" class="pill @(ViewModel.IsKakaoStoryMode ? string.Empty : "pill-active")" @onclick="OnHistoryPillClick">히스토리</button>
            <button type="button" class="pill @(ViewModel.IsKakaoStoryMode ? "pill-active" : string.Empty)" @onclick="OnKakaoStoryPillClick">카카오스토리</button>
        </div>
    </Header>
</MasonryFeed>

@code {
    [Parameter, EditorRequired]
    public TimelineViewModel ViewModel { get; set; }

    private Task OnHistoryPillClick() => ViewModel.SwitchModeAsync(false);

    private Task OnKakaoStoryPillClick() => ViewModel.SwitchModeAsync(true);
}
