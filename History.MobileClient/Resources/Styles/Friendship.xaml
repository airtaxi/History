<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="History.MobileClient.Resources.Styles.Friendship"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
    xmlns:m="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    xmlns:views="clr-namespace:History.MobileClient.ContentViews"
    xmlns:vm="clr-namespace:History.MobileClient.ViewModels">

    <DataTemplate x:Key="FriendshipTemplate" x:DataType="vm:FriendshipViewModel">
        <Grid Padding="12,8,12,8" ColumnSpacing="12">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTapped" />
            </Grid.GestureRecognizers>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>
            <views:DataTemplatePresenter
                Grid.Column="0"
                HeightRequest="32"
                Template="{StaticResource MediaTemplateSelector}"
                ViewModel="{x:Binding ProfileMedia}"
                WidthRequest="32">
                <views:DataTemplatePresenter.Clip>
                    <EllipseGeometry
                        Center="16,16"
                        RadiusX="16"
                        RadiusY="16" />
                </views:DataTemplatePresenter.Clip>
            </views:DataTemplatePresenter>
            <HorizontalStackLayout Grid.Column="1" Spacing="4">
                <Image
                    HeightRequest="20"
                    IsVisible="{x:Binding IsAdmin}"
                    WidthRequest="20">
                    <Image.Source>
                        <FontImageSource
                            FontFamily="FASolid"
                            Glyph="{x:Static fa:Solid.Crown}"
                            Color="#f78501" />
                    </Image.Source>
                </Image>
                <Image
                    HeightRequest="20"
                    IsVisible="{x:Binding IsModerator}"
                    WidthRequest="20">
                    <Image.Source>
                        <FontImageSource
                            FontFamily="FASolid"
                            Glyph="{x:Static fa:Solid.Gavel}"
                            Color="#1a5bf3" />
                    </Image.Source>
                </Image>
                <Label
                    FontAttributes="Bold"
                    FontSize="20"
                    LineBreakMode="TailTruncation"
                    Text="{x:Binding Nickname}" />
            </HorizontalStackLayout>
            <Image
                Grid.Column="2"
                HeightRequest="32"
                WidthRequest="32">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFriendshipImageTapped" />
                </Image.GestureRecognizers>
                <Image.Source>
                    <FontImageSource
                        FontFamily="MaterialSharp"
                        Glyph="{x:Binding FriendshipGlyph}"
                        Color="#808080" />
                </Image.Source>
            </Image>
            <Rectangle
                Grid.ColumnSpan="3"
                Margin="-12,0,-12,-8"
                Fill="#808080"
                HeightRequest="1"
                HorizontalOptions="Fill"
                VerticalOptions="End" />
        </Grid>
    </DataTemplate>

</ResourceDictionary>