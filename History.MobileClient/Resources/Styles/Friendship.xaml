<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="History.MobileClient.Resources.Styles.Friendship"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
    xmlns:m="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    xmlns:views="clr-namespace:History.MobileClient.ContentViews"
    xmlns:vm="clr-namespace:History.MobileClient.ViewModels">

    <DataTemplate x:Key="FriendshipTemplate" x:DataType="vm:BaseFriendshipViewModel">
        <Grid>
            <Grid Padding="12,8,12,8" ColumnSpacing="12">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{x:Binding HandleTapCommand}" />
                </Grid.GestureRecognizers>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <Grid
                    Grid.Column="0"
                    HeightRequest="32"
                    VerticalOptions="Center"
                    WidthRequest="32">
                    <views:DataTemplatePresenter
                        HeightRequest="32"
                        Template="{StaticResource MediaTemplateSelector}"
                        ViewModel="{x:Binding ProfileMedia}"
                        WidthRequest="32">
                        <views:DataTemplatePresenter.Clip>
                            <EllipseGeometry
                                Center="16,16"
                                RadiusX="16"
                                RadiusY="16" />
                        </views:DataTemplatePresenter.Clip>
                    </views:DataTemplatePresenter>
                    <Grid
                        Margin="0,0,-2,-2"
                        BindingContext="{x:Binding InteractionViewModel}"
                        IsVisible="{x:Binding IsInteractionAvailable}">
                        <Border
                            x:Name="InteractionBorder"
                            x:DataType="vm:BaseInteractionViewModel"
                            Background="{x:Binding Color}"
                            HeightRequest="16"
                            HorizontalOptions="End"
                            StrokeThickness="0"
                            VerticalOptions="End"
                            WidthRequest="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Image HeightRequest="{x:Binding IconSize}" WidthRequest="{x:Binding IconSize}">
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="{x:Binding FontFamily}"
                                        Glyph="{x:Binding Glyph}"
                                        Color="White" />
                                </Image.Source>
                            </Image>
                        </Border>
                    </Grid>
                </Grid>
                <HorizontalStackLayout
                    Grid.Column="1"
                    Spacing="4"
                    VerticalOptions="Center">
                    <Label
                        FontAttributes="Bold"
                        FontSize="20"
                        LineBreakMode="TailTruncation"
                        Text="{x:Binding Nickname}" />
                    <Image
                        HeightRequest="20"
                        IsVisible="{x:Binding IsAdmin}"
                        WidthRequest="20">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="FASolid"
                                Glyph="{x:Static fa:Solid.Crown}"
                                Color="#f78501" />
                        </Image.Source>
                    </Image>
                    <Image
                        HeightRequest="20"
                        IsVisible="{x:Binding IsModerator}"
                        WidthRequest="20">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="FASolid"
                                Glyph="{x:Static fa:Solid.Gavel}"
                                Color="#1a5bf3" />
                        </Image.Source>
                    </Image>
                </HorizontalStackLayout>
                <Image
                    Grid.Column="2"
                    HeightRequest="24"
                    IsVisible="{x:Binding IsFriendshipImageVisible}"
                    VerticalOptions="Center"
                    WidthRequest="24">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{x:Binding HandleFriendshipActionCommand}" />
                    </Image.GestureRecognizers>
                    <Image.Source>
                        <FontImageSource
                            FontFamily="FASolid"
                            Glyph="{x:Binding FriendshipGlyph}"
                            Color="{x:Binding FriendshipColor}" />
                    </Image.Source>
                </Image>
            </Grid>
            <Rectangle
                Fill="#808080"
                HeightRequest="{OnPlatform iOS=1.5,
                                           Android=1}"
                HorizontalOptions="Fill"
                VerticalOptions="End" />
        </Grid>
    </DataTemplate>

</ResourceDictionary>