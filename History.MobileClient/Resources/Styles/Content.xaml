<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="History.MobileClient.Resources.Styles.Content"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:m="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:views="clr-namespace:History.MobileClient.ContentViews"
    xmlns:vm="clr-namespace:History.MobileClient.ViewModels">

    <DataTemplate x:Key="MediaContentTemplate" x:DataType="vm:MediaContentViewModel">
        <Grid>
            <!--  View  -->
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{x:Binding HandleTapCommand}" />
            </Grid.GestureRecognizers>

            <views:DataTemplatePresenter
                x:Name="MediaContentView"
                Template="{StaticResource MediaTemplateSelector}"
                ViewModel="{x:Binding Media}">
                <views:DataTemplatePresenter.Behaviors>
                    <toolkit:EventToCommandBehavior
                        BindingContext="{Binding Path=BindingContext, Source={x:Reference MediaContentView}, x:DataType=views:DataTemplatePresenter}"
                        Command="{x:Binding UnloadedCommand}"
                        EventName="Unloaded" />
                </views:DataTemplatePresenter.Behaviors>
            </views:DataTemplatePresenter>

            <!--  Overlay  -->
            <Grid
                HorizontalOptions="Fill"
                IsVisible="{x:Binding IsOverlayVisible}"
                VerticalOptions="Fill">
                <Grid.Background>
                    <SolidColorBrush Color="#80000000" />
                </Grid.Background>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{x:Binding HandleOverlayTapCommand}" />
                </Grid.GestureRecognizers>
                <Image
                    HeightRequest="150"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="150">
                    <Image.Source>
                        <FontImageSource
                            FontFamily="MaterialSharp"
                            Glyph="{x:Static m:MaterialSharp.Play_circle}"
                            Size="150" />
                    </Image.Source>
                </Image>
            </Grid>

            <!--  Spoiler Overlay  -->
            <Grid
                HorizontalOptions="Fill"
                IsVisible="{x:Binding IsSpoilerOverlayVisible}"
                VerticalOptions="Fill">
                <Grid.Background>
                    <SolidColorBrush Color="#FF000000" />
                </Grid.Background>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{x:Binding HandleSpoilerOverlayTapCommand}" />
                </Grid.GestureRecognizers>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                    <Image
                        HeightRequest="48"
                        HorizontalOptions="Center"
                        WidthRequest="48">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="MaterialSharp"
                                Glyph="{x:Static m:MaterialSharp.Visibility_off}"
                                Size="48"
                                Color="White" />
                        </Image.Source>
                    </Image>
                    <Label
                        Margin="0,8,0,0"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        Text="가려진 미디어"
                        TextColor="White" />
                    <Label
                        FontSize="12"
                        HorizontalOptions="Center"
                        Text="탭하여 확인하기"
                        TextColor="#CCCCCC" />
                </VerticalStackLayout>
            </Grid>

            <!--  Description  -->
            <Grid
                BackgroundColor="#80000000"
                HeightRequest="40"
                HorizontalOptions="Fill"
                IsVisible="{x:Binding HasDescription}"
                VerticalOptions="Start">
                <Label
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="TailTruncation"
                    MaxLines="2"
                    Text="{x:Binding Description}"
                    TextColor="White"
                    VerticalTextAlignment="Center" />
            </Grid>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="AndroidWrappedMediaContentsTemplate" x:DataType="vm:WrappedMediaContentsViewModel">
        <Grid>
            <CarouselView
                BackgroundColor="#808080"
                CurrentItem="{x:Binding FirstMedia}"
                HeightRequest="{x:Binding CarouselViewHeight,
                                          Mode=OneWay}"
                HorizontalOptions="{x:Binding CarouselViewHorizontalOptions,
                                              Mode=OneWay}"
                HorizontalScrollBarVisibility="Never"
                ItemTemplate="{StaticResource MediaContentTemplate}"
                ItemsSource="{x:Binding Medias}"
                MaximumHeightRequest="{x:Binding MaxCarouselViewHeight}"
                Position="{x:Binding CarouselPosition,
                                     Mode=OneWayToSource}"
                SizeChanged="OnWrappedMediaContentsCarouselViewSizeChanged"
                WidthRequest="{x:Binding CarouselViewWidth,
                                         Mode=OneWay}">
                <CarouselView.Clip>
                    <RoundRectangleGeometry CornerRadius="6" />
                </CarouselView.Clip>
            </CarouselView>

            <Border
                Margin="12"
                Padding="6,4,6,4"
                Background="#80808080"
                HorizontalOptions="End"
                IsVisible="{x:Binding CarouselSwipeEnabled}"
                StrokeThickness="0"
                VerticalOptions="End">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Label
                    FontAttributes="Bold"
                    Text="{x:Binding CarouselPositionText}"
                    TextColor="White" />
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="AppleWrappedMediaContentsTemplate" x:DataType="vm:WrappedMediaContentsViewModel">
        <Grid>
            <CarouselView
                HeightRequest="{x:Binding CarouselViewHeight,
                                          Mode=OneWay}"
                HorizontalOptions="{x:Binding CarouselViewHorizontalOptions,
                                              Mode=OneWay}"
                HorizontalScrollBarVisibility="Never"
                IsSwipeEnabled="{x:Binding CarouselSwipeEnabled}"
                ItemTemplate="{StaticResource MediaContentTemplate}"
                ItemsSource="{x:Binding Medias}"
                MaximumHeightRequest="{x:Binding MaxCarouselViewHeight,
                                                 Mode=OneWay}"
                MinimumHeightRequest="{x:Binding MinCarouselViewHeight,
                                                 Mode=OneWay}"
                Position="{x:Binding CarouselPosition,
                                     Mode=OneWayToSource}"
                SizeChanged="OnWrappedMediaContentsCarouselViewSizeChanged">
                <CarouselView.Clip>
                    <RoundRectangleGeometry CornerRadius="6" />
                </CarouselView.Clip>
            </CarouselView>
            <Border
                Margin="12"
                Padding="6,4,6,4"
                Background="#80808080"
                HorizontalOptions="End"
                IsVisible="{x:Binding CarouselSwipeEnabled}"
                StrokeThickness="0"
                VerticalOptions="End">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Label
                    FontAttributes="Bold"
                    Text="{x:Binding CarouselPositionText}"
                    TextColor="White" />
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="StickerContentTemplate" x:DataType="vm:StickerContentViewModel">
        <ffimageloading:CachedImage
            Aspect="AspectFit"
            DownsampleToViewSize="True"
            HeightRequest="120"
            HorizontalOptions="Start"
            Source="{x:Binding Media.Uri,
                               Mode=OneTime}"
            VerticalOptions="Start"
            WidthRequest="120">
            <ffimageloading:CachedImage.GestureRecognizers>
                <TapGestureRecognizer Command="{x:Binding NavigateToStickerDetailCommand}" />
            </ffimageloading:CachedImage.GestureRecognizers>
        </ffimageloading:CachedImage>
    </DataTemplate>

    <DataTemplate x:Key="TextTypeContentsTemplate" x:DataType="vm:TextTypeContentsViewModel">
        <Label FormattedText="{x:Binding FormattedString}" SizeChanged="OnTextTypeContentsLabelSizeChanged">
            <Label.Behaviors>
                <toolkit:TouchBehavior LongPressCompleted="OnTextTypeContentsLabelLongPressed" TouchGestureCompleted="OnTextTypeContentsLabelTouchGestureCompleted" />
            </Label.Behaviors>
        </Label>
    </DataTemplate>

    <DataTemplate x:Key="PollContentTemplate" x:DataType="vm:PollContentViewModel">
        <Border
            Margin="0,8"
            Padding="12"
            BackgroundColor="{AppThemeBinding Light=#F0F0F0,
                                              Dark=#2A2A2A}"
            StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="8">
                <!--  Question  -->
                <Label
                    FontAttributes="Bold"
                    FontSize="16"
                    Text="{x:Binding Question}" />

                <!--  Options  -->
                <VerticalStackLayout BindableLayout.ItemsSource="{x:Binding Options}" Spacing="6">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:PollOptionViewModel">
                            <Border
                                Padding="12,10"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF,
                                                                  Dark=#3A3A3A}"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{x:Binding SelectCommand}" />
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="Auto,Auto">
                                    <!--  Progress Background  -->
                                    <ProgressBar
                                        Grid.Row="0"
                                        HeightRequest="6"
                                        IsVisible="{x:Binding ShowResults}"
                                        Progress="{x:Binding Percentage}"
                                        ProgressColor="{StaticResource Primary}" />

                                    <Grid
                                        Grid.Row="1"
                                        Margin="0,6,0,0"
                                        ColumnDefinitions="Auto,*,Auto">
                                        <!--  Selection Indicator  -->
                                        <Border
                                            Grid.Column="0"
                                            Margin="0,0,10,0"
                                            BackgroundColor="{x:Binding IsSelected,
                                                                        Converter={StaticResource BoolToPrimaryColorConverter}}"
                                            HeightRequest="20"
                                            StrokeThickness="1"
                                            WidthRequest="20">
                                            <Border.StrokeShape>
                                                <Ellipse />
                                            </Border.StrokeShape>
                                            <Border.Stroke>
                                                <SolidColorBrush Color="{StaticResource Primary}" />
                                            </Border.Stroke>
                                            <Image
                                                HeightRequest="12"
                                                HorizontalOptions="Center"
                                                IsVisible="{x:Binding IsSelected}"
                                                VerticalOptions="Center"
                                                WidthRequest="12">
                                                <Image.Source>
                                                    <FontImageSource
                                                        FontFamily="MaterialSharp"
                                                        Glyph="{x:Static m:MaterialSharp.Check}"
                                                        Size="12"
                                                        Color="White" />
                                                </Image.Source>
                                            </Image>
                                        </Border>

                                        <!--  Option Text  -->
                                        <Label
                                            Grid.Column="1"
                                            Text="{x:Binding Text}"
                                            VerticalOptions="Center" />

                                        <!--  Vote Count / Percentage  -->
                                        <Label
                                            Grid.Column="2"
                                            FontAttributes="Bold"
                                            IsVisible="{x:Binding ShowResults}"
                                            Text="{x:Binding PercentageText}"
                                            TextColor="{StaticResource Primary}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!--  Footer Info  -->
                <Grid Margin="0,4,0,0" ColumnDefinitions="*,Auto,Auto">
                    <Label
                        Grid.Column="0"
                        FontSize="12"
                        Text="{x:Binding TotalVotesText}"
                        TextColor="{AppThemeBinding Light=#666666,
                                                    Dark=#AAAAAA}"
                        VerticalOptions="Center" />
                    <!--  View Results Button  -->
                    <Label
                        Grid.Column="1"
                        Margin="0,0,12,0"
                        FontSize="12"
                        IsVisible="{x:Binding ShowResultsButton}"
                        Text="결과보기"
                        TextColor="{StaticResource Primary}"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{x:Binding ViewResultsCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label
                        Grid.Column="2"
                        FontSize="12"
                        Text="{x:Binding ExpiresAtText}"
                        TextColor="{AppThemeBinding Light=#666666,
                                                    Dark=#AAAAAA}"
                        VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="ExternalUrlContentTemplate" x:DataType="vm:ExternalUrlContentViewModel">
        <Grid HeightRequest="250" IsClippedToBounds="True">
            <Rectangle
                Margin="-4"
                Fill="#808080"
                HorizontalOptions="Fill"
                Opacity="0.4"
                VerticalOptions="Fill" />

            <views:DataTemplatePresenter Template="{StaticResource ImageTemplate}" ViewModel="{x:Binding ThumbnailImage}" />

            <Rectangle
                x:Name="ExternalUrlOverlayRectangle"
                Margin="-4"
                Fill="Black"
                HorizontalOptions="Fill"
                Opacity="0.4"
                VerticalOptions="Fill">
                <Rectangle.Behaviors>
                    <toolkit:TouchBehavior
                        BindingContext="{Binding Path=BindingContext, Source={x:Reference ExternalUrlOverlayRectangle}, x:DataType=Rectangle}"
                        Command="{x:Binding HandleTapCommand}"
                        LongPressCommand="{x:Binding HandleLongPressCommand}" />
                </Rectangle.Behaviors>
            </Rectangle>

            <VerticalStackLayout Padding="12" VerticalOptions="End">
                <Label
                    FontSize="12"
                    LineBreakMode="TailTruncation"
                    MaxLines="1"
                    Text="{x:Binding Domain}"
                    TextColor="#CCCCCC" />
                <Label
                    Margin="0,4,0,0"
                    FontSize="16"
                    LineBreakMode="TailTruncation"
                    MaxLines="1"
                    Text="{x:Binding Title}"
                    TextColor="White" />
                <Label
                    Margin="0,2,0,0"
                    FontSize="14"
                    LineBreakMode="TailTruncation"
                    MaxLines="1"
                    Text="{x:Binding Description}"
                    TextColor="#CCCCCC" />
            </VerticalStackLayout>
        </Grid>
    </DataTemplate>

    <vm:ContentTemplateSelector
        x:Key="ContentTemplateSelector"
        AndroidWrappedMediaContentsTemplate="{StaticResource AndroidWrappedMediaContentsTemplate}"
        AppleWrappedMediaContentsTemplate="{StaticResource AppleWrappedMediaContentsTemplate}"
        ExternalUrlContentTemplate="{StaticResource ExternalUrlContentTemplate}"
        MediaContentTemplate="{StaticResource MediaContentTemplate}"
        PollContentTemplate="{StaticResource PollContentTemplate}"
        StickerContentTemplate="{StaticResource StickerContentTemplate}"
        TextTypeContentsTemplate="{StaticResource TextTypeContentsTemplate}" />
</ResourceDictionary>