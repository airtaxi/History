<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="History.MobileClient.Resources.Styles.Icons"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
    xmlns:m="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols">

    <!--  Badge icons (static color, shared across all post/comment templates)  -->
    <FontImageSource
        x:Key="CrownIcon"
        FontFamily="FASolid"
        Glyph="{x:Static fa:Solid.Crown}"
        Color="#f78501" />
    <FontImageSource
        x:Key="GavelIcon"
        FontFamily="FASolid"
        Glyph="{x:Static fa:Solid.Gavel}"
        Color="#1a5bf3" />

    <!--  Action icons (theme-aware, shared across templates)  -->
    <FontImageSource
        x:Key="MoreHorizIcon"
        FontFamily="MaterialSharp"
        Glyph="{x:Static m:MaterialSharp.More_horiz}"
        Color="{AppThemeBinding Dark=White,
                                Light=Black}" />
    <FontImageSource
        x:Key="CommentsIcon"
        FontFamily="FARegular"
        Glyph="{x:Static fa:Regular.Comments}"
        Color="{AppThemeBinding Dark=#FFFFFF,
                                Light=#000000}" />
    <FontImageSource
        x:Key="ShareIcon"
        FontFamily="MaterialSharp"
        Glyph="{x:Static m:MaterialSharp.Share}"
        Color="{AppThemeBinding Dark=White,
                                Light=Black}" />
    <FontImageSource
        x:Key="ShiftLockIcon"
        FontFamily="MaterialSharp"
        Glyph="{x:Static m:MaterialSharp.Shift_lock}"
        Color="{AppThemeBinding Dark=White,
                                Light=Black}" />
    <FontImageSource
        x:Key="ShiftLockRepostIcon"
        FontFamily="MaterialSharp"
        Glyph="{x:Static m:MaterialSharp.Shift_lock}"
        Color="{AppThemeBinding Dark=#000000,
                                Light=#FFFFFF}" />
</ResourceDictionary>