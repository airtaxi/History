<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    x:Class="History.MobileClient.Resources.Styles.SharedPost"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://schemas.microsoft.com/dotnet/2021/maui/design"
    xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
    xmlns:local="clr-namespace:History.MobileClient.Resources.Styles"
    xmlns:m="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:History.MobileClient.ContentViews"
    xmlns:vm="clr-namespace:History.MobileClient.ViewModels;assembly=History.MobileClient"
    mc:Ignorable="d">
    <DataTemplate x:Key="SharedPostTemplate" x:DataType="vm:BasePostViewModel">
        <Grid Margin="6">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{x:Binding HandleTapCommand}" />
            </Grid.GestureRecognizers>
            <Rectangle
                Fill="#808080"
                HeightRequest="{OnPlatform iOS=1.5,
                                           Android=1}"
                HorizontalOptions="Fill"
                VerticalOptions="Start" />
            <VerticalStackLayout Margin="0,10,0,0" Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <HorizontalStackLayout Grid.Column="0" Spacing="6">
                        <views:DataTemplatePresenter
                            HeightRequest="28"
                            Template="{StaticResource MediaTemplateSelector}"
                            ViewModel="{x:Binding ProfileMedia}"
                            WidthRequest="28">
                            <views:DataTemplatePresenter.GestureRecognizers>
                                <TapGestureRecognizer Command="{x:Binding HandleProfileTapCommand}" />
                            </views:DataTemplatePresenter.GestureRecognizers>
                            <views:DataTemplatePresenter.Clip>
                                <EllipseGeometry
                                    Center="14,14"
                                    RadiusX="14"
                                    RadiusY="14" />
                            </views:DataTemplatePresenter.Clip>
                        </views:DataTemplatePresenter>
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold"
                                FontSize="14"
                                LineBreakMode="TailTruncation"
                                Text="{x:Binding Nickname}" />
                            <Image
                                HeightRequest="14"
                                IsVisible="{x:Binding IsAdmin}"
                                Source="{StaticResource CrownIcon}"
                                WidthRequest="14" />
                            <Image
                                HeightRequest="14"
                                IsVisible="{x:Binding IsModerator}"
                                Source="{StaticResource GavelIcon}"
                                VerticalOptions="Center"
                                WidthRequest="14" />
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout
                        Grid.Column="2"
                        HorizontalOptions="End"
                        Spacing="4"
                        VerticalOptions="Center">
                        <Image
                            HeightRequest="14"
                            Source="{StaticResource ShareIcon}"
                            WidthRequest="14">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{x:Binding HandleMoreTapCommand}" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Label
                            FontAttributes="Bold"
                            FontSize="14"
                            Text="{x:Binding SharedUsersCount}" />
                    </HorizontalStackLayout>
                </Grid>
                <views:DataTemplatePresenter
                    Template="{StaticResource TimelineContentsTemplate}"
                    ViewModel="{x:Binding TimelineContents}" />
            </VerticalStackLayout>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
