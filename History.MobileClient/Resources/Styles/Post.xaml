<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="History.MobileClient.Resources.Styles.Post"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
    xmlns:m="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    xmlns:views="clr-namespace:History.MobileClient.ContentViews"
    xmlns:vm="clr-namespace:History.MobileClient.ViewModels">

    <DataTemplate x:Key="PostTemplate" x:DataType="vm:PostViewModel">
        <Border
            Margin="6"
            Padding="12"
            StrokeThickness="1.5">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{x:Binding HandleTapCommand}" />
            </Border.GestureRecognizers>
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <HorizontalStackLayout Spacing="6">
                        <Grid
                            HorizontalOptions="Start"
                            Loaded="OnProfileGridLoaded"
                            VerticalOptions="Start">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnProfileImageTapped" />
                            </Grid.GestureRecognizers>
                            <views:DataTemplatePresenter
                                HeightRequest="48"
                                Template="{StaticResource MediaTemplateSelector}"
                                ViewModel="{x:Binding ProfileMedia}"
                                WidthRequest="48">
                                <views:DataTemplatePresenter.Clip>
                                    <EllipseGeometry
                                        Center="24,24"
                                        RadiusX="24"
                                        RadiusY="24" />
                                </views:DataTemplatePresenter.Clip>
                            </views:DataTemplatePresenter>
                        </Grid>
                        <VerticalStackLayout VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="4">
                                <Image
                                    HeightRequest="16"
                                    IsVisible="{x:Binding IsAdmin}"
                                    WidthRequest="16">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="FASolid"
                                            Glyph="{x:Static fa:Solid.Crown}"
                                            Color="#f78501" />
                                    </Image.Source>
                                </Image>
                                <Image
                                    HeightRequest="16"
                                    IsVisible="{x:Binding IsModerator}"
                                    WidthRequest="16">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="FASolid"
                                            Glyph="{x:Static fa:Solid.Gavel}"
                                            Color="#1a5bf3" />
                                    </Image.Source>
                                </Image>
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    LineBreakMode="TailTruncation"
                                    Text="{x:Binding Nickname}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout>
                                <Label FontSize="14" TextColor="#808080">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Binding TimestampText}" />
                                            <Span Text=" · " />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Image HeightRequest="14" WidthRequest="14">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="FASolid"
                                            Glyph="{x:Binding DiscoveryOptionGlyph}"
                                            Color="#808080" />
                                    </Image.Source>
                                </Image>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <Image
                        HeightRequest="28"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        WidthRequest="28">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMoreImageTapped" />
                        </Image.GestureRecognizers>
                        <Image.Source>
                            <FontImageSource
                                FontFamily="MaterialSharp"
                                Glyph="{x:Static m:MaterialSharp.More_horiz}"
                                Color="{AppThemeBinding Dark=White,
                                                        Light=Black}" />
                        </Image.Source>
                    </Image>
                </Grid>
                <Grid Grid.Row="1">
                    <VerticalStackLayout
                        BindableLayout.ItemTemplateSelector="{StaticResource ContentTemplateSelector}"
                        BindableLayout.ItemsSource="{x:Binding Contents}"
                        Spacing="8" />
                </Grid>
                <HorizontalStackLayout
                    Grid.Row="2"
                    Margin="0,12,0,0"
                    Spacing="12">
                    <HorizontalStackLayout Spacing="8">
                        <Image HeightRequest="24" WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{x:Binding HandleReactionCommand}" />
                            </Image.GestureRecognizers>
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="{x:Binding ReactionFontFamily}"
                                    Glyph="{x:Binding ReactionGlyph}"
                                    Color="{x:Binding ReactionColor}" />
                            </Image.Source>
                        </Image>
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="{x:Binding ReactionsCount}"
                            VerticalOptions="End" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="8">
                        <Image HeightRequest="24" WidthRequest="24">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="FARegular"
                                    Glyph="{x:Static fa:Regular.Comments}"
                                    Color="{AppThemeBinding Dark=#FFFFFF,
                                                            Light=#000000}" />
                            </Image.Source>
                        </Image>
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="{x:Binding CommentsCount}"
                            VerticalOptions="End" />
                    </HorizontalStackLayout>
                </HorizontalStackLayout>
                <Grid
                    Grid.Row="3"
                    Margin="0,12,0,0"
                    IsVisible="{x:Binding HasComments}"
                    Loaded="OnCommentGridLoaded">
                    <Rectangle
                        Fill="#808080"
                        HeightRequest="1"
                        VerticalOptions="Start" />
                    <views:DataTemplatePresenter Margin="0,12,0,0" Template="{StaticResource CommentTemplate}" />
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

    <vm:TimelineTemplateSelector
        x:Key="TimelineTemplateSelector"
        PostTemplate="{StaticResource PostTemplate}"
        ProfileTemplate="{StaticResource ProfileTemplate}" />
</ResourceDictionary>