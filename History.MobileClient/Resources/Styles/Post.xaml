<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="History.MobileClient.Resources.Styles.Post"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
    xmlns:m="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    xmlns:views="clr-namespace:History.MobileClient.ContentViews"
    xmlns:vm="clr-namespace:History.MobileClient.ViewModels">

    <DataTemplate x:Key="PostCommentTemplate" x:DataType="vm:PostViewModel">
        <Grid BackgroundColor="{AppThemeBinding Dark=Black, Light=White}">
            <VerticalStackLayout
                Padding="16"
                IsVisible="{x:Binding HasComments}"
                Spacing="16">
                <Grid>
                    <Label FontSize="16">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="댓글 " />
                                <Span FontAttributes="Bold" Text="{x:Binding CommentsCount}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label
                        FontAttributes="Bold"
                        FontSize="12"
                        HorizontalOptions="End"
                        IsVisible="{x:Binding HasMoreComments}"
                        Text="이전 댓글"
                        TextColor="#808080"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{x:Binding HandleLoadMoreCommentsCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
                <VerticalStackLayout BindableLayout.ItemTemplate="{StaticResource CommentTemplate}" BindableLayout.ItemsSource="{x:Binding Comments}" />
            </VerticalStackLayout>
            <Label
                Margin="16"
                HorizontalOptions="Center"
                IsVisible="{x:Binding HasNoComments}"
                Text="댓글이 없습니다"
                VerticalOptions="Center" />
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="PostContentTemplate" x:DataType="vm:PostViewModel">
        <VerticalStackLayout
            Padding="16"
            BackgroundColor="{AppThemeBinding Dark=Black,
                                              Light=White}"
            Spacing="8">
            <Grid HeightRequest="48" ColumnDefinitions="48,*">
                <views:DataTemplatePresenter
                    Grid.Column="0"
                    HeightRequest="48"
                    Template="{StaticResource MediaTemplateSelector}"
                    ViewModel="{x:Binding ProfileMedia}"
                    WidthRequest="48">
                    <views:DataTemplatePresenter.GestureRecognizers>
                        <TapGestureRecognizer Command="{x:Binding HandleProfileTapCommand}" />
                    </views:DataTemplatePresenter.GestureRecognizers>
                    <views:DataTemplatePresenter.Clip>
                        <EllipseGeometry
                            Center="24,24"
                            RadiusX="24"
                            RadiusY="24" />
                    </views:DataTemplatePresenter.Clip>
                </views:DataTemplatePresenter>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="4">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            LineBreakMode="TailTruncation"
                            Text="{x:Binding Nickname}" />
                        <Image
                            HeightRequest="16"
                            IsVisible="{x:Binding IsAdmin}"
                            Source="{StaticResource CrownIcon}"
                            WidthRequest="16" />
                        <Image
                            HeightRequest="16"
                            IsVisible="{x:Binding IsModerator}"
                            Source="{StaticResource GavelIcon}"
                            WidthRequest="16" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout>
                        <Label FontSize="14" TextColor="#808080">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Binding TimestampText}" />
                                    <Span Text=" · " />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Image HeightRequest="14" WidthRequest="14">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="FASolid"
                                    Glyph="{x:Binding DiscoveryOptionGlyph}"
                                    Color="#808080" />
                            </Image.Source>
                        </Image>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Grid>
            <VerticalStackLayout
                BindableLayout.ItemTemplateSelector="{StaticResource ContentTemplateSelector}"
                BindableLayout.ItemsSource="{x:Binding Contents}"
                Spacing="8" />
            <views:DataTemplatePresenter
                IsVisible="{x:Binding IsShare}"
                Template="{StaticResource SharedPostTemplate}"
                ViewModel="{x:Binding ParentPost}" />
            <VerticalStackLayout IsVisible="{x:Binding HasInteractions}" Spacing="8">
                <HorizontalStackLayout Spacing="8">
                    <Label FontSize="12" IsVisible="{x:Binding HasReactions}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{x:Binding HandleReactionTapCommand}" />
                        </Label.GestureRecognizers>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="느낌 " TextColor="#808080" />
                                <Span
                                    FontAttributes="Bold"
                                    Text="{x:Binding ReactionsCount}"
                                    TextColor="{AppThemeBinding Dark=White,
                                                                Light=Black}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label FontSize="12" IsVisible="{x:Binding HasSharedUsers}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{x:Binding HandleSharedTapCommand}" />
                        </Label.GestureRecognizers>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="공유 " TextColor="#808080" />
                                <Span
                                    FontAttributes="Bold"
                                    Text="{x:Binding SharedUsersCount}"
                                    TextColor="{AppThemeBinding Dark=White,
                                                                Light=Black}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label FontSize="12" IsVisible="{x:Binding HasRepostedUsers}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{x:Binding HandleRepostTapCommand}" />
                        </Label.GestureRecognizers>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="리포스트 " TextColor="#808080" />
                                <Span
                                    FontAttributes="Bold"
                                    Text="{x:Binding RepostedUsersCount}"
                                    TextColor="{AppThemeBinding Dark=White,
                                                                Light=Black}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </HorizontalStackLayout>
                <CollectionView
                    HeightRequest="48"
                    ItemTemplate="{StaticResource InteractionTemplate}"
                    ItemsLayout="HorizontalList"
                    ItemsSource="{x:Binding Interactions}"
                    VerticalOptions="Start" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </DataTemplate>

    <DataTemplate x:Key="PostTemplate" x:DataType="vm:PostViewModel">
        <Grid Padding="6">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{x:Binding HandleTapCommand}" />
            </Grid.GestureRecognizers>
            <Border
                Padding="12"
                Background="{AppThemeBinding Dark=Black,
                                             Light=White}"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Grid HeightRequest="48" ColumnDefinitions="Auto,*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="6">
                            <views:DataTemplatePresenter
                                HeightRequest="36"
                                Template="{StaticResource MediaTemplateSelector}"
                                ViewModel="{x:Binding ProfileMedia,
                                                      Mode=OneWay}"
                                WidthRequest="36">
                                <views:DataTemplatePresenter.GestureRecognizers>
                                    <TapGestureRecognizer Command="{x:Binding HandleProfileTapCommand}" />
                                </views:DataTemplatePresenter.GestureRecognizers>
                                <views:DataTemplatePresenter.Clip>
                                    <EllipseGeometry
                                        Center="18,18"
                                        RadiusX="18"
                                        RadiusY="18" />
                                </views:DataTemplatePresenter.Clip>
                            </views:DataTemplatePresenter>
                            <VerticalStackLayout VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="4">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        LineBreakMode="TailTruncation"
                                        Text="{x:Binding Nickname}" />
                                    <Image
                                        HeightRequest="14"
                                        IsVisible="{x:Binding IsAdmin}"
                                        Source="{StaticResource CrownIcon}"
                                        WidthRequest="14" />
                                    <Image
                                        HeightRequest="14"
                                        IsVisible="{x:Binding IsModerator}"
                                        Source="{StaticResource GavelIcon}"
                                        WidthRequest="14" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout>
                                    <Label FontSize="12" TextColor="#808080">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Binding TimestampText}" />
                                                <Span Text=" · " />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Image HeightRequest="12" WidthRequest="12">
                                        <Image.Source>
                                            <FontImageSource
                                                FontFamily="FASolid"
                                                Glyph="{x:Binding DiscoveryOptionGlyph}"
                                                Color="#808080" />
                                        </Image.Source>
                                    </Image>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <Image
                            Grid.Column="2"
                            HeightRequest="28"
                            VerticalOptions="Center"
                            WidthRequest="28">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{x:Binding HandleMoreTapCommand}" />
                            </Image.GestureRecognizers>
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="MaterialSharp"
                                    Glyph="{x:Static m:MaterialSharp.More_horiz}"
                                    Color="{AppThemeBinding Dark=White,
                                                            Light=Black}" />
                            </Image.Source>
                        </Image>
                    </Grid>
                    <views:DataTemplatePresenter
                        Template="{StaticResource TimelineContentsTemplate}"
                        ViewModel="{x:Binding TimelineContents}" />
                    <views:DataTemplatePresenter
                        IsVisible="{x:Binding IsShare}"
                        Template="{StaticResource SharedPostTemplate}"
                        ViewModel="{x:Binding ParentPost,
                                              Mode=OneWay}" />
                    <HorizontalStackLayout
                        Margin="0,4,0,0"
                        Spacing="10"
                        VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="8">
                            <Image HeightRequest="24" WidthRequest="24">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{x:Binding HandleReactionCommand}" />
                                </Image.GestureRecognizers>
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="{x:Binding ReactionFontFamily}"
                                        Glyph="{x:Binding ReactionGlyph}"
                                        Color="{x:Binding ReactionColor}" />
                                </Image.Source>
                            </Image>
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="{x:Binding ReactionsCount}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Image
                                HeightRequest="24"
                                Source="{StaticResource CommentsIcon}"
                                WidthRequest="24" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="{x:Binding CommentsCount}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout
                            IsVisible="{x:Binding HasSharedUsers}"
                            Spacing="4"
                            VerticalOptions="Center">
                            <Image
                                HeightRequest="24"
                                Source="{StaticResource ShareIcon}"
                                WidthRequest="24" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="{x:Binding SharedUsersCount}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout IsVisible="{x:Binding HasRepostedUsers}" Spacing="4">
                            <Image
                                HeightRequest="24"
                                Source="{StaticResource ShiftLockIcon}"
                                WidthRequest="24" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="{x:Binding RepostedUsersCount}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                    <Grid Margin="0,4,0,0" IsVisible="{x:Binding HasComments}">
                        <Rectangle
                            Fill="#808080"
                            HeightRequest="{OnPlatform iOS=1.5,
                                                       Android=1}"
                            HorizontalOptions="Fill"
                            VerticalOptions="Start" />
                        <views:DataTemplatePresenter
                            Margin="0,12,0,0"
                            Template="{StaticResource CommentTemplate}"
                            ViewModel="{x:Binding LatestComment,
                                                  Mode=OneWay}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="PostPreviewTemplate" x:DataType="vm:PostViewModel">
        <views:SquareView BackgroundColor="{AppThemeBinding Dark=#000000, Light=#FFFFFF}">
            <views:SquareView.GestureRecognizers>
                <TapGestureRecognizer Command="{x:Binding HandleTapCommand}" />
            </views:SquareView.GestureRecognizers>

            <Grid Padding="6" IsClippedToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label
                    Grid.Row="0"
                    FontSize="12.5"
                    LineBreakMode="TailTruncation"
                    MaxLines="3"
                    Text="{x:Binding PreviewText}" />
                <Label
                    Grid.Row="1"
                    FontAttributes="Bold"
                    FontSize="10"
                    LineBreakMode="TailTruncation"
                    MaxLines="1"
                    Text="{x:Binding PreviewTimestamp}"
                    TextColor="#808080" />
                <views:DataTemplatePresenter
                    Grid.RowSpan="2"
                    Margin="-6"
                    BackgroundColor="Black"
                    IsVisible="{x:Binding PreviewThumbnailVisible}"
                    Template="{StaticResource ImageTemplate}"
                    ViewModel="{x:Binding PreviewThumbnail}" />
                <Border
                    Grid.RowSpan="2"
                    Margin="0,0,4,4"
                    Padding="0"
                    BackgroundColor="{StaticResource Primary}"
                    HeightRequest="24"
                    HorizontalOptions="End"
                    IsVisible="{x:Binding HasUnreadNotification}"
                    StrokeThickness="0"
                    VerticalOptions="End"
                    WidthRequest="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Label
                        FontAttributes="Bold"
                        FontSize="12"
                        HorizontalOptions="Center"
                        Text="N"
                        TextColor="White"
                        VerticalOptions="Center" />
                </Border>
            </Grid>
        </views:SquareView>
    </DataTemplate>

    <vm:TimelineTemplateSelector
        x:Key="TimelineTemplateSelector"
        PostTemplate="{StaticResource PostTemplate}"
        ProfileTemplate="{StaticResource ProfileTemplate}"
        RepostTemplate="{StaticResource RepostTemplate}" />
</ResourceDictionary>