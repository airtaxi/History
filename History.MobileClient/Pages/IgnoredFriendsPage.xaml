<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="History.MobileClient.Pages.IgnoredFriendsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:History.MobileClient.Behaviors"
    Shell.NavBarIsVisible="False">
    <ContentPage.Behaviors>
        <behaviors:StatusBarBehavior StatusBarColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" StatusBarTheme="{AppThemeBinding Light=Light, Dark=Dark}" />
    </ContentPage.Behaviors>
    <Grid x:Name="RootGrid">
        <RefreshView Refreshing="OnRefreshing">
            <Grid>
                <CollectionView
                    x:Name="MainCollectionView"
                    Grid.Row="2"
                    ItemTemplate="{StaticResource FriendshipTemplate}" />
                <Label
                    x:Name="EmptyLabel"
                    FontAttributes="Bold"
                    FontSize="16"
                    HorizontalOptions="Center"
                    Text="무시한 친구가 없습니다"
                    VerticalOptions="Center" />
            </Grid>
        </RefreshView>

        <ActivityIndicator
            x:Name="MainActivityIndicator"
            HeightRequest="100"
            HorizontalOptions="Center"
            IsRunning="False"
            VerticalOptions="Center"
            WidthRequest="100"
            Color="{StaticResource Primary}" />
    </Grid>
</ContentPage>