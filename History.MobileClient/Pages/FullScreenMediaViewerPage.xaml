<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="History.MobileClient.Pages.FullScreenMediaViewerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:views="clr-namespace:History.MobileClient.ContentViews"
    xmlns:vm="clr-namespace:History.MobileClient.ViewModels"
    Background="Black"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">
    <ContentPage.Resources>
        <DataTemplate x:Key="FullScreenVideoTemplate" x:DataType="vm:FullScreenMediaContentViewModel">
            <views:DataTemplatePresenter Template="{StaticResource VideoTemplate}" ViewModel="{x:Binding CurrentMedia}" />
        </DataTemplate>

        <DataTemplate x:Key="FullScreenMediaContentTemplate" x:DataType="vm:FullScreenMediaContentViewModel">
            <Grid>
                <CarouselView
                    CurrentItem="{x:Binding CurrentMedia,
                                            Mode=TwoWay}"
                    HorizontalScrollBarVisibility="Never"
                    IsSwipeEnabled="{x:Binding CurrentMedia.FullScreenSwipeable}"
                    ItemTemplate="{StaticResource MediaTemplateSelector}"
                    ItemsSource="{x:Binding FullScreenMedias}"
                    Position="{x:Binding CarouselPosition}" />
                <Border
                    Margin="12"
                    Padding="6,4,6,4"
                    Background="#80808080"
                    HorizontalOptions="End"
                    IsVisible="{x:Binding CurrentMedia.FullScreenSwipeable}"
                    StrokeThickness="0"
                    VerticalOptions="End">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Label
                        FontAttributes="Bold"
                        Text="{x:Binding CarouselPositionText}"
                        TextColor="White" />
                </Border>
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid>
        <views:DataTemplatePresenter x:Name="MainDataTemplatePresenter">
            <views:DataTemplatePresenter.Template>
                <vm:FullScreenMediaContentViewModelSelector FullScreenMediaContentTemplate="{StaticResource FullScreenMediaContentTemplate}" FullScreenVideoTemplate="{StaticResource FullScreenVideoTemplate}" />
            </views:DataTemplatePresenter.Template>
        </views:DataTemplatePresenter>

        <Grid VerticalOptions="Start">
            <BoxView
                HeightRequest="72"
                HorizontalOptions="Fill"
                InputTransparent="True"
                VerticalOptions="Start">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.0" Color="Black" />
                        <GradientStop Offset="1.0" Color="Transparent" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>
            <HorizontalStackLayout
                Margin="12"
                HorizontalOptions="End"
                Spacing="12"
                VerticalOptions="Start">
                <Image HeightRequest="48" WidthRequest="48">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDownloadImageTapped" />
                    </Image.GestureRecognizers>
                    <Image.Source>
                        <FontImageSource
                            FontFamily="MaterialSharp"
                            Glyph="{x:Static m:MaterialSharp.Download}"
                            Color="White" />
                    </Image.Source>
                </Image>
                <Image HeightRequest="48" WidthRequest="48">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackImageTapped" />
                    </Image.GestureRecognizers>
                    <Image.Source>
                        <FontImageSource
                            FontFamily="MaterialSharp"
                            Glyph="{x:Static m:MaterialSharp.Close}"
                            Color="White" />
                    </Image.Source>
                </Image>
            </HorizontalStackLayout>
        </Grid>

        <ActivityIndicator
            x:Name="MainActivityIndicator"
            HeightRequest="100"
            HorizontalOptions="Center"
            IsRunning="False"
            VerticalOptions="Center"
            WidthRequest="100"
            Color="{StaticResource Primary}" />
    </Grid>
</ContentPage>