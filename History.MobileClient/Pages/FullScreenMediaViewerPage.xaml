<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="History.MobileClient.Pages.FullScreenMediaViewerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:views="clr-namespace:History.MobileClient.ContentViews"
    xmlns:vm="clr-namespace:History.MobileClient.ViewModels"
    Background="Black"
    NavigationPage.HasNavigationBar="False">

    <Grid>
        <views:DataTemplatePresenter x:Name="MainDataTemplatePresenter" Template="{StaticResource MediaTemplateSelector}" />

        <Grid>
            <BoxView
                HeightRequest="72"
                HorizontalOptions="Fill"
                InputTransparent="True"
                VerticalOptions="Start">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.0" Color="Black" />
                        <GradientStop Offset="1.0" Color="Transparent" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>
            <HorizontalStackLayout
                Margin="12"
                HorizontalOptions="End"
                Spacing="12"
                VerticalOptions="Start">
                <Image HeightRequest="48" WidthRequest="48">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDownloadImageTapped" />
                    </Image.GestureRecognizers>
                    <Image.Source>
                        <FontImageSource
                            FontFamily="MaterialSharp"
                            Glyph="{x:Static m:MaterialSharp.Download}"
                            Color="#808080" />
                    </Image.Source>
                </Image>
                <Image HeightRequest="48" WidthRequest="48">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackImageTapped" />
                    </Image.GestureRecognizers>
                    <Image.Source>
                        <FontImageSource
                            FontFamily="MaterialSharp"
                            Glyph="{x:Static m:MaterialSharp.Close}"
                            Color="#808080" />
                    </Image.Source>
                </Image>
            </HorizontalStackLayout>
        </Grid>
    </Grid>
</ContentPage>