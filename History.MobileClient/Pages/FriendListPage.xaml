<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="History.MobileClient.Pages.FriendListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
    xmlns:m="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Loaded="OnLoaded"
    Shell.NavBarIsVisible="False">
    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior ApplyOn="OnPageNavigatedTo" StatusBarColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
        <toolkit:StatusBarBehavior ApplyOn="OnBehaviorAttachedTo" StatusBarColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
    </ContentPage.Behaviors>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleGrid"
            Grid.Row="0"
            Padding="12,0,0,0"
            BackgroundColor="{StaticResource Primary}"
            HeightRequest="48"
            IsVisible="False">
            <HorizontalStackLayout>
                <Image HeightRequest="24" WidthRequest="24">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackImageTapped" />
                    </Image.GestureRecognizers>
                    <Image.Source>
                        <FontImageSource FontFamily="MaterialSharp" Glyph="{x:Static m:MaterialSharp.Arrow_back_ios}" />
                    </Image.Source>
                </Image>
                <Label
                    x:Name="TitleLabel"
                    FontAttributes="Bold"
                    FontSize="20"
                    Text="친구 목록"
                    TextColor="White"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Grid>

        <RefreshView
            Grid.Row="1"
            Refreshing="OnRefreshing"
            SafeAreaEdges="None">
            <Grid RowSpacing="8" SafeAreaEdges="None">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <SearchBar
                    x:Name="MainSearchBar"
                    Grid.Row="0"
                    Placeholder="친구의 닉네임 또는 핸들 검색"
                    TextChanged="OnMainSearchBarTextChanged" />

                <Label
                    x:Name="FriendListLabel"
                    Grid.Row="1"
                    Margin="12,0,0,0"
                    FontAttributes="Bold"
                    HorizontalOptions="Start"
                    Text="친구 목록"
                    VerticalOptions="Center" />
                <HorizontalStackLayout
                    x:Name="SortHorizontalStackLayout"
                    Grid.Row="1"
                    Margin="0,0,12,0"
                    HorizontalOptions="End"
                    Spacing="4"
                    VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSortTapped" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Image HeightRequest="14" WidthRequest="14">
                        <Image.Source>
                            <FontImageSource
                                x:Name="SortFontImageSource"
                                FontFamily="FASolid"
                                Glyph="{x:Static fa:Solid.ArrowUpAZ}"
                                Color="{AppThemeBinding Dark=White,
                                                        Light=Black}" />
                        </Image.Source>
                    </Image>
                    <Label
                        x:Name="SortLabel"
                        FontAttributes="Bold"
                        Text="이름순"
                        TextColor="{AppThemeBinding Dark=White,
                                                    Light=Black}" />
                </HorizontalStackLayout>

                <CollectionView
                    x:Name="MainCollectionView"
                    Grid.Row="2"
                    ItemTemplate="{StaticResource FriendshipTemplate}" />

                <Label
                    x:Name="EmptyLabel"
                    Grid.Row="2"
                    FontAttributes="Bold"
                    FontSize="16"
                    HorizontalOptions="Center"
                    Text="비어있음"
                    VerticalOptions="Center" />
            </Grid>
        </RefreshView>

        <ActivityIndicator
            x:Name="MainActivityIndicator"
            Grid.RowSpan="2"
            HeightRequest="100"
            HorizontalOptions="Center"
            IsRunning="False"
            VerticalOptions="Center"
            WidthRequest="100"
            Color="{StaticResource Primary}" />
    </Grid>
</ContentPage>