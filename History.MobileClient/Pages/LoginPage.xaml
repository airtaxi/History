<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="History.MobileClient.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Grid BackgroundColor="#fff112" RowDefinitions="*,Auto,Auto">
        <Image
            HeightRequest="256"
            HorizontalOptions="Center"
            Source="icon_nobg.png"
            VerticalOptions="Center"
            WidthRequest="256" />
        <VerticalStackLayout
            x:Name="LoginVerticalStackLayout"
            Grid.Row="1"
            Margin="20"
            Padding="20"
            HorizontalOptions="Center"
            IsVisible="False"
            Spacing="12">
            <Label
                FontSize="18"
                HorizontalOptions="Center"
                Text="SNS 계정으로 계속하기"
                TextColor="Black" />
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                <ImageButton
                    Clicked="OnGoogleLoginButtonClicked"
                    HeightRequest="52"
                    Source="google_light.png"
                    WidthRequest="52" />
                <ImageButton
                    Clicked="OnAppleLoginButtonClicked"
                    HeightRequest="52"
                    Source="apple_light.png"
                    WidthRequest="52" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <HorizontalStackLayout
            x:Name="LegalLinksHorizontalStackLayout"
            Grid.Row="2"
            Margin="0,0,0,16"
            HorizontalOptions="Center"
            IsVisible="False"
            Spacing="16">
            <Label
                FontSize="12"
                Text="서비스 이용 약관"
                TextColor="Black"
                TextDecorations="Underline">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTermsLabelTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Label
                FontSize="12"
                Text="개인정보처리방침"
                TextColor="Black"
                TextDecorations="Underline">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPrivacyPolicyLabelTapped" />
                </Label.GestureRecognizers>
            </Label>
        </HorizontalStackLayout>

        <ActivityIndicator
            x:Name="MainActivityIndicator"
            HeightRequest="100"
            HorizontalOptions="Center"
            IsRunning="False"
            VerticalOptions="Center"
            WidthRequest="100"
            Color="{StaticResource Primary}" />
    </Grid>
</ContentPage>