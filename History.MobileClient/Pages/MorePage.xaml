<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="History.MobileClient.Pages.MorePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    xmlns:behaviors="clr-namespace:History.MobileClient.Behaviors"
    Shell.NavBarIsVisible="False">
    <ContentPage.Behaviors>
        <behaviors:StatusBarBehavior StatusBarColor="{StaticResource Primary}" StatusBarTheme="Dark" />
    </ContentPage.Behaviors>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Padding="12,0,12,0"
            BackgroundColor="{StaticResource Primary}"
            HeightRequest="48">
            <Label
                FontAttributes="Bold"
                FontSize="20"
                Text="더보기"
                TextColor="White"
                VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="0,12" Spacing="0">
                <!--  관심글  -->
                <Grid Padding="16,12" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A1A}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBookmarkedPostsGridTapped" />
                    </Grid.GestureRecognizers>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Grid.Column="0"
                        HeightRequest="32"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="32">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="MaterialSharp"
                                Glyph="{x:Static m:MaterialSharp.Bookmark}"
                                Color="{StaticResource Primary}" />
                        </Image.Source>
                    </Image>
                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="2"
                        VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="관심글" />
                        <Label
                            FontSize="12"
                            Text="관심글로 저장한 게시글 모아보기"
                            TextColor="#808080" />
                    </VerticalStackLayout>
                    <Image
                        Grid.Column="2"
                        HeightRequest="24"
                        VerticalOptions="Center"
                        WidthRequest="24">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="MaterialSharp"
                                Glyph="{x:Static m:MaterialSharp.Chevron_right}"
                                Color="#808080" />
                        </Image.Source>
                    </Image>
                </Grid>

                <Rectangle
                    Fill="#808080"
                    HeightRequest="0.5"
                    HorizontalOptions="Fill"
                    Opacity="0.5" />

                <!--  발견  -->
                <Grid Padding="16,12" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A1A}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPublicPostGridTapped" />
                    </Grid.GestureRecognizers>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Grid.Column="0"
                        HeightRequest="32"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="32">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="MaterialSharp"
                                Glyph="{x:Static m:MaterialSharp.Explore}"
                                Color="{StaticResource Primary}" />
                        </Image.Source>
                    </Image>
                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="2"
                        VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="발견" />
                        <Label
                            FontSize="12"
                            Text="공개된 게시글 둘러보기"
                            TextColor="#808080" />
                    </VerticalStackLayout>
                    <Image
                        Grid.Column="2"
                        HeightRequest="24"
                        VerticalOptions="Center"
                        WidthRequest="24">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="MaterialSharp"
                                Glyph="{x:Static m:MaterialSharp.Chevron_right}"
                                Color="#808080" />
                        </Image.Source>
                    </Image>
                </Grid>

                <Rectangle
                    Fill="#808080"
                    HeightRequest="0.5"
                    HorizontalOptions="Fill"
                    Opacity="0.5" />

                <!--  스티커  -->
                <Grid Padding="16,12" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A1A}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnStickersGridTapped" />
                    </Grid.GestureRecognizers>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Grid.Column="0"
                        HeightRequest="32"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="32">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="MaterialSharp"
                                Glyph="{x:Static m:MaterialSharp.Emoticon}"
                                Color="{StaticResource Primary}" />
                        </Image.Source>
                    </Image>
                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="2"
                        VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="스티커" />
                        <Label
                            FontSize="12"
                            Text="스티커 둘러보기 및 만들기"
                            TextColor="#808080" />
                    </VerticalStackLayout>
                    <Image
                        Grid.Column="2"
                        HeightRequest="24"
                        VerticalOptions="Center"
                        WidthRequest="24">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="MaterialSharp"
                                Glyph="{x:Static m:MaterialSharp.Chevron_right}"
                                Color="#808080" />
                        </Image.Source>
                    </Image>
                </Grid>

                <!--  초대 코드  -->
                <Rectangle
                    Fill="#808080"
                    HeightRequest="0.5"
                    HorizontalOptions="Fill"
                    Opacity="0.5" />

                <Grid Padding="16,12" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A1A}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInviteCodesGridTapped" />
                    </Grid.GestureRecognizers>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Grid.Column="0"
                        HeightRequest="32"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="32">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="MaterialSharp"
                                Glyph="{x:Static m:MaterialSharp.Featured_seasonal_and_gifts}"
                                Color="{StaticResource Primary}" />
                        </Image.Source>
                    </Image>
                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="2"
                        VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="초대 코드" />
                        <Label
                            FontSize="12"
                            Text="내 초대 코드 조회 및 요청"
                            TextColor="#808080" />
                    </VerticalStackLayout>
                    <Image
                        Grid.Column="2"
                        HeightRequest="24"
                        VerticalOptions="Center"
                        WidthRequest="24">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="MaterialSharp"
                                Glyph="{x:Static m:MaterialSharp.Chevron_right}"
                                Color="#808080" />
                        </Image.Source>
                    </Image>
                </Grid>

                <!--  초대 코드 요청 관리 (관리자 전용)  -->
                <Rectangle
                    x:Name="InviteCodeRequestDivider"
                    Fill="#808080"
                    HeightRequest="0.5"
                    HorizontalOptions="Fill"
                    IsVisible="False"
                    Opacity="0.5" />

                <Grid
                    x:Name="InviteCodeRequestsGrid"
                    Padding="16,12"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF,
                                                      Dark=#1A1A1A}"
                    IsVisible="False">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInviteCodeRequestsGridTapped" />
                    </Grid.GestureRecognizers>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Grid.Column="0"
                        HeightRequest="32"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="32">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="MaterialSharp"
                                Glyph="{x:Static m:MaterialSharp.Pending_actions}"
                                Color="{StaticResource Primary}" />
                        </Image.Source>
                    </Image>
                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="2"
                        VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="초대 코드 요청 관리" />
                        <Label
                            FontSize="12"
                            Text="사용자 초대 코드 요청 수락/거부"
                            TextColor="#808080" />
                    </VerticalStackLayout>
                    <Image
                        Grid.Column="2"
                        HeightRequest="24"
                        VerticalOptions="Center"
                        WidthRequest="24">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="MaterialSharp"
                                Glyph="{x:Static m:MaterialSharp.Chevron_right}"
                                Color="#808080" />
                        </Image.Source>
                    </Image>
                </Grid>

                <!--  게시글 일괄 관리  -->
                <Rectangle
                    x:Name="BulkPostManagementDivider"
                    Fill="#808080"
                    HeightRequest="0.5"
                    HorizontalOptions="Fill"
                    IsVisible="False"
                    Opacity="0.5" />

                <Grid
                    x:Name="BulkPostManagementGrid"
                    Padding="16,12"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF,
                                                      Dark=#1A1A1A}"
                    IsVisible="False">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBulkPostManagementGridTapped" />
                    </Grid.GestureRecognizers>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Grid.Column="0"
                        HeightRequest="32"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="32">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="MaterialSharp"
                                Glyph="{x:Static m:MaterialSharp.Build}"
                                Color="{StaticResource Primary}" />
                        </Image.Source>
                    </Image>
                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="2"
                        VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="게시글 일괄 관리" />
                        <Label
                            FontSize="12"
                            Text="공개 범위 일괄 전환 / 전체 삭제"
                            TextColor="#808080" />
                    </VerticalStackLayout>
                    <Image
                        Grid.Column="2"
                        HeightRequest="24"
                        VerticalOptions="Center"
                        WidthRequest="24">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="MaterialSharp"
                                Glyph="{x:Static m:MaterialSharp.Chevron_right}"
                                Color="#808080" />
                        </Image.Source>
                    </Image>
                </Grid>

                <!--  카카오스토리 부가기능  -->
                <Rectangle
                    x:Name="KakaoStoryExtrasDivider"
                    Fill="#808080"
                    HeightRequest="0.5"
                    HorizontalOptions="Fill"
                    IsVisible="False"
                    Opacity="0.5" />

                <Grid
                    x:Name="KakaoStoryExtrasGrid"
                    Padding="16,12"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF,
                                                      Dark=#1A1A1A}"
                    IsVisible="False">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnKakaoStoryExtrasGridTapped" />
                    </Grid.GestureRecognizers>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Grid.Column="0"
                        HeightRequest="32"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="32">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="MaterialSharp"
                                Glyph="{x:Static m:MaterialSharp.Tune}"
                                Color="{StaticResource Primary}" />
                        </Image.Source>
                    </Image>
                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="2"
                        VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="카카오스토리 부가기능" />
                        <Label
                            FontSize="12"
                            Text="친구/스토리 일괄 관리 (카카오스토리)"
                            TextColor="#808080" />
                    </VerticalStackLayout>
                    <Image
                        Grid.Column="2"
                        HeightRequest="24"
                        VerticalOptions="Center"
                        WidthRequest="24">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="MaterialSharp"
                                Glyph="{x:Static m:MaterialSharp.Chevron_right}"
                                Color="#808080" />
                        </Image.Source>
                    </Image>
                </Grid>

                <!--  제재 내역 (관리자 전용)  -->
                <Rectangle
                    x:Name="ModerationDivider"
                    Fill="#808080"
                    HeightRequest="0.5"
                    HorizontalOptions="Fill"
                    IsVisible="False"
                    Opacity="0.5" />

                <Grid
                    x:Name="ModerationRecordsGrid"
                    Padding="16,12"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF,
                                                      Dark=#1A1A1A}"
                    IsVisible="False">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnModerationRecordsGridTapped" />
                    </Grid.GestureRecognizers>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Grid.Column="0"
                        HeightRequest="32"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="32">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="MaterialSharp"
                                Glyph="{x:Static m:MaterialSharp.Shield}"
                                Color="{StaticResource Primary}" />
                        </Image.Source>
                    </Image>
                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="2"
                        VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="제재 내역" />
                        <Label
                            FontSize="12"
                            Text="관리자 제재 기록 확인"
                            TextColor="#808080" />
                    </VerticalStackLayout>
                    <Image
                        Grid.Column="2"
                        HeightRequest="24"
                        VerticalOptions="Center"
                        WidthRequest="24">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="MaterialSharp"
                                Glyph="{x:Static m:MaterialSharp.Chevron_right}"
                                Color="#808080" />
                        </Image.Source>
                    </Image>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
