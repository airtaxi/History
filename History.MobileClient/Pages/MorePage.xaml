<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="History.MobileClient.Pages.MorePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Shell.NavBarIsVisible="False">
    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior ApplyOn="OnPageNavigatedTo" StatusBarColor="{StaticResource Primary}" />
        <toolkit:StatusBarBehavior ApplyOn="OnBehaviorAttachedTo" StatusBarColor="{StaticResource Primary}" />
    </ContentPage.Behaviors>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Padding="12,0,12,0"
            BackgroundColor="{StaticResource Primary}"
            HeightRequest="48">
            <Label
                FontAttributes="Bold"
                FontSize="20"
                Text="더보기"
                TextColor="White"
                VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="0,12" Spacing="0">
                <!--  발견  -->
                <Grid Padding="16,12" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A1A}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPublicPostGridTapped" />
                    </Grid.GestureRecognizers>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Grid.Column="0"
                        HeightRequest="32"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="32">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="MaterialSharp"
                                Glyph="{x:Static m:MaterialSharp.Explore}"
                                Color="{StaticResource Primary}" />
                        </Image.Source>
                    </Image>
                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="2"
                        VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="발견" />
                        <Label
                            FontSize="12"
                            Text="공개된 게시글 둘러보기"
                            TextColor="#808080" />
                    </VerticalStackLayout>
                    <Image
                        Grid.Column="2"
                        HeightRequest="24"
                        VerticalOptions="Center"
                        WidthRequest="24">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="MaterialSharp"
                                Glyph="{x:Static m:MaterialSharp.Chevron_right}"
                                Color="#808080" />
                        </Image.Source>
                    </Image>
                </Grid>

                <Rectangle
                    Fill="#808080"
                    HeightRequest="0.5"
                    HorizontalOptions="Fill"
                    Opacity="0.5" />

                <!--  스티커  -->
                <Grid Padding="16,12" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A1A}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnStickersGridTapped" />
                    </Grid.GestureRecognizers>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Grid.Column="0"
                        HeightRequest="32"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="32">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="MaterialSharp"
                                Glyph="{x:Static m:MaterialSharp.Emoticon}"
                                Color="{StaticResource Primary}" />
                        </Image.Source>
                    </Image>
                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="2"
                        VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="스티커" />
                        <Label
                            FontSize="12"
                            Text="스티커 둘러보기 및 만들기"
                            TextColor="#808080" />
                    </VerticalStackLayout>
                    <Image
                        Grid.Column="2"
                        HeightRequest="24"
                        VerticalOptions="Center"
                        WidthRequest="24">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="MaterialSharp"
                                Glyph="{x:Static m:MaterialSharp.Chevron_right}"
                                Color="#808080" />
                        </Image.Source>
                    </Image>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
