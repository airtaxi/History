<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="History.MobileClient.Pages.NotificationsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:views="clr-namespace:History.MobileClient.ContentViews"
    xmlns:vm="clr-namespace:History.MobileClient.ViewModels"
    Shell.NavBarIsVisible="False">
    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior ApplyOn="OnPageNavigatedTo" StatusBarColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
        <toolkit:StatusBarBehavior ApplyOn="OnBehaviorAttachedTo" StatusBarColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
    </ContentPage.Behaviors>
    <Grid RowSpacing="6">
        <RefreshView Refreshing="OnRefreshing">
            <CollectionView
                x:Name="MainCollectionView"
                RemainingItemsThreshold="0"
                RemainingItemsThresholdReached="OnMainCollectionViewRemainingItemsThresholdReached"
                SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:NotificationViewModel">
                        <Grid Padding="12,8,12,8" ColumnSpacing="8">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{x:Binding HandleTapCommand}" />
                            </Grid.GestureRecognizers>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <views:DataTemplatePresenter
                                    HeightRequest="40"
                                    Template="{StaticResource MediaTemplateSelector}"
                                    ViewModel="{x:Binding ProfileMedia}"
                                    WidthRequest="40">
                                    <views:DataTemplatePresenter.GestureRecognizers>
                                        <TapGestureRecognizer Command="{x:Binding HandleProfileTapCommand}" />
                                    </views:DataTemplatePresenter.GestureRecognizers>
                                    <views:DataTemplatePresenter.Clip>
                                        <EllipseGeometry
                                            Center="20,20"
                                            RadiusX="20"
                                            RadiusY="20" />
                                    </views:DataTemplatePresenter.Clip>
                                </views:DataTemplatePresenter>
                            </Grid>
                            <VerticalStackLayout Grid.Column="1">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1"
                                    Text="{x:Binding Title}" />

                                <Label
                                    FontSize="14"
                                    IsVisible="{x:Binding IsBodyVisible}"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1"
                                    Text="{x:Binding Body}"
                                    TextColor="{AppThemeBinding Dark=#CFCFCF,
                                                                Light=#303030}" />
                                <Label
                                    FontSize="12"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1"
                                    Text="{x:Binding TimestampText}"
                                    TextColor="#808080" />
                            </VerticalStackLayout>

                            <Border
                                Grid.Column="2"
                                HeightRequest="40"
                                IsVisible="{x:Binding IsImageVisible}"
                                WidthRequest="40">
                                <views:DataTemplatePresenter
                                    HeightRequest="40"
                                    Template="{StaticResource MediaTemplateSelector}"
                                    ViewModel="{x:Binding ImageMedia}"
                                    WidthRequest="40" />
                            </Border>

                            <Image
                                Grid.Column="2"
                                HeightRequest="30"
                                IsVisible="{x:Binding IsAcceptButtonVisible}"
                                VerticalOptions="Center"
                                WidthRequest="30">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{x:Binding AcceptFriendRequestCommand}" />
                                </Image.GestureRecognizers>
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="MaterialSharp"
                                        Glyph="{x:Static m:MaterialSharp.Check}"
                                        Color="{StaticResource Primary}" />
                                </Image.Source>
                            </Image>

                            <Rectangle
                                Grid.ColumnSpan="3"
                                Margin="-8"
                                Fill="#808080"
                                HeightRequest="{OnPlatform iOS=1.5,
                                                           Android=1}"
                                HorizontalOptions="Fill"
                                VerticalOptions="End" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <ActivityIndicator
            x:Name="MainActivityIndicator"
            Grid.RowSpan="2"
            HeightRequest="100"
            HorizontalOptions="Center"
            IsRunning="False"
            VerticalOptions="Center"
            WidthRequest="100"
            Color="{StaticResource Primary}" />
    </Grid>
</ContentPage>