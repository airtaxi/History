<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="History.MobileClient.Pages.AddFriendsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Shell.NavBarIsVisible="False">
    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior ApplyOn="OnPageNavigatedTo" StatusBarColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
        <toolkit:StatusBarBehavior ApplyOn="OnBehaviorAttachedTo" StatusBarColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
    </ContentPage.Behaviors>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <RefreshView
            Grid.Row="0"
            Refreshing="OnRefreshing"
            SafeAreaEdges="None">
            <Grid RowSpacing="8" SafeAreaEdges="None">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="PillGrid"
                    Grid.Row="0"
                    Padding="12,10"
                    ColumnSpacing="8"
                    IsVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="HistoryPillBorder"
                        Grid.Column="0"
                        HeightRequest="34"
                        StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHistoryPillTapped" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="17" />
                        </Border.StrokeShape>
                        <Label
                            x:Name="HistoryPillLabel"
                            Padding="16,0"
                            FontAttributes="Bold"
                            FontSize="13"
                            HorizontalOptions="Center"
                            Text="히스토리"
                            VerticalOptions="Center" />
                    </Border>
                    <Border
                        x:Name="KakaoStoryPillBorder"
                        Grid.Column="1"
                        HeightRequest="34"
                        StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnKakaoStoryPillTapped" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="17" />
                        </Border.StrokeShape>
                        <Label
                            x:Name="KakaoStoryPillLabel"
                            Padding="16,0"
                            FontAttributes="Bold"
                            FontSize="13"
                            HorizontalOptions="Center"
                            Text="카카오스토리"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>

                <SearchBar
                    x:Name="MainSearchBar"
                    Grid.Row="1"
                    Placeholder="친구의 닉네임 또는 핸들 검색"
                    SearchButtonPressed="OnSearchButtonPressed" />

                <Label
                    Grid.Row="2"
                    Margin="6,0,0,0"
                    Text="검색 결과" />

                <CollectionView
                    x:Name="MainCollectionView"
                    Grid.Row="3"
                    ItemTemplate="{StaticResource FriendshipTemplate}" />

                <Label
                    x:Name="EmptyLabel"
                    Grid.Row="3"
                    FontAttributes="Bold"
                    FontSize="16"
                    HorizontalOptions="Center"
                    Text="검색 결과가 없습니다"
                    VerticalOptions="Center" />
            </Grid>
        </RefreshView>

        <ActivityIndicator
            x:Name="MainActivityIndicator"
            HeightRequest="100"
            HorizontalOptions="Center"
            IsRunning="False"
            VerticalOptions="Center"
            WidthRequest="100"
            Color="{StaticResource Primary}" />
    </Grid>
</ContentPage>