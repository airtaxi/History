<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="History.MobileClient.Pages.StickerDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:m="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:History.MobileClient.ViewModels"
    Loaded="OnLoaded"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">
    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior ApplyOn="OnPageNavigatedTo" StatusBarColor="{StaticResource Primary}" />
        <toolkit:StatusBarBehavior ApplyOn="OnBehaviorAttachedTo" StatusBarColor="{StaticResource Primary}" />
    </ContentPage.Behaviors>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid
            Grid.Row="0"
            Padding="12,0,0,0"
            BackgroundColor="{StaticResource Primary}"
            HeightRequest="48">
            <HorizontalStackLayout Spacing="8">
                <Image HeightRequest="24" WidthRequest="24">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackImageTapped" />
                    </Image.GestureRecognizers>
                    <Image.Source>
                        <FontImageSource FontFamily="MaterialSharp" Glyph="{x:Static m:MaterialSharp.Arrow_back_ios}" />
                    </Image.Source>
                </Image>
                <Label
                    x:Name="TitleLabel"
                    FontAttributes="Bold"
                    FontSize="20"
                    LineBreakMode="TailTruncation"
                    MaxLines="1"
                    Text="스티커"
                    TextColor="White"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout HorizontalOptions="End" Spacing="8">
                <Image
                    x:Name="DeleteImage"
                    Margin="0,0,12,0"
                    HeightRequest="24"
                    IsVisible="False"
                    WidthRequest="24">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDeleteImageTapped" />
                    </Image.GestureRecognizers>
                    <Image.Source>
                        <FontImageSource
                            FontFamily="MaterialSharp"
                            Glyph="{x:Static m:MaterialSharp.Delete}"
                            Color="White" />
                    </Image.Source>
                </Image>
            </HorizontalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="16">
                <!--  Sticker info  -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        HeightRequest="80"
                        StrokeThickness="0"
                        WidthRequest="80">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <ffimageloading:CachedImage
                            x:Name="IconImage"
                            Aspect="AspectFill"
                            DownsampleToViewSize="True" />
                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="4"
                        VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="8">
                            <Label
                                x:Name="NameLabel"
                                FontAttributes="Bold"
                                FontSize="20" />
                            <Border
                                x:Name="PrivateBorder"
                                Padding="8,4"
                                BackgroundColor="{StaticResource Primary}"
                                IsVisible="False"
                                StrokeThickness="0"
                                VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="4" />
                                </Border.StrokeShape>
                                <Label
                                    FontSize="12"
                                    Text="비공개"
                                    TextColor="White" />
                            </Border>
                        </HorizontalStackLayout>
                        <Label
                            x:Name="CategoryLabel"
                            FontSize="14"
                            TextColor="#808080" />
                        <HorizontalStackLayout Spacing="4">
                            <Label
                                FontSize="12"
                                Text="제작자:"
                                TextColor="#808080" />
                            <Label
                                x:Name="AuthorLabel"
                                FontSize="12"
                                TextColor="#808080">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAuthorLabelTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>

                <!--  Subscribe button  -->
                <Button
                    x:Name="SubscribeButton"
                    Clicked="OnSubscribeButtonClicked"
                    FontAttributes="Bold"
                    IsVisible="False"
                    Text="구독하기"
                    TextColor="White" />

                <!--  Description  -->
                <VerticalStackLayout
                    x:Name="DescriptionStackLayout"
                    IsVisible="False"
                    Spacing="4">
                    <Label
                        FontAttributes="Bold"
                        FontSize="14"
                        Text="설명" />
                    <Label
                        x:Name="DescriptionLabel"
                        FontSize="14"
                        TextColor="#808080" />
                </VerticalStackLayout>

                <!--  Assets  -->
                <VerticalStackLayout Spacing="8">
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="스티커 에셋" />
                    <CollectionView
                        x:Name="AssetsCollectionView"
                        HeightRequest="400"
                        SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout
                                HorizontalItemSpacing="8"
                                Orientation="Vertical"
                                Span="4"
                                VerticalItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:StickerAssetViewModel">
                                <Border
                                    Padding="4"
                                    BackgroundColor="{AppThemeBinding Light=#F5F5F5,
                                                                      Dark=#2A2A2A}"
                                    HeightRequest="80"
                                    StrokeThickness="0"
                                    WidthRequest="80">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <ffimageloading:CachedImage
                                        Aspect="AspectFit"
                                        DownsampleToViewSize="True"
                                        Source="{x:Binding MediaUri}" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator
            x:Name="MainActivityIndicator"
            Grid.RowSpan="2"
            HeightRequest="100"
            HorizontalOptions="Center"
            IsRunning="False"
            VerticalOptions="Center"
            WidthRequest="100"
            Color="{StaticResource Primary}" />
    </Grid>
</ContentPage>
