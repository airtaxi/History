<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="History.MobileClient.Pages.ModerationRecordsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    xmlns:behaviors="clr-namespace:History.MobileClient.Behaviors"
    xmlns:views="clr-namespace:History.MobileClient.ContentViews"
    xmlns:viewModels="clr-namespace:History.MobileClient.ViewModels"
    Loaded="OnLoaded"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">
    <ContentPage.Behaviors>
        <behaviors:StatusBarBehavior StatusBarColor="{StaticResource Primary}" StatusBarTheme="Dark" />
    </ContentPage.Behaviors>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Padding="12,0,12,0"
            BackgroundColor="{StaticResource Primary}"
            HeightRequest="48">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTitleGridTapped" />
            </Grid.GestureRecognizers>

            <HorizontalStackLayout Spacing="8">
                <Image HeightRequest="24" WidthRequest="24">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackImageTapped" />
                    </Image.GestureRecognizers>
                    <Image.Source>
                        <FontImageSource FontFamily="MaterialSharp" Glyph="{x:Static m:MaterialSharp.Arrow_back_ios}" />
                    </Image.Source>
                </Image>
                <Label
                    FontAttributes="Bold"
                    FontSize="20"
                    Text="제재 내역"
                    TextColor="White"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Grid>

        <Grid Grid.Row="1">
            <RefreshView Refreshing="OnRefreshing">
                <CollectionView
                    x:Name="MainCollectionView"
                    ItemsUpdatingScrollMode="KeepItemsInView"
                    RemainingItemsThreshold="3"
                    RemainingItemsThresholdReached="OnMainCollectionViewRemainingItemsThresholdReached"
                    Scrolled="OnMainCollectionViewScrolled"
                    SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ModerationRecordViewModel">
                            <Border
                                Margin="12,6"
                                Padding="12"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF,
                                                                  Dark=#1A1A1A}"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="8">
                                    <!--  제재 유형 및 날짜  -->
                                    <Grid>
                                        <HorizontalStackLayout Spacing="8">
                                            <Border
                                                Padding="6,2"
                                                BackgroundColor="{StaticResource Primary}"
                                                StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="4" />
                                                </Border.StrokeShape>
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="12"
                                                    Text="{Binding TypeDisplayString}"
                                                    TextColor="White" />
                                            </Border>
                                        </HorizontalStackLayout>
                                        <Label
                                            FontSize="12"
                                            HorizontalOptions="End"
                                            Text="{Binding CreatedAtDisplayString}"
                                            TextColor="#808080"
                                            VerticalOptions="Center" />
                                    </Grid>

                                    <!--  대상 사용자  -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Label
                                            Grid.Column="0"
                                            FontSize="14"
                                            Text="대상:"
                                            TextColor="#808080"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            Text="{Binding User.Nickname}"
                                            VerticalOptions="Center" />
                                    </Grid>

                                    <!--  처리 관리자  -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Label
                                            Grid.Column="0"
                                            FontSize="14"
                                            Text="처리자:"
                                            TextColor="#808080"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            FontSize="14"
                                            Text="{Binding Moderator.Nickname}"
                                            VerticalOptions="Center" />
                                    </Grid>

                                    <!--  사유  -->
                                    <VerticalStackLayout Spacing="4">
                                        <Label
                                            FontSize="14"
                                            Text="사유:"
                                            TextColor="#808080" />
                                        <Label FontSize="14" Text="{Binding Reason}" />
                                    </VerticalStackLayout>

                                    <!--  연관 콘텐츠  -->
                                    <VerticalStackLayout IsVisible="{Binding HasContents}" Spacing="4">
                                        <Label
                                            FontSize="14"
                                            Text="콘텐츠:"
                                            TextColor="#808080" />
                                        <Border
                                            Padding="8"
                                            BackgroundColor="{AppThemeBinding Light=#F5F5F5,
                                                                              Dark=#2A2A2A}"
                                            StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6" />
                                            </Border.StrokeShape>
                                            <VerticalStackLayout
                                                BindableLayout.ItemTemplateSelector="{StaticResource ContentTemplateSelector}"
                                                BindableLayout.ItemsSource="{Binding ContentViewModels}"
                                                Spacing="8" />
                                        </Border>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>

        <Border
            x:Name="ScrollToTopBorder"
            Grid.Row="1"
            Margin="12"
            Background="#808080"
            HeightRequest="48"
            HorizontalOptions="Start"
            IsVisible="False"
            Opacity="0.8"
            StrokeThickness="0"
            VerticalOptions="End"
            WidthRequest="48">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnScrollToTopBorderTapped" />
            </Border.GestureRecognizers>
            <Border.Shadow>
                <Shadow
                    Brush="Black"
                    Opacity="0.4"
                    Radius="3"
                    Offset="1,2" />
            </Border.Shadow>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30" />
            </Border.StrokeShape>
            <Image HeightRequest="52" WidthRequest="52">
                <Image.Source>
                    <FontImageSource
                        FontFamily="MaterialSharp"
                        Glyph="{x:Static m:MaterialSharp.Keyboard_arrow_up}"
                        Size="80"
                        Color="White" />
                </Image.Source>
            </Image>
        </Border>

        <ActivityIndicator
            x:Name="MainActivityIndicator"
            Grid.RowSpan="2"
            HeightRequest="100"
            HorizontalOptions="Center"
            IsRunning="False"
            VerticalOptions="Center"
            WidthRequest="100"
            Color="{StaticResource Primary}" />
    </Grid>
</ContentPage>
