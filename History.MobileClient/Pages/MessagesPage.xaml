<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="History.MobileClient.Pages.MessagesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:views="clr-namespace:History.MobileClient.ContentViews"
    xmlns:vm="clr-namespace:History.MobileClient.ViewModels"
    Shell.NavBarIsVisible="False">
    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior ApplyOn="OnPageNavigatedTo" StatusBarColor="{StaticResource Primary}" />
        <toolkit:StatusBarBehavior ApplyOn="OnBehaviorAttachedTo" StatusBarColor="{StaticResource Primary}" />
    </ContentPage.Behaviors>
    <Grid RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid
            Grid.Row="0"
            Padding="12,0,0,0"
            BackgroundColor="{StaticResource Primary}"
            HeightRequest="48">
            <HorizontalStackLayout>
                <Label
                    FontAttributes="Bold"
                    FontSize="20"
                    Text="쪽지"
                    TextColor="White"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Grid>
        <Grid Grid.Row="1">
            <RefreshView Refreshing="OnRefreshing">
                <Grid>
                    <CollectionView
                        x:Name="MainCollectionView"
                        RemainingItemsThreshold="0"
                        RemainingItemsThresholdReached="OnMainCollectionViewRemainingItemsThresholdReached"
                        SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:MessageViewModel">
                                <Grid Padding="12,8,12,8" ColumnSpacing="8">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{x:Binding OpenMessageCommand}" />
                                    </Grid.GestureRecognizers>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <views:DataTemplatePresenter
                                            HeightRequest="40"
                                            Template="{StaticResource MediaTemplateSelector}"
                                            ViewModel="{x:Binding Sender.ProfileMediaId}"
                                            WidthRequest="40">
                                            <views:DataTemplatePresenter.Clip>
                                                <EllipseGeometry
                                                    Center="20,20"
                                                    RadiusX="20"
                                                    RadiusY="20" />
                                            </views:DataTemplatePresenter.Clip>
                                        </views:DataTemplatePresenter>
                                    </Grid>
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="1"
                                            Text="{x:Binding SenderName}" />
                                        <Label
                                            FontSize="14"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="1"
                                            Text="{x:Binding MainText}"
                                            TextColor="{AppThemeBinding Dark=#CFCFCF,
                                                                        Light=#303030}" />
                                        <Label
                                            FontSize="12"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="1"
                                            Text="{x:Binding TimestampText}"
                                            TextColor="#808080" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Label
                        x:Name="EmptyLabel"
                        FontSize="16"
                        HorizontalOptions="Center"
                        IsVisible="False"
                        Text="받은 쪽지가 없습니다."
                        TextColor="#888888"
                        VerticalOptions="Center" />
                </Grid>
            </RefreshView>
        </Grid>
        <ActivityIndicator
            x:Name="MainActivityIndicator"
            Grid.RowSpan="2"
            HeightRequest="100"
            HorizontalOptions="Center"
            IsRunning="False"
            VerticalOptions="Center"
            WidthRequest="100"
            Color="{StaticResource Primary}" />
    </Grid>
</ContentPage>
