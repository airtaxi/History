<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="History.MobileClient.Pages.UserPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:staggered="clr-namespace:History.MobileClient.StaggeredLayout"
    xmlns:vm="clr-namespace:History.MobileClient.ViewModels"
    SizeChanged="OnSizeChanged">
    <ContentPage.Resources>
        <vm:TimelineTemplateSelector
            x:Key="TimelineTemplateSelector"
            PostTemplate="{StaticResource PostTemplate}"
            ProfileTemplate="{StaticResource ProfileTemplate}" />
    </ContentPage.Resources>

    <CollectionView x:Name="MainCollectionView" ItemTemplate="{StaticResource TimelineTemplateSelector}">
        <CollectionView.ItemsLayout>
            <staggered:StaggeredItemsLayout Span="1" />
        </CollectionView.ItemsLayout>
    </CollectionView>
</ContentPage>