<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="History.MobileClient.Pages.PostInteractionUsersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://schemas.microsoft.com/dotnet/2021/maui/design"
    xmlns:local="clr-namespace:History.MobileClient.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="local:PostInteractionUsersPage"
    mc:Ignorable="d">
    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior ApplyOn="OnPageNavigatedTo" StatusBarColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
        <toolkit:StatusBarBehavior ApplyOn="OnBehaviorAttachedTo" StatusBarColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
    </ContentPage.Behaviors>
    <ContentPage.Content>
        <Grid>
            <CollectionView ItemTemplate="{StaticResource FriendshipTemplate}" ItemsSource="{x:Binding Users}" />
            <Label
                FontAttributes="Bold"
                FontSize="16"
                HorizontalOptions="Center"
                IsVisible="{x:Binding HasNoUsers}"
                Text="{x:Binding NoUsersText}"
                VerticalOptions="Center" />
        </Grid>
    </ContentPage.Content>
</ContentPage>
