<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="History.MobileClient.Pages.InviteCodesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:History.MobileClient.ViewModels"
    Shell.NavBarIsVisible="False">
    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior ApplyOn="OnPageNavigatedTo" StatusBarColor="{StaticResource Primary}" />
        <toolkit:StatusBarBehavior ApplyOn="OnBehaviorAttachedTo" StatusBarColor="{StaticResource Primary}" />
    </ContentPage.Behaviors>
    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid
            Grid.Row="0"
            Padding="8,0,8,0"
            BackgroundColor="{StaticResource Primary}"
            HeightRequest="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>
            <Image
                Grid.Column="0"
                HeightRequest="24"
                HorizontalOptions="Start"
                VerticalOptions="Center"
                WidthRequest="24">
                <Image.Source>
                    <FontImageSource
                        FontFamily="MaterialSharp"
                        Glyph="{x:Static m:MaterialSharp.Arrow_back}"
                        Color="White" />
                </Image.Source>
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Image.GestureRecognizers>
            </Image>
            <Label
                Grid.Column="1"
                FontAttributes="Bold"
                FontSize="20"
                HorizontalOptions="Center"
                Text="초대 코드"
                TextColor="White"
                VerticalOptions="Center" />
            <Image
                Grid.Column="2"
                HeightRequest="24"
                HorizontalOptions="End"
                VerticalOptions="Center"
                WidthRequest="24">
                <Image.Source>
                    <FontImageSource
                        FontFamily="MaterialSharp"
                        Glyph="{x:Static m:MaterialSharp.Featured_seasonal_and_gifts}"
                        Color="White" />
                </Image.Source>
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRequestInviteCodesTapped" />
                </Image.GestureRecognizers>
            </Image>
        </Grid>

        <RefreshView
            x:Name="RefreshView"
            Grid.Row="1"
            Refreshing="OnRefreshViewRefreshing">
            <CollectionView
                x:Name="InviteCodesCollectionView"
                Margin="12"
                RemainingItemsThreshold="3"
                RemainingItemsThresholdReached="OnRemainingItemsThresholdReached">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:InviteCodeViewModel">
                        <Border
                            Margin="0,0,0,8"
                            Padding="16"
                            BackgroundColor="{AppThemeBinding Light=#F5F5F5,
                                                              Dark=#2A2A2A}"
                            StrokeShape="RoundRectangle"
                            StrokeThickness="0">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label
                                        CharacterSpacing="2"
                                        FontAttributes="Bold"
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="24"
                                        Text="{Binding Code}" />
                                    <Label
                                        FontSize="12"
                                        Text="{Binding StatusText}"
                                        TextColor="#808080" />
                                    <Label
                                        FontSize="12"
                                        IsVisible="{Binding IsUsed}"
                                        TextColor="#808080">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="사용자: " />
                                                <Span Text="{Binding UsedByNickname}" />
                                                <Span Text=" (" />
                                                <Span Text="{Binding UsedAt, StringFormat='{0:yyyy.MM.dd HH:mm}'}" />
                                                <Span Text=")" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                                <Border
                                    Grid.Column="1"
                                    Padding="8,4"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF,
                                                                      Dark=#1A1A1A}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    VerticalOptions="Start">
                                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="4">
                                        <Image
                                            Grid.Column="0"
                                            HeightRequest="20"
                                            HorizontalOptions="Center"
                                            IsVisible="{Binding IsActive}"
                                            VerticalOptions="Center"
                                            WidthRequest="20">
                                            <Image.Source>
                                                <FontImageSource
                                                    FontFamily="MaterialSharp"
                                                    Glyph="{x:Static m:MaterialSharp.Content_copy}"
                                                    Color="{StaticResource Primary}" />
                                            </Image.Source>
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnCopyButtonTapped" />
                                            </Image.GestureRecognizers>
                                        </Image>
                                        <Label
                                            Grid.Column="1"
                                            FontAttributes="Bold"
                                            FontSize="12"
                                            Text="{Binding StatusText}"
                                            TextColor="{Binding IsActive, Converter={StaticResource BoolToPrimaryColorConverter}}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="24"
                        HorizontalOptions="Center"
                        Spacing="12"
                        VerticalOptions="Center">
                        <Image
                            HeightRequest="48"
                            HorizontalOptions="Center"
                            WidthRequest="48">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="MaterialSharp"
                                    Glyph="{x:Static m:MaterialSharp.Featured_seasonal_and_gifts}"
                                    Color="#808080" />
                            </Image.Source>
                        </Image>
                        <Label
                            FontSize="16"
                            HorizontalOptions="Center"
                            Text="초대 코드가 없습니다." />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

        <!--  Loading indicator  -->
        <ActivityIndicator
            x:Name="MainActivityIndicator"
            Grid.RowSpan="2"
            HeightRequest="100"
            HorizontalOptions="Center"
            IsRunning="False"
            VerticalOptions="Center"
            WidthRequest="100"
            Color="{StaticResource Primary}" />
    </Grid>
</ContentPage>