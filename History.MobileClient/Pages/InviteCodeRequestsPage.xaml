<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="History.MobileClient.Pages.InviteCodeRequestsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:History.MobileClient.ViewModels"
    Shell.NavBarIsVisible="False">
    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior ApplyOn="OnPageNavigatedTo" StatusBarColor="{StaticResource Primary}" />
        <toolkit:StatusBarBehavior ApplyOn="OnBehaviorAttachedTo" StatusBarColor="{StaticResource Primary}" />
    </ContentPage.Behaviors>
    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid
            Grid.Row="0"
            Padding="8,0,8,0"
            BackgroundColor="{StaticResource Primary}"
            HeightRequest="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>
            <Image
                Grid.Column="0"
                HeightRequest="24"
                HorizontalOptions="Start"
                VerticalOptions="Center"
                WidthRequest="24">
                <Image.Source>
                    <FontImageSource
                        FontFamily="MaterialSharp"
                        Glyph="{x:Static m:MaterialSharp.Arrow_back}"
                        Color="White" />
                </Image.Source>
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Image.GestureRecognizers>
            </Image>
            <Label
                Grid.Column="1"
                FontAttributes="Bold"
                FontSize="20"
                HorizontalOptions="Center"
                Text="초대 코드 요청 관리"
                TextColor="White"
                VerticalOptions="Center" />
        </Grid>

        <RefreshView
            x:Name="RefreshView"
            Grid.Row="1"
            Refreshing="OnRefreshViewRefreshing">
            <CollectionView
                x:Name="RequestsCollectionView"
                Margin="12"
                RemainingItemsThreshold="3"
                RemainingItemsThresholdReached="OnRemainingItemsThresholdReached">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:InviteCodeRequestViewModel">
                        <Border
                            Margin="0,0,0,8"
                            Padding="16"
                            BackgroundColor="{AppThemeBinding Light=#F5F5F5,
                                                              Dark=#2A2A2A}"
                            StrokeShape="RoundRectangle"
                            StrokeThickness="0">
                            <VerticalStackLayout Spacing="8">
                                <!--  Requester info  -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label
                                        Grid.Column="0"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        Text="{Binding RequesterNickname}" />
                                    <Border
                                        Grid.Column="1"
                                        Padding="8,4"
                                        BackgroundColor="{AppThemeBinding Light=#FFFFFF,
                                                                          Dark=#1A1A1A}"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0"
                                        VerticalOptions="Start">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="12"
                                            Text="{Binding StatusText}"
                                            TextColor="{StaticResource Primary}" />
                                    </Border>
                                </Grid>

                                <!--  Details  -->
                                <Label FontSize="14" TextColor="#808080">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="요청 갯수: " />
                                            <Span Text="{Binding RequestedCount}" />
                                            <Span Text="개" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label FontSize="14" TextColor="#808080">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="보유 중인 유효 코드: " />
                                            <Span Text="{Binding ActiveCodeCount}" />
                                            <Span Text="개" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label
                                    FontSize="14"
                                    Text="{Binding Reason}"
                                    TextColor="#808080" />
                                <Label FontSize="12" TextColor="#808080">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="요청 시간: " />
                                            <Span Text="{Binding CreatedAt, StringFormat='{0:yyyy.MM.dd HH:mm}'}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <!--  Moderator message (if processed)  -->
                                <Label
                                    FontSize="12"
                                    IsVisible="{Binding IsPending, Converter={StaticResource InvertedBoolConverter}}"
                                    TextColor="#808080">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="관리자 메시지: " />
                                            <Span Text="{Binding ModeratorMessage}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <!--  Action buttons (only for pending)  -->
                                <HorizontalStackLayout
                                    HeightRequest="44"
                                    IsVisible="{Binding IsPending}"
                                    Spacing="8">
                                    <Button
                                        BackgroundColor="{StaticResource Primary}"
                                        Clicked="OnAcceptButtonClicked"
                                        CornerRadius="8"
                                        HorizontalOptions="Fill"
                                        Text="수락"
                                        TextColor="White" />
                                    <Button
                                        BackgroundColor="#808080"
                                        Clicked="OnRejectButtonClicked"
                                        CornerRadius="8"
                                        HorizontalOptions="Fill"
                                        Text="거부"
                                        TextColor="White" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="24"
                        HorizontalOptions="Center"
                        Spacing="12"
                        VerticalOptions="Center">
                        <Image
                            HeightRequest="48"
                            HorizontalOptions="Center"
                            WidthRequest="48">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="MaterialSharp"
                                    Glyph="{x:Static m:MaterialSharp.Pending_actions}"
                                    Color="#808080" />
                            </Image.Source>
                        </Image>
                        <Label
                            FontSize="16"
                            HorizontalOptions="Center"
                            Text="대기 중인 초대 코드 요청이 없습니다." />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

        <!--  Loading indicator  -->
        <ActivityIndicator
            x:Name="MainActivityIndicator"
            Grid.Row="0"
            Grid.RowSpan="2"
            IsVisible="False"
            Color="{StaticResource Primary}" />
    </Grid>
</ContentPage>