<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="History.MobileClient.Pages.PendingFriendRequestsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Shell.NavBarIsVisible="False">
    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior ApplyOn="OnPageNavigatedTo" StatusBarColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
        <toolkit:StatusBarBehavior ApplyOn="OnBehaviorAttachedTo" StatusBarColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
    </ContentPage.Behaviors>
    <Grid x:Name="RootGrid">
        <RefreshView Refreshing="OnRefreshing">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="PillGrid"
                    Grid.Row="0"
                    Padding="12,10"
                    ColumnSpacing="8"
                    IsVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="HistoryPillBorder"
                        Grid.Column="0"
                        HeightRequest="34"
                        StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHistoryPillTapped" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="17" />
                        </Border.StrokeShape>
                        <Label
                            x:Name="HistoryPillLabel"
                            Padding="16,0"
                            FontAttributes="Bold"
                            FontSize="13"
                            HorizontalOptions="Center"
                            Text="히스토리"
                            VerticalOptions="Center" />
                    </Border>
                    <Border
                        x:Name="HistoryPillBadgeBorder"
                        Grid.Column="0"
                        Margin="0,-8,-8,0"
                        BackgroundColor="#E53935"
                        HeightRequest="18"
                        HorizontalOptions="End"
                        IsVisible="False"
                        StrokeThickness="0"
                        VerticalOptions="Start"
                        WidthRequest="18">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="9" />
                        </Border.StrokeShape>
                        <Label
                            x:Name="HistoryPillBadgeLabel"
                            FontAttributes="Bold"
                            FontSize="10"
                            HorizontalOptions="Center"
                            TextColor="White"
                            VerticalOptions="Center" />
                    </Border>
                    <Border
                        x:Name="KakaoStoryPillBorder"
                        Grid.Column="1"
                        HeightRequest="34"
                        StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnKakaoStoryPillTapped" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="17" />
                        </Border.StrokeShape>
                        <Label
                            x:Name="KakaoStoryPillLabel"
                            Padding="16,0"
                            FontAttributes="Bold"
                            FontSize="13"
                            HorizontalOptions="Center"
                            Text="카카오스토리"
                            VerticalOptions="Center" />
                    </Border>
                    <Border
                        x:Name="KakaoStoryPillBadgeBorder"
                        Grid.Column="1"
                        Margin="0,-8,-8,0"
                        BackgroundColor="#E53935"
                        HeightRequest="18"
                        HorizontalOptions="End"
                        IsVisible="False"
                        StrokeThickness="0"
                        VerticalOptions="Start"
                        WidthRequest="18">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="9" />
                        </Border.StrokeShape>
                        <Label
                            x:Name="KakaoStoryPillBadgeLabel"
                            FontAttributes="Bold"
                            FontSize="10"
                            HorizontalOptions="Center"
                            TextColor="White"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1">
                    <CollectionView x:Name="MainCollectionView" ItemTemplate="{StaticResource FriendshipTemplate}" />
                    <Label
                        x:Name="EmptyLabel"
                        FontAttributes="Bold"
                        FontSize="16"
                        HorizontalOptions="Center"
                        Text="받은 친구 신청이 없습니다"
                        VerticalOptions="Center" />
                </Grid>
            </Grid>
        </RefreshView>

        <ActivityIndicator
            x:Name="MainActivityIndicator"
            HeightRequest="100"
            HorizontalOptions="Center"
            IsRunning="False"
            VerticalOptions="Center"
            WidthRequest="100"
            Color="{StaticResource Primary}" />
    </Grid>
</ContentPage>