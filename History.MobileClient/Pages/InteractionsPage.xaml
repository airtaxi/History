<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="History.MobileClient.Pages.InteractionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://schemas.microsoft.com/dotnet/2021/maui/design"
    xmlns:local="clr-namespace:History.MobileClient.Pages"
    xmlns:m="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="local:InteractionsPage"
    Loaded="OnLoaded"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    mc:Ignorable="d">
    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior ApplyOn="OnPageNavigatedTo" StatusBarColor="{StaticResource Primary}" />
        <toolkit:StatusBarBehavior ApplyOn="OnBehaviorAttachedTo" StatusBarColor="{StaticResource Primary}" />
    </ContentPage.Behaviors>
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid
                x:Name="TitleGrid"
                Grid.Row="0"
                Padding="12,0,0,0"
                BackgroundColor="{StaticResource Primary}"
                HeightRequest="48">
                <HorizontalStackLayout>
                    <Image HeightRequest="24" WidthRequest="24">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackImageTapped" />
                        </Image.GestureRecognizers>
                        <Image.Source>
                            <FontImageSource FontFamily="MaterialSharp" Glyph="{x:Static m:MaterialSharp.Arrow_back_ios}" />
                        </Image.Source>
                    </Image>
                    <Label
                        x:Name="TitleLabel"
                        FontAttributes="Bold"
                        FontSize="20"
                        TextColor="White"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>

            <Grid Grid.Row="1">
                <CollectionView ItemTemplate="{StaticResource FriendshipTemplate}" ItemsSource="{x:Binding ViewModels}" />
                <Label
                    FontAttributes="Bold"
                    FontSize="16"
                    HorizontalOptions="Center"
                    IsVisible="{x:Binding HasNoUsers}"
                    Text="{x:Binding NoUsersText}"
                    VerticalOptions="Center" />
            </Grid>

            <ActivityIndicator
                x:Name="MainActivityIndicator"
                Grid.RowSpan="2"
                HeightRequest="100"
                HorizontalOptions="Center"
                IsRunning="False"
                VerticalOptions="Center"
                WidthRequest="100"
                Color="{StaticResource Primary}" />
        </Grid>
    </ContentPage.Content>
</ContentPage>
