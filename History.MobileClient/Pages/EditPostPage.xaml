<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="History.MobileClient.Pages.EditPostPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    xmlns:mention="clr-namespace:SpeakLink.Mention;assembly=SpeakLink">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" HeightRequest="48">
            <VerticalStackLayout>
                <ImageButton>
                    <ImageButton.Source>
                        <FontImageSource FontFamily="MaterialSharp" Glyph="{x:Static m:MaterialSharp.Arrow_back}" />
                    </ImageButton.Source>
                </ImageButton>
                <Picker x:Name="DiscoveryOptionPicker" SelectedIndex="0" />
            </VerticalStackLayout>

            <Button
                FontAttributes="Bold"
                Text="올리기"
                TextColor="{StaticResource Primary}" />
        </Grid>

        <ScrollView x:Name="WritePost" Grid.Row="1">
            <VerticalStackLayout Spacing="8">
                <mention:MentionEditor
                    x:Name="MainMentionEditor"
                    ExplicitCharacters="@"
                    FormattedText=""
                    Placeholder="무슨 일이 일어나고 있나요?" />
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>