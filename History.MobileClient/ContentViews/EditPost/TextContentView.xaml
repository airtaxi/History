<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="History.MobileClient.ContentViews.EditPost.TextContentView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
    xmlns:suggestingBox="clr-namespace:SuggestingBox.Maui;assembly=SuggestingBox.Maui"
    xmlns:views="clr-namespace:History.MobileClient.ContentViews"
    xmlns:vm="clr-namespace:History.MobileClient.ViewModels;assembly=History.MobileClient"
    x:DataType="vm:MentionsViewModel"
    Unloaded="OnUnloaded">

    <ContentView.BindingContext>
        <vm:MentionsViewModel x:Name="ViewModel" />
    </ContentView.BindingContext>

    <Grid Padding="4,0,4,0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#000000}">
        <suggestingBox:SuggestingBox
            x:Name="MainSuggestingBox"
            Prefixes="@#"
            Placeholder="무슨 일이 일어나고 있나요?"
            MaxSuggestionHeight="200"
            SuggestionRequested="OnSuggestionRequested"
            SuggestionChosen="OnSuggestionChosen"
            ImageInserted="OnImageInserted"
            HorizontalOptions="Fill"
            VerticalOptions="Start">
            <suggestingBox:SuggestingBox.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="8,4">
                        <Label Text="{Binding .}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </suggestingBox:SuggestingBox.ItemTemplate>
        </suggestingBox:SuggestingBox>
    </Grid>
</ContentView>
