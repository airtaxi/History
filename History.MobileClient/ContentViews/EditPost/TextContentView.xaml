<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="History.MobileClient.ContentViews.EditPost.TextContentView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
    xmlns:suggestingBox="clr-namespace:SuggestingBox.Maui;assembly=SuggestingBox.Maui"
    xmlns:views="clr-namespace:History.MobileClient.ContentViews"
    xmlns:vm="clr-namespace:History.MobileClient.ViewModels;assembly=History.MobileClient"
    x:DataType="vm:MentionsViewModel"
    Unloaded="OnUnloaded">

    <ContentView.BindingContext>
        <vm:MentionsViewModel x:Name="ViewModel" />
    </ContentView.BindingContext>

    <ContentView.Resources>
        <DataTemplate x:Key="UserMentionTemplate" x:DataType="vm:MentionUserViewModel">
            <Grid>
                <HorizontalStackLayout
                    Padding="8"
                    HeightRequest="44"
                    Spacing="8">
                    <views:DataTemplatePresenter
                        HeightRequest="32"
                        Template="{StaticResource MediaTemplateSelector}"
                        VerticalOptions="Center"
                        ViewModel="{x:Binding ProfileMedia}"
                        WidthRequest="32">
                        <views:DataTemplatePresenter.Clip>
                            <EllipseGeometry
                                Center="16,16"
                                RadiusX="16"
                                RadiusY="16" />
                        </views:DataTemplatePresenter.Clip>
                    </views:DataTemplatePresenter>
                    <HorizontalStackLayout
                        HorizontalOptions="Start"
                        Spacing="4"
                        VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="20"
                            LineBreakMode="TailTruncation"
                            Text="{x:Binding Nickname}" />
                        <Image
                            HeightRequest="20"
                            IsVisible="{x:Binding IsAdmin}"
                            WidthRequest="20">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="FASolid"
                                    Glyph="{x:Static fa:Solid.Crown}"
                                    Color="#f78501" />
                            </Image.Source>
                        </Image>
                        <Image
                            HeightRequest="20"
                            IsVisible="{x:Binding IsModerator}"
                            WidthRequest="20">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="FASolid"
                                    Glyph="{x:Static fa:Solid.Gavel}"
                                    Color="#1a5bf3" />
                            </Image.Source>
                        </Image>
                    </HorizontalStackLayout>
                </HorizontalStackLayout>
                <Grid
                    BackgroundColor="#808080"
                    HeightRequest="{OnPlatform iOS=1.5,
                                               Android=1}"
                    HorizontalOptions="Fill"
                    VerticalOptions="End" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="HashtagTemplate" x:DataType="x:String">
            <VerticalStackLayout Padding="8,4">
                <Label Text="{x:Binding}" />
            </VerticalStackLayout>
        </DataTemplate>
    </ContentView.Resources>

    <Grid Padding="4,0,4,0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#000000}">
        <suggestingBox:SuggestingBox
            x:Name="MainSuggestingBox"
            HorizontalOptions="Fill"
            ImageInserted="OnImageInserted"
            MaxSuggestionHeight="200"
            Placeholder="무슨 일이 일어나고 있나요?"
            Prefixes="@#"
            SuggestionChosen="OnSuggestionChosen"
            SuggestionRequested="OnSuggestionRequested"
            VerticalOptions="Start" />
    </Grid>
</ContentView>
