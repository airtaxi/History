<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Microsoft.Xaml.Interactions.Core"
    xmlns:helpers="using:History.Uno.Behaviors"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:vm="using:History.Uno.ViewModels">

    <DataTemplate x:Key="RepostTemplate" x:DataType="vm:RepostViewModel">
        <Grid Padding="6">
            <interactivity:Interaction.Behaviors>
                <interactivity:EventTriggerBehavior EventName="Tapped">
                    <interactivity:InvokeCommandAction Command="{x:Bind HandleTapCommand}" />
                </interactivity:EventTriggerBehavior>
            </interactivity:Interaction.Behaviors>

            <Border
                Padding="12"
                Background="{ThemeResource AppCardBackgroundBrush}"
                CornerRadius="16">
                <StackPanel Spacing="8">
                    <!--  Header  -->
                    <Grid Height="36" ColumnDefinitions="Auto,*">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <!--  Profile  -->
                            <PersonPicture
                                Width="36"
                                Height="36"
                                VerticalAlignment="Center"
                                DisplayName="{Binding Nickname, Mode=OneWay}"
                                ProfilePicture="{Binding ProfileMedia.Uri, Mode=OneWay}">
                                <interactivity:Interaction.Behaviors>
                                    <interactivity:EventTriggerBehavior EventName="Tapped">
                                        <interactivity:InvokeCommandAction Command="{x:Bind HandleProfileTapCommand}" />
                                        <helpers:MarkEventHandledAction />
                                    </interactivity:EventTriggerBehavior>
                                </interactivity:Interaction.Behaviors>
                            </PersonPicture>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Text="{Binding Nickname, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="#F78501"
                                        Glyph="{StaticResource CrownGlyph}"
                                        Visibility="{Binding IsAdmin, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="#1A5BF3"
                                        Glyph="{StaticResource GavelGlyph}"
                                        Visibility="{Binding IsModerator, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource AppSecondaryTextBrush}"
                                        Text="{Binding TimestampText, Mode=OneWay}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource AppSecondaryTextBrush}"
                                        Text=" · " />
                                    <FontIcon
                                        FontSize="12"
                                        Foreground="{ThemeResource AppSecondaryTextBrush}"
                                        Glyph="{Binding DiscoveryOptionGlyph, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <ContentControl Content="{Binding TimelineContents, Mode=OneWay}" ContentTemplate="{StaticResource TimelineContentsTemplate}" />

                    <!--  Reposted-by section  -->
                    <Grid Margin="0,4,0,0">
                        <Rectangle
                            Height="1"
                            VerticalAlignment="Top"
                            Fill="{ThemeResource AppDividerBrush}" />
                        <Grid
                            Margin="0,12,0,0"
                            Padding="6,0,0,6"
                            ColumnDefinitions="36,*"
                            ColumnSpacing="6">
                            <Border
                                Grid.Column="0"
                                Width="36"
                                Height="36"
                                Background="{ThemeResource AppDividerBrush}"
                                CornerRadius="18">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Foreground="{ThemeResource AppCardBackgroundBrush}"
                                    Glyph="{StaticResource ReshareGlyph}" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    FontWeight="Bold"
                                    Foreground="{StaticResource AppPrimaryBrush}"
                                    Text="{Binding RepostedUserNickname, Mode=OneWay}">
                                    <interactivity:Interaction.Behaviors>
                                        <interactivity:EventTriggerBehavior EventName="Tapped">
                                            <interactivity:InvokeCommandAction Command="{x:Bind HandleRepostedUserTapCommand}" />
                                            <helpers:MarkEventHandledAction />
                                        </interactivity:EventTriggerBehavior>
                                    </interactivity:Interaction.Behaviors>
                                </TextBlock>
                                <TextBlock VerticalAlignment="Center" Text="님이 리포스트 했어요" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
