<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Microsoft.Xaml.Interactions.Core"
    xmlns:helpers="using:History.Uno.Behaviors"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:vm="using:History.Uno.ViewModels">

    <DataTemplate x:Key="CommentTemplate" x:DataType="vm:CommentViewModel">
        <Grid
            Padding="6,0,0,6"
            HorizontalAlignment="Stretch"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="8">
            <interactivity:Interaction.Behaviors>
                <interactivity:EventTriggerBehavior EventName="Tapped">
                    <interactivity:InvokeCommandAction Command="{x:Bind HandleTapCommand}" />
                </interactivity:EventTriggerBehavior>
            </interactivity:Interaction.Behaviors>

            <!--  Profile  -->
            <PersonPicture
                Grid.Column="0"
                Width="32"
                Height="32"
                VerticalAlignment="Top"
                DisplayName="{Binding Nickname, Mode=OneWay}"
                ProfilePicture="{Binding ProfileMedia.Uri, Mode=OneWay}">
                <interactivity:Interaction.Behaviors>
                    <interactivity:EventTriggerBehavior EventName="Tapped">
                        <interactivity:InvokeCommandAction Command="{x:Bind HandleProfileTapCommand}" />
                        <helpers:MarkEventHandledAction />
                    </interactivity:EventTriggerBehavior>
                </interactivity:Interaction.Behaviors>
            </PersonPicture>

            <StackPanel Grid.Column="1">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock
                        FontWeight="Bold"
                        Text="{Binding Nickname, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <FontIcon
                        FontSize="14"
                        Foreground="#F78501"
                        Glyph="{StaticResource CrownGlyph}"
                        Visibility="{Binding IsAdmin, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <FontIcon
                        FontSize="14"
                        Foreground="#1A5BF3"
                        Glyph="{StaticResource GavelGlyph}"
                        Visibility="{Binding IsModerator, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <ItemsRepeater ItemsSource="{Binding Contents, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}" ContentTemplateSelector="{StaticResource ContentTemplateSelector}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource AppSecondaryTextBrush}"
                        Text="{Binding TimestampText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasLikes, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <interactivity:Interaction.Behaviors>
                            <interactivity:EventTriggerBehavior EventName="Tapped">
                                <interactivity:InvokeCommandAction Command="{x:Bind HandleCommentLikeTapCommand}" />
                                <helpers:MarkEventHandledAction />
                            </interactivity:EventTriggerBehavior>
                        </interactivity:Interaction.Behaviors>
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource AppForegroundBrush}"
                            Text=" · " />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource AppSecondaryTextBrush}"
                            Text="좋아요 " />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource AppSecondaryTextBrush}"
                            Text="{Binding LikesCount, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!--  More  -->
            <Grid
                Grid.Column="2"
                Width="24"
                Height="24">
                <interactivity:Interaction.Behaviors>
                    <interactivity:EventTriggerBehavior EventName="Tapped">
                        <interactivity:InvokeCommandAction Command="{x:Bind HandleMoreCommand}" />
                        <helpers:MarkEventHandledAction />
                    </interactivity:EventTriggerBehavior>
                </interactivity:Interaction.Behaviors>
                <FontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="20"
                    Foreground="{ThemeResource AppForegroundBrush}"
                    Glyph="{StaticResource MoreHorizGlyph}" />
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
