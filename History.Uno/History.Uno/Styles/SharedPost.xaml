<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Microsoft.Xaml.Interactions.Core"
    xmlns:helpers="using:History.Uno.Behaviors"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:vm="using:History.Uno.ViewModels">

    <DataTemplate x:Key="SharedPostTemplate" x:DataType="vm:PostViewModel">
        <Grid Margin="6">
            <interactivity:Interaction.Behaviors>
                <interactivity:EventTriggerBehavior EventName="Tapped">
                    <interactivity:InvokeCommandAction Command="{x:Bind HandleTapCommand}" />
                </interactivity:EventTriggerBehavior>
            </interactivity:Interaction.Behaviors>

            <Grid>
                <Rectangle
                    Height="1"
                    VerticalAlignment="Top"
                    Fill="{ThemeResource AppDividerBrush}" />
                <StackPanel Margin="0,10,0,0" Spacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <!--  Profile  -->
                            <PersonPicture
                                Width="28"
                                Height="28"
                                VerticalAlignment="Center"
                                DisplayName="{Binding Nickname, Mode=OneWay}"
                                ProfilePicture="{Binding ProfileMedia.Uri, Mode=OneWay}">
                                <interactivity:Interaction.Behaviors>
                                    <interactivity:EventTriggerBehavior EventName="Tapped">
                                        <interactivity:InvokeCommandAction Command="{x:Bind HandleProfileTapCommand}" />
                                        <helpers:MarkEventHandledAction />
                                    </interactivity:EventTriggerBehavior>
                                </interactivity:Interaction.Behaviors>
                            </PersonPicture>
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="4">
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Text="{Binding Nickname, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <FontIcon
                                    FontSize="14"
                                    Foreground="#F78501"
                                    Glyph="{StaticResource CrownGlyph}"
                                    Visibility="{Binding IsAdmin, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="#1A5BF3"
                                    Glyph="{StaticResource GavelGlyph}"
                                    Visibility="{Binding IsModerator, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="4">
                            <interactivity:Interaction.Behaviors>
                                <interactivity:EventTriggerBehavior EventName="Tapped">
                                    <interactivity:InvokeCommandAction Command="{x:Bind HandleMoreTapCommand}" />
                                    <helpers:MarkEventHandledAction />
                                </interactivity:EventTriggerBehavior>
                            </interactivity:Interaction.Behaviors>
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource AppForegroundBrush}"
                                Glyph="{StaticResource ShareGlyph}" />
                            <TextBlock
                                FontSize="14"
                                FontWeight="Bold"
                                Text="{Binding SharedUsersCount, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <ContentControl Content="{Binding TimelineContents, Mode=OneWay}" ContentTemplate="{StaticResource TimelineContentsTemplate}" />
                </StackPanel>
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
