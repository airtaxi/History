<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Microsoft.Xaml.Interactions.Core"
    xmlns:helpers="using:History.Uno.Behaviors"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:vm="using:History.Uno.ViewModels">

    <DataTemplate x:Key="PostTemplate" x:DataType="vm:PostViewModel">
        <Grid Padding="6">
            <interactivity:Interaction.Behaviors>
                <interactivity:EventTriggerBehavior EventName="Tapped">
                    <interactivity:InvokeCommandAction Command="{x:Bind HandleTapCommand}" />
                </interactivity:EventTriggerBehavior>
            </interactivity:Interaction.Behaviors>

            <Border
                Padding="12"
                Background="{ThemeResource AppCardBackgroundBrush}"
                CornerRadius="16">
                <StackPanel Spacing="8">
                    <!--  Header  -->
                    <Grid Height="48" ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <!--  Profile  -->
                            <PersonPicture
                                Width="36"
                                Height="36"
                                VerticalAlignment="Center"
                                DisplayName="{Binding Nickname, Mode=OneWay}"
                                ProfilePicture="{Binding ProfileMedia.Uri, Mode=OneWay}">
                                <interactivity:Interaction.Behaviors>
                                    <interactivity:EventTriggerBehavior EventName="Tapped">
                                        <interactivity:InvokeCommandAction Command="{x:Bind HandleProfileTapCommand}" />
                                        <helpers:MarkEventHandledAction />
                                    </interactivity:EventTriggerBehavior>
                                </interactivity:Interaction.Behaviors>
                            </PersonPicture>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Text="{Binding Nickname, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="#F78501"
                                        Glyph="{StaticResource CrownGlyph}"
                                        Visibility="{Binding IsAdmin, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="#1A5BF3"
                                        Glyph="{StaticResource GavelGlyph}"
                                        Visibility="{Binding IsModerator, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource AppSecondaryTextBrush}"
                                        Text="{Binding TimestampText, Mode=OneWay}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource AppSecondaryTextBrush}"
                                        Text=" · " />
                                    <FontIcon
                                        FontSize="12"
                                        Foreground="{ThemeResource AppSecondaryTextBrush}"
                                        Glyph="{Binding DiscoveryOptionGlyph, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!--  More  -->
                        <Grid
                            Grid.Column="2"
                            Width="28"
                            Height="28"
                            VerticalAlignment="Center">
                            <interactivity:Interaction.Behaviors>
                                <interactivity:EventTriggerBehavior EventName="Tapped">
                                    <interactivity:InvokeCommandAction Command="{x:Bind HandleMoreTapCommand}" />
                                    <helpers:MarkEventHandledAction />
                                </interactivity:EventTriggerBehavior>
                            </interactivity:Interaction.Behaviors>
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{ThemeResource AppForegroundBrush}"
                                Glyph="{StaticResource MoreHorizGlyph}" />
                        </Grid>
                    </Grid>

                    <!--  Contents  -->
                    <ContentControl Content="{Binding TimelineContents, Mode=OneWay}" ContentTemplate="{StaticResource TimelineContentsTemplate}" />

                    <!--  Shared post  -->
                    <ContentControl
                        Content="{Binding ParentPost, Mode=OneWay}"
                        ContentTemplate="{StaticResource SharedPostTemplate}"
                        Visibility="{Binding IsShare, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!--  Action row  -->
                    <StackPanel
                        Margin="0,4,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <interactivity:Interaction.Behaviors>
                                <interactivity:EventTriggerBehavior EventName="Tapped">
                                    <interactivity:InvokeCommandAction Command="{x:Bind HandleReactionCommand}" />
                                    <helpers:MarkEventHandledAction />
                                </interactivity:EventTriggerBehavior>
                            </interactivity:Interaction.Behaviors>
                            <FontIcon
                                FontSize="24"
                                Foreground="{Binding ReactionBrush, Mode=OneWay}"
                                Glyph="{Binding ReactionGlyph, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="Bold"
                                Text="{Binding ReactionsCount, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <FontIcon
                                FontSize="24"
                                Foreground="{ThemeResource AppForegroundBrush}"
                                Glyph="{StaticResource CommentsGlyph}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="Bold"
                                Text="{Binding CommentsCount, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="4"
                            Visibility="{Binding HasSharedUsers, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon
                                FontSize="24"
                                Foreground="{ThemeResource AppForegroundBrush}"
                                Glyph="{StaticResource ShareGlyph}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="Bold"
                                Text="{Binding SharedUsersCount, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="4"
                            Visibility="{Binding HasRepostedUsers, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon
                                FontSize="24"
                                Foreground="{ThemeResource AppForegroundBrush}"
                                Glyph="{StaticResource ReshareGlyph}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="Bold"
                                Text="{Binding RepostedUsersCount, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Latest comment preview  -->
                    <Grid Margin="0,4,0,0" Visibility="{Binding HasComments, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Rectangle
                            Height="1"
                            VerticalAlignment="Top"
                            Fill="{ThemeResource AppDividerBrush}" />
                        <ContentControl
                            Margin="0,12,0,0"
                            Content="{Binding LatestComment, Mode=OneWay}"
                            ContentTemplate="{StaticResource CommentTemplate}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <vm:TimelineTemplateSelector
        x:Key="TimelineTemplateSelector"
        PostTemplate="{StaticResource PostTemplate}"
        RepostTemplate="{StaticResource RepostTemplate}" />
</ResourceDictionary>
