<Page
    x:Class="History.Uno.Pages.RegisterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utu="using:Uno.Toolkit.UI"
    utu:StatusBar.Background="{StaticResource PrimaryColor}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="RegisterInputBackgroundBrush" Color="#F5F5F5" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="RegisterInputBackgroundBrush" Color="#2A2A2A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid utu:SafeArea.Insets="VisibleBounds" RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Border
            Grid.Row="0"
            Height="48"
            Background="{StaticResource PrimaryColor}">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="히스토리 회원가입" />
            </StackPanel>
        </Border>

        <!--  Body  -->
        <StackPanel
            Grid.Row="1"
            Padding="12"
            Spacing="8">
            <TextBlock
                FontSize="18"
                FontWeight="Bold"
                Foreground="{StaticResource PrimaryColor}"
                Text="새로운 보금자리, 히스토리에 오신것을 환영합니다!" />
            <TextBlock FontSize="18" Text="당신의 소중한 기록을 이제 여기서 자유롭게 시작해보세요!" />

            <TextBlock
                Margin="0,8,0,0"
                FontSize="22"
                FontWeight="Bold"
                Text="이용 약관 및 동의" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <CheckBox
                    x:Name="TermsCheckBox"
                    Checked="OnCheckBoxChecked"
                    Unchecked="OnCheckBoxUnchecked" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Tapped="OnTermsTextBlockTapped"
                    Text="[필수] 서비스 이용 약관에 동의합니다" />
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Tapped="OnViewTermsTextBlockTapped"
                    Text="[보기]"
                    TextDecorations="Underline" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <CheckBox
                    x:Name="PrivacyAgreementCheckBox"
                    Checked="OnCheckBoxChecked"
                    Unchecked="OnCheckBoxUnchecked" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Tapped="OnPrivacyAgreementTextBlockTapped"
                    Text="[필수] 개인정보 수집·이용에 동의합니다" />
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Tapped="OnViewPrivacyAgreementTermsTextBlockTapped"
                    Text="[보기]"
                    TextDecorations="Underline" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <CheckBox
                    x:Name="AgeCheckBox"
                    Checked="OnCheckBoxChecked"
                    Unchecked="OnCheckBoxUnchecked" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Tapped="OnAgeTextBlockTapped"
                    Text="[필수] 만 14세 이상 회원입니다" />
            </StackPanel>

            <TextBlock
                Margin="0,16,0,0"
                FontSize="16"
                FontWeight="Bold"
                Text="초대 코드" />
            <Border
                Padding="12,8"
                Background="{ThemeResource RegisterInputBackgroundBrush}"
                CornerRadius="4">
                <TextBox
                    x:Name="InviteCodeTextBox"
                    CharacterSpacing="2"
                    FontSize="18"
                    FontWeight="Bold"
                    MaxLength="8"
                    PlaceholderText="초대 코드를 입력하세요"
                    TextChanged="OnInviteCodeTextBoxTextChanged" />
            </Border>
            <TextBlock
                FontSize="12"
                Foreground="#808080"
                Text="초대 코드가 있어야 가입할 수 있습니다." />
        </StackPanel>

        <!--  Register button  -->
        <Button
            x:Name="RegisterButton"
            Grid.Row="2"
            Height="64"
            Margin="8"
            HorizontalAlignment="Stretch"
            Background="{StaticResource PrimaryColor}"
            Click="OnRegisterButtonClicked"
            Content="가입하기"
            FontSize="24"
            FontWeight="Bold"
            Foreground="White"
            IsEnabled="False" />
    </Grid>
</Page>
