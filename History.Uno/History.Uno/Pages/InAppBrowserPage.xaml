<Page
    x:Class="History.Uno.Pages.InAppBrowserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utu="using:Uno.Toolkit.UI"
    utu:StatusBar.Background="{StaticResource PrimaryColor}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid utu:SafeArea.Insets="VisibleBounds">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid
            Grid.Row="0"
            Height="48"
            Padding="12,0,0,0"
            Background="{StaticResource PrimaryColor}">
            <StackPanel Orientation="Horizontal">
                <Button
                    Width="24"
                    Height="24"
                    Padding="0"
                    VerticalAlignment="Center"
                    Click="OnBackButtonClicked"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Style="{StaticResource IconButtonStyle}">
                    <FontIcon Glyph="&#xE72B;" />
                </Button>

                <TextBlock
                    x:Name="TitleTextBlock"
                    VerticalAlignment="Center"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="White" />
            </StackPanel>
        </Grid>

        <WebView2
            x:Name="BrowserWebView"
            Grid.Row="1"
            NavigationCompleted="OnBrowserWebViewNavigationCompleted"
            NavigationStarting="OnBrowserWebViewNavigationStarting" />

        <ProgressRing
            x:Name="MainProgressRing"
            Grid.Row="0"
            Grid.RowSpan="2"
            IsIndeterminate="True"
            Visibility="Collapsed" />
    </Grid>
</Page>
