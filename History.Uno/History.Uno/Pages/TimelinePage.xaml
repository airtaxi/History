<Page
    x:Class="History.Uno.Pages.TimelinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:utu="using:Uno.Toolkit.UI"
    utu:StatusBar.Background="{StaticResource PrimaryColor}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    NavigationCacheMode="Required"
    SizeChanged="OnSizeChanged">
    <Grid x:Name="RootGrid" utu:SafeArea.Insets="VisibleBounds">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid
            Grid.Row="0"
            Height="48"
            Padding="0,0,12,0"
            Background="{StaticResource PrimaryColor}"
            Tapped="OnTitleGridTapped">
            <Image
                Width="48"
                Height="48"
                HorizontalAlignment="Left"
                Source="ms-appx:///Assets/Images/icon_nobg.png"
                Stretch="Uniform" />

            <FontIcon
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="20"
                Foreground="White"
                Glyph="{StaticResource SearchGlyph}"
                Tapped="OnSearchPostFontIconTapped" />
        </Grid>

        <!--  Timeline list  -->
        <RefreshContainer
            x:Name="MainRefreshContainer"
            Grid.Row="1"
            RefreshRequested="OnMainRefreshContainerRefreshRequested">
            <ScrollViewer
                x:Name="MainScrollViewer"
                VerticalScrollBarVisibility="Auto"
                ViewChanged="OnMainScrollViewerViewChanged">
                <ItemsRepeater x:Name="MainItemsRepeater" ItemTemplate="{StaticResource TimelineTemplateSelector}">
                    <ItemsRepeater.Layout>
                        <controls:StaggeredLayout
                            ColumnSpacing="0"
                            DesiredColumnWidth="400"
                            ItemsStretch="Fill"
                            RowSpacing="0" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
        </RefreshContainer>

        <!--  Write post FAB  -->
        <Border
            x:Name="WritePostBorder"
            Grid.Row="1"
            Width="60"
            Height="60"
            Margin="12"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{StaticResource PrimaryColor}"
            CornerRadius="30"
            Tapped="OnWritePostBorderTapped"
            Translation="0,0,32">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <FontIcon
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="24"
                Foreground="White"
                Glyph="{StaticResource EditGlyph}" />
        </Border>

        <!--  Scroll to top FAB  -->
        <Border
            x:Name="ScrollToTopBorder"
            Grid.Row="1"
            Width="48"
            Height="48"
            Margin="12"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Background="#808080"
            CornerRadius="24"
            Opacity="0.8"
            Tapped="OnScrollToTopBorderTapped"
            Visibility="Collapsed">
            <FontIcon
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="24"
                Foreground="White"
                Glyph="{StaticResource ChevronUpGlyph}" />
        </Border>

        <!--  Loading indicator  -->
        <ProgressRing
            x:Name="MainProgressRing"
            Grid.RowSpan="2"
            Width="100"
            Height="100"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{StaticResource AppPrimaryBrush}"
            IsActive="False"
            Visibility="Collapsed" />
    </Grid>
</Page>
