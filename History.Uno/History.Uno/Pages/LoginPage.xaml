<Page
    x:Class="History.Uno.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utu="using:Uno.Toolkit.UI"
    Background="#fff112">

    <Grid utu:SafeArea.Insets="VisibleBounds">
        <!--  Logo  -->
        <Image
            Width="256"
            Height="256"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Source="ms-appx:///Assets/Images/icon_nobg.png"
            Stretch="Uniform" />

        <!--  Login buttons (hidden until auto-login fails)  -->
        <StackPanel
            x:Name="LoginStackPanel"
            Margin="20"
            Padding="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Spacing="12"
            Visibility="Collapsed">
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="18"
                Foreground="Black"
                Text="SNS 계정으로 계속하기" />
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="GoogleLoginButton"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnGoogleLoginButtonClicked">
                    <Image
                        Width="52"
                        Height="52"
                        Source="ms-appx:///Assets/Images/google_light.png"
                        Stretch="UniformToFill" />
                </Button>
                <Button
                    x:Name="AppleLoginButton"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnAppleLoginButtonClicked">
                    <Image
                        Width="52"
                        Height="52"
                        Source="ms-appx:///Assets/Images/apple_light.png"
                        Stretch="UniformToFill" />
                </Button>
            </StackPanel>
        </StackPanel>

        <!--  Loading indicator  -->
        <ProgressRing
            x:Name="MainProgressRing"
            Width="100"
            Height="100"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsIndeterminate="True"
            Visibility="Collapsed" />
    </Grid>
</Page>
