<Page
    x:Class="History.MobileClient.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:History.MobileClient"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utu="using:Uno.Toolkit.UI"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid utu:SafeArea.Insets="All" Background="#fff112">
        <Image
            Width="256"
            Height="256"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Source="icon_nobg.png" />

        <StackPanel
            x:Name="LoginStackPanel"
            Margin="20"
            Padding="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Spacing="12"
            Visibility="Collapsed">
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="18"
                Foreground="Black"
                Text="SNS 계정으로 계속하기" />
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Image
                    Width="52"
                    Height="52"
                    Source="/Assets/Images/sign_in/google_light.png"
                    Tapped="OnGoogleImageTapped" />
                <Image
                    Width="52"
                    Height="52"
                    Source="/Assets/Images/sign_in/apple_light.png"
                    Tapped="OnAppleImageTapped" />
            </StackPanel>
        </StackPanel>

        <ProgressRing
            x:Name="MainActivityIndicator"
            Width="100"
            Height="100"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{StaticResource Primary}"
            Visibility="Collapsed" />
    </Grid>
</Page>
