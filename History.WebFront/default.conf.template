server {
    listen 80;
    server_name  localhost;

    root   /usr/share/nginx/html;
    index  index.html;

    access_log  /var/log/nginx/server.access.log  main;
    error_log   /var/log/nginx/error.log;
        root /usr/share/nginx/html;
        try_files $uri =404; # 해당 파일이 없으면 404 에러를 반환
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }
}