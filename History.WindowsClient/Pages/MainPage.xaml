<?xml version="1.0" encoding="utf-8" ?>
<local:BasePage
    x:Class="History.WindowsClient.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:History.WindowsClient.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:segmented="using:History.WindowsClient.ThirdParty.SelectorBarSegmented"
    xmlns:vm="using:History.WindowsClient.ViewModels"
    xmlns:vmp="using:History.WindowsClient.ViewModels.MainPage"
    Loaded="OnLoaded"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <Frame
            x:Name="MainFrame"
            Grid.Column="0"
            Background="{ThemeResource CardBackgroundFillColorDefault}"
            CornerRadius="0,16,0,0"
            IsNavigationStackEnabled="False" />

        <Grid
            Grid.Column="1"
            Padding="8"
            RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <segmented:SelectorBarSegmented
                x:Name="ModeSelectorBar"
                Grid.Row="0"
                HorizontalAlignment="Center"
                CornerRadius="8"
                SelectionChanged="OnModeSelectorBarSelectionChanged">
                <SelectorBarItem
                    IsSelected="True"
                    Tag="History"
                    Text="히스토리" />
                <SelectorBarItem
                    Tag="KakaoStory"
                    Text="카카오스토리"
                    Visibility="{x:Bind ViewModel.KakaoStorySelectorVisibility, Mode=OneWay}" />
            </segmented:SelectorBarSegmented>

            <ContentControl
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Content="{x:Bind ViewModel.MyProfileViewModel, Mode=OneWay}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:BaseProfileViewModel">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button
                                Grid.Row="0"
                                Padding="0"
                                HorizontalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind HandleProfileTapCommand}"
                                CommandParameter="Navigate"
                                CornerRadius="50">
                                <PersonPicture ProfilePicture="{x:Bind ProfileImageSource, Mode=OneWay}" />
                            </Button>
                            <StackPanel
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="4">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Text="{x:Bind Nickname, Mode=OneWay}" />
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="#1a5bf3"
                                    Glyph="&#xF760;"
                                    Visibility="{x:Bind IsModerator, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="#f78501"
                                    Glyph="&#xF760;"
                                    Visibility="{x:Bind IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <Grid Grid.Row="2" RowSpacing="8">
                <Grid.Resources>
                    <DataTemplate x:Key="SideBarFriendshipTemplate" x:DataType="vmp:BaseMainPageFriendshipSideBarViewModel">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ScrollViewer
                                Grid.Row="0"
                                HorizontalScrollBarVisibility="Hidden"
                                HorizontalScrollMode="Auto"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled">
                                <segmented:SelectorBarSegmented SelectedIndex="{x:Bind SideBarSelectedIndex, Mode=OneWay}" SelectionChanged="{x:Bind OnSideBarSelectorBarSelectionChanged}">
                                    <SelectorBarItem
                                        IsSelected="True"
                                        Tag="AllFriends"
                                        Text="친구 목록" />
                                    <SelectorBarItem Tag="AddFriends" Text="친구 추가" />
                                    <SelectorBarItem
                                        segmented:SelectorBarSegmented.BadgeValue="{x:Bind MainPageViewModel.PendingFriendRequestCount, Mode=OneWay}"
                                        Tag="PendingFriends"
                                        Text="받은 신청" />
                                    <SelectorBarItem Tag="WaitingFriends" Text="보낸 신청" />
                                    <SelectorBarItem
                                        Tag="IgnoredUsers"
                                        Text="무시한 친구"
                                        Visibility="{x:Bind MainPageViewModel.IsKakaoStoryMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True, Mode=OneWay}" />
                                    <SelectorBarItem Tag="BlockedUsers" Text="차단한 친구" />
                                </segmented:SelectorBarSegmented>
                            </ScrollViewer>

                            <ContentControl
                                Grid.Row="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Content="{x:Bind SideBarContent, Mode=OneWay}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vmp:BaseMainPageFriendshipSideBarItemViewModel">
                                        <Grid RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <AutoSuggestBox
                                                Grid.Row="0"
                                                HorizontalAlignment="Stretch"
                                                PlaceholderText="{x:Bind SearchAutoSuggestBoxPlaceholderText, Mode=OneWay}"
                                                QueryIcon="Find"
                                                QuerySubmitted="{x:Bind OnFriendshipSideBarAutoSuggestBoxQuerySubmitted}"
                                                Text="{x:Bind Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextChanged="{x:Bind OnFriendshipSideBarAutoSuggestBoxTextChanged}" />

                                            <TextBlock
                                                Grid.Row="1"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                FontWeight="Bold"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind RightHeaderText, Mode=OneWay}" />

                                            <ScrollViewer Grid.Row="2">
                                                <ItemsRepeater ItemTemplate="{StaticResource FriendshipTemplate}" ItemsSource="{x:Bind Items, Mode=OneWay}" />
                                            </ScrollViewer>

                                            <TextBlock
                                                Grid.Row="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind EmptyText, Mode=OneWay}"
                                                Visibility="{x:Bind IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </Grid>
                    </DataTemplate>

                    <DataTemplate x:Key="MessageTemplate" x:DataType="vm:BaseMessageViewModel">
                        <Button
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind HandleTapCommand}">
                            <Grid Padding="12,8" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>

                                <Rectangle
                                    Width="3"
                                    Margin="-12,-8,0,-8"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Fill="#E53935"
                                    Visibility="{x:Bind IsUnread, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />

                                <PersonPicture
                                    Grid.Column="0"
                                    Width="36"
                                    Height="36"
                                    VerticalAlignment="Center"
                                    ProfilePicture="{x:Bind ProfileImageSource, Mode=OneWay}" />

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            MaxLines="1"
                                            Text="{x:Bind SenderName, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#1a5bf3"
                                            Glyph="&#xF760;"
                                            Visibility="{x:Bind IsSenderModerator, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#f78501"
                                            Glyph="&#xF760;"
                                            Visibility="{x:Bind IsSenderAdmin, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                    </StackPanel>

                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        MaxLines="1"
                                        Text="{x:Bind MainText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />

                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        MaxLines="1"
                                        Text="{x:Bind TimestampText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Button
                                    Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{x:Bind ReplyCommand}"
                                    ToolTipService.ToolTip="답장"
                                    Visibility="{x:Bind IsReplyButtonVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                    <FontIcon FontSize="16" Glyph="&#xE8CA;" />
                                </Button>

                                <Rectangle
                                    Grid.ColumnSpan="3"
                                    Height="1"
                                    Margin="-12,-8"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Bottom"
                                    Fill="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
                            </Grid>
                        </Button>
                    </DataTemplate>

                    <DataTemplate x:Key="SideBarMessagesTemplate" x:DataType="vmp:BaseMainPageMessagesSideBarViewModel">
                        <Grid Loaded="{x:Bind OnLoaded}" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0">
                                <ItemsRepeater ItemTemplate="{StaticResource MessageTemplate}" ItemsSource="{x:Bind Items, Mode=OneWay}" />
                            </ScrollViewer>

                            <TextBlock
                                Grid.Row="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{x:Bind EmptyText, Mode=OneWay}"
                                Visibility="{x:Bind IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />

                            <Button
                                Grid.Row="1"
                                Height="40"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind WriteMessageCommand}"
                                Content="쪽지 작성"
                                Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                    </DataTemplate>

                    <vmp:MainPageSideBarDataTemplateSelector
                        x:Key="MainPageSideBarDataTemplateSelector"
                        Friendship="{StaticResource SideBarFriendshipTemplate}"
                        Messages="{StaticResource SideBarMessagesTemplate}" />
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <segmented:SelectorBarSegmented
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    CornerRadius="8"
                    SelectionChanged="{x:Bind ViewModel.OnSideBarSelectorBarSelectionChanged}">
                    <SelectorBarItem
                        Icon="People"
                        IsSelected="True"
                        Tag="Friendship"
                        Text="친구" />
                    <SelectorBarItem
                        Icon="Mail"
                        Tag="Messages"
                        Text="쪽지" />
                </segmented:SelectorBarSegmented>

                <ContentControl
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Content="{x:Bind ViewModel.SideBarViewModel, Mode=OneWay}"
                    ContentTemplateSelector="{StaticResource MainPageSideBarDataTemplateSelector}" />
            </Grid>
        </Grid>
    </Grid>
</local:BasePage>
