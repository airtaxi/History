<?xml version="1.0" encoding="utf-8" ?>
<local:BasePage
    x:Class="History.WindowsClient.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:local="using:History.WindowsClient.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:History.WindowsClient.ViewModels"
    xmlns:vmp="using:History.WindowsClient.ViewModels.MainPage"
    Loaded="OnLoaded"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <Frame
            x:Name="MainFrame"
            Grid.Column="0"
            Background="{ThemeResource CardBackgroundFillColorDefault}"
            CornerRadius="0,16,0,0"
            IsNavigationStackEnabled="False" />

        <Grid
            Grid.Column="1"
            Padding="8"
            RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ContentControl
                Grid.Row="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Content="{x:Bind ViewModel.MyProfileViewModel, Mode=OneWay}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:BaseProfileViewModel">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <PersonPicture Grid.Row="0" ProfilePicture="{x:Bind ProfileImageSource, Mode=OneWay}" />
                            <StackPanel
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="4">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Text="{x:Bind Nickname, Mode=OneWay}" />
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="#1a5bf3"
                                    Glyph="&#xF760;"
                                    Visibility="{x:Bind IsModerator, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="#f78501"
                                    Glyph="&#xF760;"
                                    Visibility="{x:Bind IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <Grid Grid.Row="1" RowSpacing="8">
                <Grid.Resources>
                    <DataTemplate x:Key="SideBarFriendshipTemplate" x:DataType="vmp:MainPageFriendshipSideBarViewModel">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ScrollViewer
                                Grid.Row="0"
                                HorizontalScrollBarVisibility="Hidden"
                                HorizontalScrollMode="Auto"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled">
                                <dev:SelectorBarSegmented SelectionChanged="{x:Bind OnSideBarSelectorBarSelectionChanged}">
                                    <SelectorBarItem
                                        IsSelected="True"
                                        Tag="AllFriends"
                                        Text="친구 목록" />
                                    <SelectorBarItem Tag="AddFriends" Text="친구 추가" />
                                    <SelectorBarItem Tag="PendingFriends" Text="받은 신청" />
                                    <SelectorBarItem Tag="WaitingFriends" Text="보낸 신청" />
                                    <SelectorBarItem
                                        Tag="IgnoredUsers"
                                        Text="무시한 친구"
                                        Visibility="{x:Bind MainPageViewModel.IsKakaoStoryMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True, Mode=OneWay}" />
                                    <SelectorBarItem Tag="BlockedUsers" Text="차단한 친구" />
                                </dev:SelectorBarSegmented>
                            </ScrollViewer>

                            <ContentControl
                                Grid.Row="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Content="{x:Bind SideBarContent, Mode=OneWay}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vmp:BaseMainPageFriendshipSideBarItemViewModel">
                                        <Grid RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <AutoSuggestBox
                                                Grid.Row="0"
                                                HorizontalAlignment="Stretch"
                                                PlaceholderText="{x:Bind SearchAutoSuggestBoxPlaceholderText, Mode=OneWay}"
                                                QueryIcon="Find"
                                                QuerySubmitted="{x:Bind OnFriendshipSideBarAutoSuggestBoxQuerySubmitted}"
                                                Text="{x:Bind Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextChanged="{x:Bind OnFriendshipSideBarAutoSuggestBoxTextChanged}" />

                                            <TextBlock
                                                Grid.Row="1"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                FontWeight="Bold"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind RightHeaderText, Mode=OneWay}" />

                                            <ScrollViewer Grid.Row="2">
                                                <ItemsRepeater ItemTemplate="{StaticResource FriendshipTemplate}" ItemsSource="{x:Bind Items, Mode=OneWay}" />
                                            </ScrollViewer>

                                            <TextBlock
                                                Grid.Row="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind EmptyText, Mode=OneWay}"
                                                Visibility="{x:Bind IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </Grid>
                    </DataTemplate>

                    <DataTemplate x:Key="SideBarMessagesTemplate" x:DataType="vmp:MainPageFriendshipSideBarViewModel">
                        <Grid />
                    </DataTemplate>

                    <vmp:MainPageSideBarDataTemplateSelector
                        x:Key="MainPageSideBarDataTemplateSelector"
                        Friendship="{StaticResource SideBarFriendshipTemplate}"
                        Messages="{StaticResource SideBarMessagesTemplate}" />
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <dev:SelectorBarSegmented
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    CornerRadius="8"
                    SelectionChanged="{x:Bind ViewModel.OnSideBarSelectorBarSelectionChanged}">
                    <SelectorBarItem
                        Icon="People"
                        IsSelected="True"
                        Tag="Friendship"
                        Text="친구" />
                    <SelectorBarItem
                        Icon="Mail"
                        Tag="Messages"
                        Text="쪽지" />
                </dev:SelectorBarSegmented>

                <ContentControl
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Content="{x:Bind ViewModel.SideBarViewModel, Mode=OneWay}"
                    ContentTemplateSelector="{StaticResource MainPageSideBarDataTemplateSelector}" />
            </Grid>
        </Grid>
    </Grid>
</local:BasePage>
