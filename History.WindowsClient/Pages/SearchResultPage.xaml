<?xml version="1.0" encoding="utf-8" ?>
<local:BasePage
    x:Class="History.WindowsClient.Pages.SearchResultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:History.WindowsClient.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnLoaded"
    mc:Ignorable="d">

    <Grid>
        <RefreshContainer RefreshRequested="OnRefreshRequested">
            <ScrollViewer Padding="8" VerticalScrollBarVisibility="Hidden">
                <ItemsRepeater
                    x:Name="MainItemsRepeater"
                    ElementPrepared="OnMainItemsRepeaterElementPrepared"
                    ItemTemplate="{StaticResource TimelineTemplateSelector}"
                    ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <controls:StaggeredLayout
                            ColumnSpacing="6"
                            DesiredColumnWidth="400"
                            ItemsStretch="Fill"
                            RowSpacing="6" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
        </RefreshContainer>

        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="검색 결과가 없습니다"
            Visibility="{x:Bind ViewModel.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
    </Grid>
</local:BasePage>
