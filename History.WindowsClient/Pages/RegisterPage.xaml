<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage
    x:Class="History.WindowsClient.Pages.RegisterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:History.WindowsClient"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="using:History.WindowsClient.Pages"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <TextBlock
            Grid.Row="0"
            VerticalAlignment="Center"
            FontWeight="Bold"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="히스토리 회원가입" />

        <!--  Body  -->
        <StackPanel
            Grid.Row="1"
            Padding="8"
            Spacing="6">
            <TextBlock
                FontSize="18"
                FontWeight="Bold"
                Text="새로운 보금자리, 히스토리에 오신것을 환영합니다!" />
            <TextBlock FontSize="18" Text="당신의 소중한 기록을 이제 여기서 자유롭게 시작해보세요!" />

            <TextBlock
                Margin="0,8,0,0"
                FontSize="22"
                FontWeight="Bold"
                Text="이용 약관 및 동의" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <CheckBox Content="[필수] 서비스 이용 약관에 동의합니다" IsChecked="{x:Bind ViewModel.TermsCompleted, Mode=TwoWay}" />
                <Button
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.ViewTermsCommand}">
                    <TextBlock TextDecorations="Underline">[보기]</TextBlock>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <CheckBox Content="[필수] 개인정보 수집·이용에 동의합니다" IsChecked="{x:Bind ViewModel.PrivacyAgreementCompleted, Mode=TwoWay}" />
                <Button
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.ViewPrivacyAgreementCommand}">
                    <TextBlock TextDecorations="Underline">[보기]</TextBlock>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <CheckBox Content="[필수] 만 14세 이상 회원입니다" IsChecked="{x:Bind ViewModel.AgeCompleted, Mode=TwoWay}" />
            </StackPanel>

            <!--  Invite code input  -->
            <StackPanel
                Margin="0,4,0,0"
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefault}"
                CornerRadius="8"
                Spacing="6">
                <TextBlock
                    FontSize="16"
                    FontWeight="Bold"
                    Text="초대 코드" />
                <TextBox
                    MaxLength="9"
                    PlaceholderText="초대 코드를 입력하세요"
                    Text="{x:Bind ViewModel.InviteCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    FontSize="12"
                    Foreground="#808080"
                    Text="초대 코드가 있어야 가입할 수 있습니다." />
            </StackPanel>
        </StackPanel>

        <!--  Register button  -->
        <Button
            Grid.Row="2"
            Height="48"
            Padding="0"
            HorizontalAlignment="Stretch"
            Background="#ED664D"
            BorderThickness="0"
            Command="{x:Bind ViewModel.RegisterCommand}"
            Content="가입하기"
            FontSize="20"
            FontWeight="Bold"
            IsEnabled="{x:Bind ViewModel.IsRegisterButtonEnabled, Mode=OneWay}" />
    </Grid>
</pages:BasePage>
