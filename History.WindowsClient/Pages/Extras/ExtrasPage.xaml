<?xml version="1.0" encoding="utf-8" ?>
<local:BasePage
    x:Class="History.WindowsClient.Pages.Extras.ExtrasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:local="using:History.WindowsClient.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnPageLoaded"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <ScrollViewer x:Name="ExtrasScrollViewer" Padding="24,8,24,24">
        <StackPanel HorizontalAlignment="Stretch" Spacing="8">
            <Border
                Margin="0,8,0,12"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="64"
                        Height="64"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <Image
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="ms-appx:///Assets/Icon.png"
                            Stretch="Uniform" />
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="부가메뉴" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="게시글 관리, 스티커, 초대 코드 등 부가 기능을 한 곳에서 이용하세요."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <dev:SettingsCard
                Command="{x:Bind ViewModel.OpenStickersCommand}"
                Description="스티커 둘러보기 및 만들기"
                Header="스티커"
                IsClickEnabled="True">
                <dev:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xF4AA;" />
                </dev:SettingsCard.HeaderIcon>
            </dev:SettingsCard>

            <dev:SettingsCard
                Command="{x:Bind ViewModel.OpenInviteCodesCommand}"
                Description="내 초대 코드 조회 및 요청"
                Header="초대 코드"
                IsClickEnabled="True">
                <dev:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xF133;" />
                </dev:SettingsCard.HeaderIcon>
            </dev:SettingsCard>

            <dev:SettingsCard
                Command="{x:Bind ViewModel.OpenInviteCodeRequestsCommand}"
                Description="사용자 초대 코드 요청 수락/거부"
                Header="초대 코드 요청 관리"
                IsClickEnabled="True"
                Visibility="{x:Bind ViewModel.InviteCodeRequestsVisibility, Mode=OneWay}">
                <dev:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xF0E3;" />
                </dev:SettingsCard.HeaderIcon>
            </dev:SettingsCard>

            <dev:SettingsCard
                Command="{x:Bind ViewModel.OpenBulkPostManagementCommand}"
                Description="공개 범위 일괄 전환 / 전체 삭제"
                Header="게시글 일괄 관리"
                IsClickEnabled="True">
                <dev:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE90F;" />
                </dev:SettingsCard.HeaderIcon>
            </dev:SettingsCard>

            <dev:SettingsCard
                Command="{x:Bind ViewModel.OpenKakaoStoryExtrasCommand}"
                Description="친구/스토리 일괄 관리 (카카오스토리)"
                Header="카카오스토리 부가기능"
                IsClickEnabled="True"
                Visibility="{x:Bind ViewModel.KakaoStoryExtrasVisibility, Mode=OneWay}">
                <dev:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9E9;" />
                </dev:SettingsCard.HeaderIcon>
            </dev:SettingsCard>

            <dev:SettingsCard
                Command="{x:Bind ViewModel.OpenModerationRecordsCommand}"
                Description="관리자 제재 기록 확인"
                Header="제재 내역"
                IsClickEnabled="True"
                Visibility="{x:Bind ViewModel.ModerationRecordsVisibility, Mode=OneWay}">
                <dev:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEA18;" />
                </dev:SettingsCard.HeaderIcon>
            </dev:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</local:BasePage>
