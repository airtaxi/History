<?xml version="1.0" encoding="utf-8" ?>
<local:BasePage
    x:Class="History.WindowsClient.Pages.Extras.BatchManageKakaoPostsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:History.WindowsClient.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:segmented="using:History.WindowsClient.ThirdParty.SelectorBarSegmented"
    mc:Ignorable="d">

    <Grid Padding="16,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0">
            <StackPanel Spacing="16">
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="대상 필터" />

                        <segmented:SelectorBarSegmented
                            x:Name="FilterSelectorBar"
                            IsEnabled="{x:Bind ViewModel.IsNotRunning, Mode=OneWay}"
                            SelectedIndex="0"
                            SelectionChanged="OnFilterSelectorBarSelectionChanged">
                            <SelectorBarItem Text="모든 게시글" />
                            <SelectorBarItem Text="전체 공개" />
                            <SelectorBarItem Text="친구 공개" />
                            <SelectorBarItem Text="나만 보기" />
                            <SelectorBarItem Text="제한된 게시글" />
                        </segmented:SelectorBarSegmented>
                    </StackPanel>
                </Border>

                <CheckBox
                    Content="관심글 제외"
                    IsChecked="{x:Bind ViewModel.ExcludeBookmarked, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.IsNotRunning, Mode=OneWay}" />

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="내가 작성한 게시글만 대상이 됩니다. 실행하면 내 프로필 피드를 순회하며 조건에 맞는 게시글을 순차 처리합니다."
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1">
            <StackPanel
                Margin="0,8,0,0"
                Orientation="Horizontal"
                Spacing="12"
                Visibility="{x:Bind ViewModel.IsRunning, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                <ProgressBar
                    Width="240"
                    VerticalAlignment="Center"
                    Maximum="{x:Bind ViewModel.ProgressMaximum, Mode=OneWay}"
                    Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
                <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
                <Button Command="{x:Bind ViewModel.CancelCommand}" Content="중단" />
            </StackPanel>

            <Button
                Margin="0,8,0,0"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.ExecuteCommand}"
                Content="{x:Bind ViewModel.ExecuteButtonText, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.IsNotRunning, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</local:BasePage>
