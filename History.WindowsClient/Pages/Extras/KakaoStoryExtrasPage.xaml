<?xml version="1.0" encoding="utf-8" ?>
<local:BasePage
    x:Class="History.WindowsClient.Pages.Extras.KakaoStoryExtrasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:local="using:History.WindowsClient.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnPageLoaded"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <ScrollViewer Padding="16,0,16,16">
        <StackPanel HorizontalAlignment="Stretch" Spacing="8">
            <dev:SettingsCard
                Command="{x:Bind ViewModel.BatchDeleteFriendsCommand}"
                Description="제한된 사용자 정리 / 관심 친구 선택 해제"
                Header="친구 일괄 삭제"
                IsClickEnabled="True">
                <dev:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xF69B;" />
                </dev:SettingsCard.HeaderIcon>
            </dev:SettingsCard>

            <dev:SettingsCard
                Command="{x:Bind ViewModel.BatchDeletePostsCommand}"
                Description="공개 범위 / 제한된 게시글 필터로 일괄 삭제"
                Header="스토리 일괄 삭제"
                IsClickEnabled="True">
                <dev:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE74D;" />
                </dev:SettingsCard.HeaderIcon>
            </dev:SettingsCard>

            <dev:SettingsCard
                Command="{x:Bind ViewModel.BatchChangePermissionCommand}"
                Description="공개 범위 일괄 전환"
                Header="스토리 일괄 변경"
                IsClickEnabled="True">
                <dev:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8AB;" />
                </dev:SettingsCard.HeaderIcon>
            </dev:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</local:BasePage>
