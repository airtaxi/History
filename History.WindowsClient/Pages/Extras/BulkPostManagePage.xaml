<?xml version="1.0" encoding="utf-8" ?>
<local:BasePage
    x:Class="History.WindowsClient.Pages.Extras.BulkPostManagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:History.WindowsClient.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:post="using:History.WindowsClient.ViewModels.Post"
    Loaded="OnPageLoaded"
    mc:Ignorable="d">

    <local:BasePage.Resources>
        <DataTemplate x:Key="SelectablePostTemplate" x:DataType="post:SelectablePostViewModel">
            <Button
                Padding="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Command="{x:Bind HandleTapCommand}"
                CornerRadius="8">
                <Grid
                    Height="180"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel
                        Padding="8"
                        VerticalAlignment="Bottom"
                        Spacing="2">
                        <TextBlock
                            FontSize="12"
                            MaxLines="3"
                            Text="{x:Bind PreviewText}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="10"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            Text="{x:Bind PreviewTimestamp}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Image
                        Source="{x:Bind PreviewThumbnail}"
                        Stretch="UniformToFill"
                        Visibility="{x:Bind PreviewThumbnailVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <Grid
                        Width="24"
                        Height="24"
                        Margin="0,2,2,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Visibility="{x:Bind IsSelectable, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <Border
                            Background="#80000000"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12" />
                        <Border
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="12"
                            Visibility="{x:Bind IsSelected, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Glyph="&#xE73E;" />
                        </Border>
                    </Grid>

                    <Border
                        Height="24"
                        MinWidth="24"
                        Margin="0,0,2,2"
                        Padding="6,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="12"
                        Visibility="{x:Bind HasUnreadNotification, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Text="N" />
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>
    </local:BasePage.Resources>

    <Grid Padding="16,0,16,16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" CornerRadius="8">
            <RefreshContainer RefreshRequested="OnRefreshRequested">
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <ItemsRepeater
                        x:Name="MainItemsRepeater"
                        ElementPrepared="OnMainItemsRepeaterElementPrepared"
                        ItemTemplate="{StaticResource SelectablePostTemplate}"
                        ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="Fill"
                                MinColumnSpacing="8"
                                MinItemHeight="180"
                                MinItemWidth="180"
                                MinRowSpacing="8" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollViewer>
            </RefreshContainer>

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="게시글이 없습니다"
                Visibility="{x:Bind ViewModel.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
        </Grid>

        <Grid
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorDefault}"
            CornerRadius="8">
            <CommandBar
                Padding="16"
                VerticalContentAlignment="Center"
                DefaultLabelPosition="Right"
                IsOpen="False">
                <CommandBar.Content>
                    <TextBlock FontSize="12" Text="{x:Bind ViewModel.SelectedCountText, Mode=OneWay}" />
                </CommandBar.Content>
                <AppBarToggleButton IsChecked="{x:Bind ViewModel.IsSelectAll, Mode=TwoWay}" Label="전체 선택">
                    <AppBarToggleButton.Icon>
                        <FontIcon Glyph="&#xE8B3;" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarButton
                    Command="{x:Bind ViewModel.ChangeDiscoveryOptionCommand}"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                    Label="공개 범위 변경">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE909;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    Command="{x:Bind ViewModel.DeleteSelectedCommand}"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                    Label="삭제">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>
    </Grid>
</local:BasePage>
