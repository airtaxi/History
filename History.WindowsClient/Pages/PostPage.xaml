<?xml version="1.0" encoding="utf-8" ?>
<local:BasePage
    x:Class="History.WindowsClient.Pages.PostPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:History.WindowsClient.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:History.WindowsClient.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid ColumnSpacing="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <ScrollViewer
            Grid.Column="0"
            Background="{ThemeResource CardBackgroundFillColorDefault}"
            CornerRadius="0,16,0,0"
            VerticalScrollBarVisibility="Hidden">
            <ContentControl
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Content="{x:Bind ViewModel.Post, Mode=OneWay}"
                ContentTemplate="{StaticResource PostContentTemplate}" />
        </ScrollViewer>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer
                x:Name="CommentScrollViewer"
                Grid.Row="0"
                VerticalScrollBarVisibility="Hidden">
                <Grid>
                    <ContentControl
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Content="{x:Bind ViewModel.Post, Mode=OneWay}"
                        ContentTemplate="{StaticResource PostCommentTemplate}" />
                    <ContentPresenter Content="{x:Bind ViewModel.Post, Mode=OneWay}" ContentTemplate="{StaticResource PostNoCommentsTemplate}" />
                </Grid>
            </ScrollViewer>

            <!--  Comment composer  -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Rectangle
                    Grid.Row="0"
                    Height="1"
                    HorizontalAlignment="Stretch"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Button
                    Grid.Row="1"
                    Width="100"
                    Height="100"
                    Margin="12,8,12,0"
                    Padding="0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.CommentBox.ClearAttachmentCommand, Mode=OneWay}"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.CommentBox.HasAttachment, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <Grid>
                        <Image
                            Width="100"
                            Height="100"
                            Source="{x:Bind ViewModel.CommentBox.AttachmentImageSource, Mode=OneWay}"
                            Stretch="UniformToFill" />
                        <Rectangle
                            Width="100"
                            Height="100"
                            Fill="Black"
                            Opacity="0.5" />
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="32"
                            Foreground="White"
                            Glyph="&#xE8BB;" />
                    </Grid>
                </Button>

                <Grid
                    Grid.Row="2"
                    Padding="12,8,12,12"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:ContentEditorControl
                        x:Name="CommentEditor"
                        Grid.Column="0"
                        MaxHeight="200"
                        VerticalAlignment="Bottom"
                        AllowHashtag="False"
                        ImageInputRequested="OnCommentEditorImageInputRequested"
                        PlaceholderText="댓글을 달아보세요."
                        SubmitRequested="OnCommentEditorSubmitRequested" />

                    <Button
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        Padding="0"
                        VerticalAlignment="Bottom"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.CommentBox.HandleStickerTapCommand, Mode=OneWay}">
                        <FontIcon
                            FontSize="18"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE76E;" />
                    </Button>

                    <Button
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        Padding="0"
                        VerticalAlignment="Bottom"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.CommentBox.HandleMediaTapCommand, Mode=OneWay}">
                        <FontIcon
                            FontSize="18"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE91B;" />
                    </Button>

                    <Button
                        Grid.Column="3"
                        Width="32"
                        Height="32"
                        Padding="0"
                        VerticalAlignment="Bottom"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnSendCommentButtonClicked">
                        <FontIcon
                            FontSize="18"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE724;" />
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</local:BasePage>