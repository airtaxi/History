<?xml version="1.0" encoding="utf-8" ?>
<local:BasePage
    x:Class="History.WindowsClient.Pages.TimelinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:History.WindowsClient.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:History.WindowsClient.ViewModels"
    Loaded="OnLoaded"
    mc:Ignorable="d">

    <Grid>
        <ScrollView
            x:Name="MainScrollView"
            Padding="8"
            IgnoredInputKinds="MouseWheel"
            PointerWheelChanged="OnMainScrollViewPointerWheelChanged"
            VerticalScrollBarVisibility="Hidden"
            ViewChanged="OnMainScrollViewViewChanged">
            <ItemsRepeater
                x:Name="MainItemsRepeater"
                ElementPrepared="OnMainItemsRepeaterElementPrepared"
                ItemTemplate="{StaticResource TimelineTemplateSelector}"
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <controls:StaggeredLayout
                        ColumnSpacing="6"
                        DesiredColumnWidth="400"
                        ItemsStretch="Fill"
                        RowSpacing="6" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollView>

        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="게시글이 없습니다"
            Visibility="{x:Bind ViewModel.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />

        <Button
            x:Name="ScrollToTopButton"
            Width="44"
            Height="44"
            Margin="0,0,16,16"
            Padding="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{ThemeResource ControlOnImageFillColorDefaultBrush}"
            Click="OnScrollToTopButtonClicked"
            CornerRadius="22"
            ToolTipService.ToolTip="맨 위로"
            Visibility="Collapsed">
            <FontIcon FontSize="18" Glyph="&#xE70E;" />
        </Button>
    </Grid>
</local:BasePage>