<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="History.WindowsClient.Resources.Friendship"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:History.WindowsClient.ViewModels">

    <DataTemplate x:Key="FriendshipTemplate" x:DataType="vm:BaseFriendshipViewModel">
        <Grid Padding="12,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <PersonPicture
                    Width="32"
                    Height="32"
                    ProfilePicture="{x:Bind ProfileThumbnailImageSource}" />
                <Border
                    Width="12"
                    Height="12"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource ControlSolidFillColorDefaultBrush}"
                    CornerRadius="6"
                    Visibility="{x:Bind IsFavorite, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border.RenderTransform>
                        <TranslateTransform X="2" Y="2" />
                    </Border.RenderTransform>
                    <FontIcon
                        FontSize="10"
                        Foreground="{StaticResource SystemAccentColor}"
                        Glyph="&#xE735;" />
                </Border>
            </Grid>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold"
                    MaxLines="1"
                    Text="{x:Bind Nickname, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="#1a5bf3"
                    Glyph="&#xF760;"
                    Visibility="{x:Bind IsModerator, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="#f78501"
                    Glyph="&#xF760;"
                    Visibility="{x:Bind IsAdmin, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
            </StackPanel>
            <Button
                Grid.Column="2"
                Width="32"
                Height="32"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Visibility="{x:Bind FriendshipVisibility}">
                <FontIcon
                    FontSize="20"
                    Foreground="{x:Bind FriendshipForeground, Mode=OneWay}"
                    Glyph="{x:Bind FriendshipGlyph, Mode=OneWay}" />
            </Button>
            <Rectangle
                Grid.ColumnSpan="3"
                Height="1"
                Margin="-12,-8"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Fill="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>
