<?xml version="1.0" encoding="utf-8" ?>
<controls:BaseControl
    x:Class="History.WindowsClient.Controls.PollContentControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Microsoft.Xaml.Interactivity"
    xmlns:controls="using:History.WindowsClient.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:History.WindowsClient.ViewModels"
    Loaded="OnControlLoaded"
    PointerPressed="OnPointerPressed"
    Unloaded="OnControlUnloaded"
    mc:Ignorable="d">

    <Border
        Margin="0,8"
        Padding="12"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        CornerRadius="12">

        <StackPanel Spacing="8">
            <!--  Question  -->
            <TextBlock
                FontSize="16"
                FontWeight="Bold"
                Text="{x:Bind ViewModel.Question, Mode=OneWay}"
                TextWrapping="Wrap" />

            <!--  Options  -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Options, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PollOptionViewModel">
                        <Border
                            Padding="12,10"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="8">
                            <interactivity:Interaction.Behaviors>
                                <behaviors:EventTriggerBehavior EventName="Tapped">
                                    <behaviors:InvokeCommandAction Command="{x:Bind SelectCommand}" />
                                </behaviors:EventTriggerBehavior>
                            </interactivity:Interaction.Behaviors>

                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--  Progress Background  -->
                                <ProgressBar
                                    Grid.Row="0"
                                    Height="6"
                                    Maximum="1"
                                    Visibility="{x:Bind ShowResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Value="{x:Bind Percentage, Mode=OneWay}" />

                                <Grid Grid.Row="1" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Selection Indicator  -->
                                    <Border
                                        Grid.Column="0"
                                        Width="20"
                                        Height="20"
                                        Background="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToAccentBrushConverter}}"
                                        BorderBrush="{ThemeResource SystemAccentColor}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <FontIcon
                                            FontSize="12"
                                            Foreground="White"
                                            Glyph="&#xE73E;"
                                            Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Border>

                                    <!--  Option Text  -->
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Text, Mode=OneWay}"
                                        TextWrapping="Wrap" />

                                    <!--  Vote Count / Percentage  -->
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource CaptionTextBlockFontSize}"
                                        FontWeight="Bold"
                                        Foreground="{ThemeResource SystemAccentColor}"
                                        Text="{x:Bind PercentageText, Mode=OneWay}"
                                        Visibility="{x:Bind ShowResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  Footer Info  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource CaptionTextBlockFontSize}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.TotalVotesText, Mode=OneWay}" />

                <!--  View Results Button  -->
                <Button
                    Grid.Column="1"
                    Margin="0,0,12,0"
                    Padding="8,2"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.ViewResultsCommand, Mode=OneWay}"
                    Content="결과보기"
                    FontSize="{StaticResource CaptionTextBlockFontSize}"
                    Foreground="{ThemeResource SystemAccentColor}"
                    Visibility="{x:Bind ViewModel.ShowResultsButton, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource CaptionTextBlockFontSize}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.ExpiresAtText, Mode=OneWay}" />
            </Grid>
        </StackPanel>
    </Border>
</controls:BaseControl>