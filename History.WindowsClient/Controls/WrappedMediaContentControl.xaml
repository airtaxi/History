<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="History.WindowsClient.Controls.WrappedMediaContentControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Microsoft.Xaml.Interactivity"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:History.WindowsClient.ViewModels.Media"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="ImageTemplate" x:DataType="vm:MediaContentViewModel">
            <Grid Background="Transparent">
                <interactivity:Interaction.Behaviors>
                    <behaviors:EventTriggerBehavior EventName="Tapped">
                        <behaviors:InvokeCommandAction Command="{x:Bind HandleTapCommand}" />
                    </behaviors:EventTriggerBehavior>
                    <behaviors:EventTriggerBehavior EventName="Unloaded">
                        <behaviors:InvokeCommandAction Command="{x:Bind HandleUnloadCommand}" />
                    </behaviors:EventTriggerBehavior>
                </interactivity:Interaction.Behaviors>

                <Image
                    Width="{x:Bind Width, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ImageOpened="OnMediaItemImageOpened"
                    Source="{x:Bind ImageSource}"
                    Stretch="{x:Bind Stretch, Mode=OneTime}" />

                <!--  Spoiler Overlay  -->
                <Button
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#FF000000"
                    BorderThickness="0"
                    Command="{x:Bind HandleSpoilerOverlayTapCommand}"
                    Visibility="{x:Bind IsSpoilerOverlayVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <FontIcon
                            FontSize="48"
                            Foreground="White"
                            Glyph="&#xED1A;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="가려진 미디어" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="#CCCCCC"
                            Text="탭하여 확인하기" />
                    </StackPanel>
                </Button>

                <!--  Description  -->
                <Grid
                    MinHeight="40"
                    VerticalAlignment="Top"
                    Background="#80000000"
                    Visibility="{x:Bind HasDescription, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Bold"
                        MaxLines="2"
                        Text="{x:Bind Description, Mode=OneTime}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="VideoTemplate" x:DataType="vm:MediaContentViewModel">
            <Grid Background="Transparent">
                <interactivity:Interaction.Behaviors>
                    <behaviors:EventTriggerBehavior EventName="Tapped">
                        <behaviors:InvokeCommandAction Command="{x:Bind HandleTapCommand}" />
                    </behaviors:EventTriggerBehavior>
                    <behaviors:EventTriggerBehavior EventName="Unloaded">
                        <behaviors:InvokeCommandAction Command="{x:Bind HandleUnloadCommand}" />
                    </behaviors:EventTriggerBehavior>
                </interactivity:Interaction.Behaviors>

                <Image
                    Width="{x:Bind Width, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ImageOpened="OnMediaItemImageOpened"
                    Source="{x:Bind ImageSource}"
                    Stretch="{x:Bind Stretch, Mode=OneTime}" />

                <!--
                    Only instantiated while inline playback is active (x:Load): recycled carousels
                    that are not playing never realize (or release) a media player element.
                -->
                <MediaPlayerElement
                    x:Name="InlineMediaPlayerElement"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    x:Load="{x:Bind IsPlaying, Mode=OneWay}"
                    AreTransportControlsEnabled="True"
                    AutoPlay="True"
                    Source="{x:Bind PlaybackMediaSource, Mode=OneWay}" />

                <!--  Video Overlay  -->
                <Button
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#80000000"
                    BorderThickness="0"
                    Command="{x:Bind HandleOverlayTapCommand}"
                    Visibility="{x:Bind IsOverlayVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="150"
                        Foreground="White"
                        Glyph="&#xE768;" />
                </Button>

                <!--  Spoiler Overlay  -->
                <Button
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#FF000000"
                    BorderThickness="0"
                    Command="{x:Bind HandleSpoilerOverlayTapCommand}"
                    Visibility="{x:Bind IsSpoilerOverlayVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <FontIcon
                            FontSize="48"
                            Foreground="White"
                            Glyph="&#xED1A;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="가려진 미디어" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="#CCCCCC"
                            Text="탭하여 확인하기" />
                    </StackPanel>
                </Button>

                <!--  Description  -->
                <Grid
                    MinHeight="40"
                    VerticalAlignment="Top"
                    Background="#80000000"
                    Visibility="{x:Bind HasDescription, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Bold"
                        MaxLines="2"
                        Text="{x:Bind Description, Mode=OneTime}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </Grid>
            </Grid>
        </DataTemplate>

        <vm:MediaTemplateSelector
            x:Key="MediaTemplateSelector"
            ImageTemplate="{StaticResource ImageTemplate}"
            VideoTemplate="{StaticResource VideoTemplate}" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid" SizeChanged="OnRootGridSizeChanged">
        <FlipView
            Height="{x:Bind CarouselViewModel.CarouselHeight, Mode=OneWay}"
            HorizontalAlignment="Stretch"
            Background="#808080"
            CornerRadius="6"
            ItemTemplateSelector="{StaticResource MediaTemplateSelector}"
            ItemsSource="{x:Bind CarouselViewModel.Medias, Mode=OneWay}"
            SelectedIndex="{x:Bind CarouselViewModel.CarouselPosition, Mode=TwoWay}" />

        <!--  Position Badge  -->
        <Border
            Margin="12"
            Padding="6,4"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="#80808080"
            CornerRadius="16"
            Visibility="{x:Bind CarouselViewModel.CarouselSwipeEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock
                FontWeight="Bold"
                Foreground="White"
                Text="{x:Bind CarouselViewModel.CarouselPositionText, Mode=OneWay}" />
        </Border>
    </Grid>
</UserControl>