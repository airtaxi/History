<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="History.WindowsClient.Controls.WrappedMediaContentControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:History.WindowsClient.ViewModels.Media"
    mc:Ignorable="d">

    <Grid
        x:Name="RootGrid"
        PointerPressed="OnRootGridPointerPressed"
        SizeChanged="OnRootGridSizeChanged">
        <FlipView
            Height="{x:Bind CarouselViewModel.CarouselHeight, Mode=OneWay}"
            HorizontalAlignment="Stretch"
            Background="#808080"
            CornerRadius="6"
            ItemTemplateSelector="{StaticResource MediaTemplateSelector}"
            ItemsSource="{x:Bind CarouselViewModel.Medias, Mode=OneWay}"
            SelectedIndex="{x:Bind CarouselViewModel.CarouselPosition, Mode=TwoWay}" />

        <!--  Position Badge  -->
        <Border
            Margin="12"
            Padding="6,4"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="#80808080"
            CornerRadius="16"
            Visibility="{x:Bind CarouselViewModel.CarouselSwipeEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock
                FontWeight="Bold"
                Foreground="White"
                Text="{x:Bind CarouselViewModel.CarouselPositionText, Mode=OneWay}" />
        </Border>
    </Grid>
</UserControl>