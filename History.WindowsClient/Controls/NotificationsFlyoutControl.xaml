<?xml version="1.0" encoding="utf-8" ?>
<controls:BaseControl
    x:Class="History.WindowsClient.Controls.NotificationsFlyoutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:History.WindowsClient.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:History.WindowsClient.ViewModels.Notifications"
    Width="400"
    Loaded="OnControlLoaded"
    Unloaded="OnControlUnloaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="12,12,4,8">
            <TextBlock
                FontSize="20"
                FontWeight="Bold"
                Text="알림" />
            <Button
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.ReadAllCommand}"
                ToolTipService.ToolTip="모두 읽음">
                <FontIcon FontSize="16" Glyph="&#xE930;" />
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer MaxHeight="580" VerticalScrollBarVisibility="Hidden">
                <ItemsRepeater
                    x:Name="MainItemsRepeater"
                    ElementPrepared="OnMainItemsRepeaterElementPrepared"
                    ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:NotificationViewModel">
                            <Grid>
                                <Button
                                    Padding="12,8,12,8"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{x:Bind HandleTapCommand}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0">
                                            <PersonPicture
                                                Width="40"
                                                Height="40"
                                                ProfilePicture="{x:Bind ProfileImageSource, Mode=OneWay}" />
                                        </Grid>

                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Spacing="2">
                                            <TextBlock
                                                FontWeight="Bold"
                                                MaxLines="1"
                                                Text="{x:Bind Title, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                MaxLines="1"
                                                Text="{x:Bind Body, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{x:Bind IsBodyVisible, Mode=OneWay}" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                MaxLines="1"
                                                Text="{x:Bind TimestampText, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Image
                                            Grid.Column="2"
                                            Width="40"
                                            Height="40"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Source="{x:Bind ImageSource, Mode=OneWay}"
                                            Stretch="UniformToFill"
                                            Visibility="{x:Bind IsImageVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />

                                        <Grid
                                            Grid.Column="3"
                                            Width="12"
                                            Margin="8,0,0,0"
                                            Visibility="{x:Bind IsUnread, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                            <Ellipse
                                                Width="8"
                                                Height="8"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </Grid>
                                    </Grid>
                                </Button>
                                <Rectangle
                                    Height="1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Bottom"
                                    Fill="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="알림이 없습니다"
                Visibility="{x:Bind ViewModel.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />

            <dev:LoadingIndicator
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource SystemAccentColor}"
                Mode="Arcs"
                Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
        </Grid>
    </Grid>
</controls:BaseControl>
