<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="History.WindowsClient.Controls.TextContentControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:History.WindowsClient.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:History.WindowsClient.ViewModels"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="UserMentionTemplate" x:DataType="vm:MentionUserViewModel">
            <Grid Padding="8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <PersonPicture
                    Grid.Column="0"
                    Width="32"
                    Height="32"
                    ProfilePicture="{x:Bind ProfileThumbnailImageSource}" />
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        MaxLines="1"
                        Text="{x:Bind Nickname, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#1a5bf3"
                        Glyph="&#xF760;"
                        Visibility="{x:Bind IsModerator, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#f78501"
                        Glyph="&#xF760;"
                        Visibility="{x:Bind IsAdmin, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="HashtagTemplate" x:DataType="x:String">
            <TextBlock Padding="8,4" Text="{x:Bind}" />
        </DataTemplate>
        <vm:SuggestionTemplateSelector
            x:Key="SuggestionTemplateSelector"
            HashtagTemplate="{StaticResource HashtagTemplate}"
            UserMentionTemplate="{StaticResource UserMentionTemplate}" />
    </UserControl.Resources>

    <controls:RichSuggestBox
        x:Name="MainRichSuggestBox"
        HorizontalAlignment="Stretch"
        ItemTemplateSelector="{StaticResource SuggestionTemplateSelector}"
        Paste="OnMainRichSuggestBoxPaste"
        PlaceholderText="{x:Bind PlaceholderText, Mode=OneWay}"
        Prefixes="@#"
        SuggestionChosen="OnMainRichSuggestBoxSuggestionChosen"
        SuggestionRequested="OnMainRichSuggestBoxSuggestionRequested" />
</UserControl>