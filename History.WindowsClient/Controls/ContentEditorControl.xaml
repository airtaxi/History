<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="History.WindowsClient.Controls.ContentEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:History.WindowsClient.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:History.WindowsClient.ViewModels"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="HashtagTemplate" x:DataType="x:String">
            <TextBlock Padding="8,4" Text="{x:Bind}" />
        </DataTemplate>
        <vm:SuggestionTemplateSelector
            x:Key="SuggestionTemplateSelector"
            FriendshipTemplate="{StaticResource FriendshipTemplate}"
            HashtagTemplate="{StaticResource HashtagTemplate}" />
    </UserControl.Resources>

    <controls:RichSuggestBox2
        x:Name="MainRichSuggestBox"
        HorizontalAlignment="Stretch"
        ItemTemplateSelector="{StaticResource SuggestionTemplateSelector}"
        Paste="OnMainRichSuggestBoxPaste"
        PlaceholderText="{x:Bind PlaceholderText, Mode=OneWay}"
        Prefixes="@#"
        SuggestionChosen="OnMainRichSuggestBoxSuggestionChosen"
        SuggestionRequested="OnMainRichSuggestBoxSuggestionRequested" />
</UserControl>