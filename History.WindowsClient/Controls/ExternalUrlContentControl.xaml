<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="History.WindowsClient.Controls.ExternalUrlContentControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    PointerPressed="OnPointerPressed"
    mc:Ignorable="d">

    <Button
        Height="250"
        Padding="0"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        Background="Transparent"
        BorderThickness="0"
        Command="{x:Bind ViewModel.OpenLinkCommand}">
        <Button.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Command="{x:Bind ViewModel.OpenLinkCommand}" Text="링크 열기">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE71B;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Command="{x:Bind ViewModel.CopyLinkCommand}" Text="링크 복사">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8C8;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Button.ContextFlyout>

        <Grid>
            <Rectangle Fill="#808080" Opacity="0.4" />

            <Image Source="{x:Bind ViewModel.ThumbnailImageSource, Mode=OneWay}" Stretch="UniformToFill" />

            <Rectangle Fill="#000000" Opacity="0.5" />

            <!--  Text  -->
            <StackPanel Padding="12" VerticalAlignment="Bottom">
                <TextBlock
                    FontSize="12"
                    Foreground="#CCCCCC"
                    Text="{x:Bind ViewModel.Domain, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="16"
                    Foreground="White"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="14"
                    Foreground="#CCCCCC"
                    Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </Button>
</UserControl>