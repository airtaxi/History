<?xml version="1.0" encoding="utf-8" ?>
<views:BaseWindow
    x:Class="History.WindowsClient.Views.StickerDetailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:History.WindowsClient.Views"
    xmlns:vm="using:History.WindowsClient.ViewModels.Sticker"
    Title="스티커"
    Width="560"
    Height="680"
    Closed="OnWindowClosed"
    IsMaximizable="False"
    IsResizable="False"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid KeyboardAcceleratorPlacementMode="Hidden" Loaded="OnWindowLoaded">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnCloseKeyInvoked" />
            <KeyboardAccelerator
                Key="W"
                Invoked="OnCloseKeyInvoked"
                Modifiers="Control" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TitleBar
                x:Name="AppTitleBar"
                Title="스티커"
                IsPaneToggleButtonVisible="False">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="ms-appx:///Assets/Icon.ico" />
                </TitleBar.IconSource>
            </TitleBar>
            <StackPanel
                Margin="0,0,138,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="4">
                <!--  Sticker deletion (the viewer's own sticker only)  -->
                <Button
                    Padding="16,0"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="스티커 삭제"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.DeleteCommand}"
                    CornerRadius="0"
                    ToolTipService.ToolTip="스티커 삭제"
                    Visibility="{x:Bind ViewModel.DeleteButtonVisibility, Mode=OneWay}">
                    <FontIcon FontSize="16" Glyph="&#xE74D;" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="DetailScrollViewer" Grid.Row="1">
            <StackPanel
                Padding="16,0,16,16"
                HorizontalAlignment="Stretch"
                Spacing="12">
                <!--  Sticker information card  -->
                <Border
                    Margin="0,8,0,4"
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="96"
                            Height="96"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="12">
                            <Image Source="{x:Bind ViewModel.IconSource, Mode=OneWay}" Stretch="Uniform" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="4">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    MaxLines="1"
                                    Style="{ThemeResource TitleTextBlockStyle}"
                                    Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />

                                <Border
                                    Grid.Column="1"
                                    Padding="8,3"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="12"
                                    Visibility="{x:Bind ViewModel.PrivateBadgeVisibility, Mode=OneWay}">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="비공개" />
                                </Border>
                            </Grid>

                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tags, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="6" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border
                                            Padding="8,3"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="12">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                MaxLines="1"
                                                Text="{x:Bind}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.AuthorName, Mode=OneWay}" />

                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="등록일" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.CreatedAtText, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Subscribe toggle (other users' public stickers only)  -->
                <Button
                    Height="40"
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.ToggleSubscribeCommand}"
                    Content="{x:Bind ViewModel.SubscribeButtonText, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind ViewModel.SubscribeButtonVisibility, Mode=OneWay}" />

                <!--  Description  -->
                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.DescriptionVisibility, Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="설명" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  Assets  -->
                <StackPanel Spacing="8">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="스티커 에셋" />

                    <ItemsRepeater HorizontalAlignment="Center" ItemsSource="{x:Bind ViewModel.Assets, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                MinColumnSpacing="8"
                                MinItemHeight="90"
                                MinItemWidth="90"
                                MinRowSpacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:StickerAssetItemViewModel">
                                <Button
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    AutomationProperties.Name="스티커 에셋"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderThickness="0"
                                    Command="{x:Bind HandleTapCommand}"
                                    CornerRadius="8"
                                    ToolTipService.ToolTip="크게 보기">
                                    <Image Source="{x:Bind ImageSource}" Stretch="Uniform" />
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="표시할 스티커가 없습니다"
                        Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--  Asset preview overlay: tap anywhere or use the corner button to close it  -->
        <Grid Grid.RowSpan="2" Visibility="{x:Bind ViewModel.AssetPreviewVisibility, Mode=OneWay}">
            <Rectangle Fill="Black" Opacity="0.6" />

            <Button
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                AutomationProperties.Name="미리보기 닫기"
                Background="Transparent"
                BorderThickness="0"
                Command="{x:Bind ViewModel.CloseAssetPreviewCommand}"
                ToolTipService.ToolTip="닫기" />

            <Image
                Margin="48"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False"
                Source="{x:Bind ViewModel.PreviewAssetImageSource, Mode=OneWay}"
                Stretch="Uniform" />

            <Button
                Width="32"
                Height="32"
                Margin="8"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                AutomationProperties.Name="미리보기 닫기"
                Command="{x:Bind ViewModel.CloseAssetPreviewCommand}"
                CornerRadius="16"
                ToolTipService.ToolTip="닫기">
                <FontIcon FontSize="12" Glyph="&#xE8BB;" />
            </Button>
        </Grid>

        <Grid
            x:Name="LoadingGrid"
            Grid.Row="1"
            Visibility="Collapsed">

            <Rectangle Fill="{ThemeResource ThemeColor}" Opacity="0.3" />

            <dev:BlurEffectControl
                BlurAmount="10"
                IsBlurEnabled="True"
                IsTintEnabled="False" />

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <dev:LoadingIndicator Foreground="{ThemeResource SystemAccentColor}" Mode="Arcs" />
                <TextBlock
                    x:Name="LoadingTextBlock"
                    HorizontalAlignment="Center"
                    FontWeight="Bold"
                    HorizontalTextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</views:BaseWindow>
