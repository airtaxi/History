<?xml version="1.0" encoding="utf-8" ?>
<views:BaseWindow
    x:Class="History.WindowsClient.Views.EditCommentWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:History.WindowsClient.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:History.WindowsClient.Views"
    Title="댓글 수정"
    Width="520"
    Closed="OnWindowClosed"
    IsMaximizable="False"
    IsResizable="False"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        KeyboardAcceleratorPlacementMode="Hidden"
        Loaded="OnWindowLoaded">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeKeyInvoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TitleBar
                x:Name="AppTitleBar"
                Title="댓글 수정"
                IsPaneToggleButtonVisible="False">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="ms-appx:///Assets/Icon.ico" />
                </TitleBar.IconSource>
            </TitleBar>
        </Grid>

        <Grid Grid.Row="1" Padding="16,12,16,16">
            <StackPanel Spacing="12">
                <controls:ContentEditorControl
                    x:Name="CommentEditor"
                    Height="300"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    AllowHashtag="False"
                    ImageInputRequested="OnCommentEditorImageInputRequested"
                    PlaceholderText="댓글을 달아보세요."
                    SubmitRequested="OnCommentEditorSubmitRequested" />

                <Button
                    Width="100"
                    Height="100"
                    Padding="0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.CommentBox.ClearAttachmentCommand, Mode=OneWay}"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.CommentBox.AttachmentVisibility, Mode=OneWay}">
                    <Grid>
                        <Image
                            Width="100"
                            Height="100"
                            Source="{x:Bind ViewModel.CommentBox.AttachmentImageSource, Mode=OneWay}"
                            Stretch="UniformToFill" />
                        <Rectangle
                            Width="100"
                            Height="100"
                            Fill="Black"
                            Opacity="0.5" />
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="32"
                            Foreground="White"
                            Glyph="&#xE8BB;" />
                    </Grid>
                </Button>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Width="32"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.CommentBox.HandleStickerTapCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="스티커">
                        <FontIcon
                            FontSize="18"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE76E;" />
                    </Button>

                    <Button
                        Width="32"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.CommentBox.HandleMediaTapCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="이미지 추가">
                        <FontIcon
                            FontSize="18"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE91B;" />
                    </Button>
                </StackPanel>

                <Button
                    Height="40"
                    HorizontalAlignment="Stretch"
                    Click="OnSaveButtonClicked"
                    Content="댓글 수정"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid
            x:Name="LoadingGrid"
            Grid.Row="1"
            Visibility="Collapsed">

            <Rectangle Fill="{ThemeResource ThemeColor}" Opacity="0.3" />

            <dev:BlurEffectControl
                BlurAmount="10"
                IsBlurEnabled="True"
                IsTintEnabled="False" />

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <dev:LoadingIndicator Foreground="{ThemeResource SystemAccentColor}" Mode="Arcs" />
                <TextBlock
                    x:Name="LoadingTextBlock"
                    HorizontalAlignment="Center"
                    FontWeight="Bold"
                    HorizontalTextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</views:BaseWindow>
