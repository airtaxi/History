<?xml version="1.0" encoding="utf-8" ?>
<views:BaseWindow
    x:Class="History.WindowsClient.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:History.WindowsClient.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:local="using:History.WindowsClient"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:History.WindowsClient.Views"
    Title="History.WindowsClient"
    Width="1400"
    Height="800"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="히스토리"
            BackRequested="OnAppTitleBarBackRequested"
            PaneToggleRequested="OnAppTitleBarPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Icon.ico" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        x:Name="NotificationsButton"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <FontIcon FontSize="16" Glyph="&#xEA8F;" />
                        <Button.Flyout>
                            <Flyout
                                x:Name="NotificationsFlyout"
                                Opening="OnNotificationsFlyoutOpening"
                                Placement="BottomEdgeAlignedRight">
                                <controls:NotificationsFlyoutControl />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        x:Name="RefreshButton"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Click="OnRefreshButtonClicked"
                        Visibility="Collapsed">
                        <FontIcon FontSize="16" Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="MainSearchBox"
                    Width="400"
                    PlaceholderText="게시글 또는 댓글 검색 (공란 시 타임라인으로)"
                    QueryIcon="Find"
                    QuerySubmitted="OnMainSearchBoxQuerySubmitted"
                    Visibility="Collapsed" />
            </TitleBar.Content>
        </TitleBar>

        <Frame
            x:Name="AppFrame"
            Grid.Row="1"
            Navigated="OnAppFrameNavigated" />

        <Grid
            x:Name="LoadingGrid"
            Grid.Row="1"
            Visibility="Collapsed">

            <Rectangle Fill="{ThemeResource ThemeColor}" Opacity="0.3" />

            <dev:BlurEffectControl
                BlurAmount="10"
                IsBlurEnabled="True"
                IsTintEnabled="False" />

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <dev:LoadingIndicator Foreground="{ThemeResource SystemAccentColor}" Mode="Arcs" />
                <TextBlock
                    x:Name="LoadingTextBlock"
                    HorizontalAlignment="Center"
                    FontWeight="Bold"
                    HorizontalTextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</views:BaseWindow>
