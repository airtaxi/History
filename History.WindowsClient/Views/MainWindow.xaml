<?xml version="1.0" encoding="utf-8" ?>
<views:BaseWindow
    x:Class="History.WindowsClient.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:History.WindowsClient.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:local="using:History.WindowsClient"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:History.WindowsClient.Views"
    Title="History.WindowsClient"
    Width="1400"
    Height="800"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            BackRequested="OnAppTitleBarBackRequested"
            PaneToggleRequested="OnAppTitleBarPaneToggleRequested">
            <TitleBar.LeftHeader>
                <Button
                    Margin="8,0,0,0"
                    BorderThickness="0"
                    Click="OnLeftHeaderButtonClicked">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image
                            Width="16"
                            Height="16"
                            Source="ms-appx:///Assets/Icon.ico" />
                        <TextBlock VerticalAlignment="Center" Text="히스토리" />
                    </StackPanel>
                </Button>
            </TitleBar.LeftHeader>
            <TitleBar.RightHeader>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        x:Name="ComposePostButton"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Click="OnComposePostButtonClicked"
                        Visibility="Collapsed">
                        <FontIcon FontSize="16" Glyph="&#xE932;" />
                    </Button>
                    <Grid>
                        <Button
                            x:Name="NotificationsButton"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                            <FontIcon FontSize="16" Glyph="&#xEA8F;" />
                            <Button.Flyout>
                                <Flyout
                                    x:Name="NotificationsFlyout"
                                    Opening="OnNotificationsFlyoutOpening"
                                    Placement="BottomEdgeAlignedRight">
                                    <controls:NotificationsFlyoutControl />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <InfoBadge
                            x:Name="NotificationsInfoBadge"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource AttentionValueInfoBadgeStyle}"
                            Visibility="Collapsed"
                            Value="0">
                            <InfoBadge.RenderTransform>
                                <TranslateTransform X="14" Y="-10" />
                            </InfoBadge.RenderTransform>
                        </InfoBadge>
                    </Grid>
                    <ToggleButton
                        x:Name="DiscoverButton"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Click="OnDiscoverButtonClicked"
                        ToolTipService.ToolTip="발견"
                        Visibility="Collapsed">
                        <FontIcon FontSize="16" Glyph="&#xF6FA;" />
                    </ToggleButton>
                    <Button
                        x:Name="RefreshButton"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Click="OnRefreshButtonClicked"
                        Visibility="Collapsed">
                        <FontIcon FontSize="16" Glyph="&#xE72C;" />
                    </Button>
                    <Button
                        x:Name="MoreButton"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <FontIcon FontSize="16" Glyph="&#xE712;" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="부가메뉴">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEC7A;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="설정">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE713;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="MainSearchBox"
                    Width="400"
                    PlaceholderText="게시글 또는 댓글 검색 (공란 시 타임라인으로)"
                    QueryIcon="Find"
                    QuerySubmitted="OnMainSearchBoxQuerySubmitted"
                    Visibility="Collapsed" />
            </TitleBar.Content>
        </TitleBar>

        <Frame
            x:Name="AppFrame"
            Grid.Row="1"
            Navigated="OnAppFrameNavigated" />

        <Grid
            x:Name="LoadingGrid"
            Grid.Row="1"
            Visibility="Collapsed">

            <Rectangle Fill="{ThemeResource ThemeColor}" Opacity="0.3" />

            <dev:BlurEffectControl
                BlurAmount="10"
                IsBlurEnabled="True"
                IsTintEnabled="False" />

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <dev:LoadingIndicator Foreground="{ThemeResource SystemAccentColor}" Mode="Arcs" />
                <TextBlock
                    x:Name="LoadingTextBlock"
                    HorizontalAlignment="Center"
                    FontWeight="Bold"
                    HorizontalTextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</views:BaseWindow>
