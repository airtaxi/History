<?xml version="1.0" encoding="utf-8" ?>
<views:BaseWindow
    x:Class="History.WindowsClient.Views.PollEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:History.WindowsClient.Views"
    xmlns:vm="using:History.WindowsClient.ViewModels"
    Title="투표 생성"
    Width="{x:Bind WindowWidth}"
    Closed="OnWindowClosed"
    IsMaximizable="False"
    IsResizable="False"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        KeyboardAcceleratorPlacementMode="Hidden"
        Loaded="OnWindowLoaded">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeKeyInvoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TitleBar
                x:Name="AppTitleBar"
                Title="투표 생성"
                IsPaneToggleButtonVisible="False">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="ms-appx:///Assets/Icon.ico" />
                </TitleBar.IconSource>
            </TitleBar>
        </Grid>

        <Grid Grid.Row="1" Padding="16,4,16,16">
            <StackPanel Spacing="12">
                <TextBlock
                    FontSize="{StaticResource CaptionTextBlockFontSize}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="투표를 진행하는데 필요한 정보들을 입력해주세요." />

                <!--  Poll title  -->
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="투표 제목 *" />
                    <TextBox
                        MaxLength="200"
                        PlaceholderText="투표 제목을 입력하세요"
                        Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!--  Poll options: rows with a delete button, capped at five visible rows  -->
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="투표 선택지 *" />
                    <TextBlock
                        FontSize="{StaticResource CaptionTextBlockFontSize}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="투표 선택지는 최소 2개 이상이어야 합니다." />
                    <ListView
                        MaxHeight="220"
                        ItemsSource="{x:Bind ViewModel.Options, Mode=OneWay}"
                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                        SelectionMode="None">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PollEditOptionItemViewModel">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Grid.Column="0"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        BorderThickness="1"
                                        Command="{x:Bind DeleteCommand}"
                                        CornerRadius="8"
                                        ToolTipService.ToolTip="선택지 삭제">
                                        <FontIcon
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE711;" />
                                    </Button>
                                    <TextBox
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        PlaceholderText="{x:Bind PlaceholderText, Mode=OneWay}"
                                        Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.AddOptionCommand, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE710;" />
                            <TextBlock Text="옵션 추가" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  Bottom settings: multiple selection and the togglable expiration pickers  -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="복수 선택 허용" />
                        <ToggleSwitch MinWidth="0" IsOn="{x:Bind ViewModel.AllowMultipleSelection, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="투표 종료 날짜" />
                                <TextBlock
                                    FontSize="{StaticResource CaptionTextBlockFontSize}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="선택사항" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                MinWidth="0"
                                VerticalAlignment="Center"
                                IsOn="{x:Bind ViewModel.IsExpirationEnabled, Mode=TwoWay}" />
                        </Grid>
                        <DatePicker
                            HorizontalAlignment="Stretch"
                            IsEnabled="{x:Bind ViewModel.IsExpirationEnabled, Mode=OneWay}"
                            SelectedDate="{x:Bind ViewModel.ExpirationDate, Mode=TwoWay}" />
                        <TimePicker
                            HorizontalAlignment="Stretch"
                            IsEnabled="{x:Bind ViewModel.IsExpirationEnabled, Mode=OneWay}"
                            SelectedTime="{x:Bind ViewModel.ExpirationTime, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>

                <Button
                    Height="40"
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.ConfirmCommand, Mode=OneWay}"
                    Content="확인"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid
            x:Name="LoadingGrid"
            Grid.Row="1"
            Visibility="Collapsed">

            <Rectangle Fill="{ThemeResource ThemeColor}" Opacity="0.3" />

            <dev:BlurEffectControl
                BlurAmount="10"
                IsBlurEnabled="True"
                IsTintEnabled="False" />

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <dev:LoadingIndicator Foreground="{ThemeResource SystemAccentColor}" Mode="Arcs" />
                <TextBlock
                    x:Name="LoadingTextBlock"
                    HorizontalAlignment="Center"
                    FontWeight="Bold"
                    HorizontalTextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</views:BaseWindow>
