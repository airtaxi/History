<?xml version="1.0" encoding="utf-8" ?>
<views:BaseWindow
    x:Class="History.WindowsClient.Views.ComposePostWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:History.WindowsClient.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:History.WindowsClient.Views"
    xmlns:vm="using:History.WindowsClient.ViewModels"
    Title="게시글 작성"
    Width="{x:Bind WindowWidth}"
    Closed="OnWindowClosed"
    IsMaximizable="False"
    IsResizable="False"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        KeyboardAcceleratorPlacementMode="Hidden"
        Loaded="OnWindowLoaded">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeKeyInvoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TitleBar
                x:Name="AppTitleBar"
                Title="게시글 작성"
                IsPaneToggleButtonVisible="False">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="ms-appx:///Assets/Icon.ico" />
                </TitleBar.IconSource>
            </TitleBar>
        </Grid>

        <Grid Grid.Row="1" Padding="16,12,16,16">
            <StackPanel Spacing="12">
                <TextBlock
                    x:Name="CaptionTextBlock"
                    FontSize="{StaticResource CaptionTextBlockFontSize}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="모두와 나누고 싶은 이야기를 적어보세요." />

                <controls:ContentEditorControl
                    x:Name="PostEditor"
                    Height="250"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    AllowHashtag="True"
                    ImageInputRequested="OnPostEditorImageInputRequested"
                    PlaceholderText="무슨 일이 있었나요?"
                    SubmitRequested="OnPostEditorSubmitRequested" />

                <!--  Media attachments: horizontal strip with drag-reorder (the collection updates automatically)  -->
                <ListView
                    Height="132"
                    AllowDrop="True"
                    CanDragItems="True"
                    CanReorderItems="True"
                    ItemsSource="{x:Bind ViewModel.MediaAttachments, Mode=OneWay}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    SelectionMode="None"
                    Visibility="{x:Bind ViewModel.MediaAttachmentsVisibility, Mode=OneWay}">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MediaAttachmentViewModel">
                            <Border
                                Width="112"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="96" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Image Source="{x:Bind ThumbnailImageSource, Mode=OneWay}" Stretch="UniformToFill" />
                                        <Rectangle
                                            Fill="Black"
                                            Opacity="0.5"
                                            Visibility="{x:Bind IsSpoiler, Mode=OneWay}" />
                                        <FontIcon
                                            FontSize="28"
                                            Foreground="White"
                                            Glyph="&#xED1A;"
                                            Visibility="{x:Bind IsSpoiler, Mode=OneWay}" />

                                        <Button
                                            Width="24"
                                            Height="24"
                                            Margin="4"
                                            Padding="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Background="#66000000"
                                            BorderThickness="0"
                                            Command="{x:Bind ToggleSpoilerCommand}"
                                            CornerRadius="12"
                                            ToolTipService.ToolTip="{x:Bind SpoilerToolTip, Mode=OneWay}">
                                            <FontIcon
                                                FontSize="12"
                                                Foreground="White"
                                                Glyph="{x:Bind SpoilerGlyph, Mode=OneWay}" />
                                        </Button>

                                        <Button
                                            Width="24"
                                            Height="24"
                                            Margin="4"
                                            Padding="0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="#66000000"
                                            BorderThickness="0"
                                            Command="{x:Bind DeleteCommand}"
                                            CornerRadius="12"
                                            ToolTipService.ToolTip="삭제">
                                            <FontIcon
                                                FontSize="12"
                                                Foreground="White"
                                                Glyph="&#xE8BB;" />
                                        </Button>
                                    </Grid>

                                    <Button
                                        Grid.Row="1"
                                        Padding="8,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{x:Bind EditDescriptionCommand}"
                                        ToolTipService.ToolTip="설명 입력">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind DisplayDescription, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!--  External URL preview: filled card with a close button (the visibility updates automatically)  -->
                <Border
                    Height="136"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.ExternalUrlContentVisibility, Mode=OneWay}">
                    <Grid>
                        <Rectangle Fill="#808080" Opacity="0.4" />
                        <Image Source="{x:Bind ViewModel.ExternalUrlPreview.ThumbnailImageSource, Mode=OneWay}" Stretch="UniformToFill" />
                        <Rectangle Fill="#000000" Opacity="0.5" />
                        <StackPanel Padding="12" VerticalAlignment="Bottom">
                            <TextBlock
                                FontSize="12"
                                Foreground="#CCCCCC"
                                Text="{x:Bind ViewModel.ExternalUrlPreview.Domain, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="16"
                                Foreground="White"
                                Text="{x:Bind ViewModel.ExternalUrlPreview.Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="14"
                                Foreground="#CCCCCC"
                                Text="{x:Bind ViewModel.ExternalUrlPreview.Description, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button
                            Width="28"
                            Height="28"
                            Margin="6"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#66000000"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.RemoveExternalUrlContentCommand}"
                            CornerRadius="14"
                            ToolTipService.ToolTip="링크 첨부 삭제">
                            <FontIcon
                                FontSize="12"
                                Foreground="White"
                                Glyph="&#xE8BB;" />
                        </Button>
                    </Grid>
                </Border>

                <!--  Poll attachment: summary card with a close button (the visibility updates automatically)  -->
                <Border
                    Padding="12"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.PollContentVisibility, Mode=OneWay}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.PollContent.Question, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.PollSummaryText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Width="28"
                            Height="28"
                            Padding="0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.RemovePollCommand, Mode=OneWay}"
                            CornerRadius="14"
                            ToolTipService.ToolTip="투표 삭제">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE8BB;" />
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <!--  Discovery range: WinUI-style ComboBox showing glyph + text  -->
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.DiscoveryOptionItems, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.SelectedDiscoveryIndex, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ComposePostDiscoveryOptionItemViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Glyph="{x:Bind Glyph}" />
                                    <TextBlock VerticalAlignment="Center" Text="{x:Bind DisplayText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!--  Post reservation: the toggle arms the date/time pickers; both must hold a value  -->
                    <Button x:Name="ReservationButton" ToolTipService.ToolTip="{x:Bind ViewModel.ReservationToolTip, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="16"
                                Glyph="&#xE787;" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.ReservationButtonContent, Mode=OneWay}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Text="게시 예약" />
                                        <ToggleSwitch
                                            Grid.Column="1"
                                            MinWidth="0"
                                            IsOn="{x:Bind ViewModel.IsReservationEnabled, Mode=TwoWay}" />
                                    </Grid>
                                    <DatePicker
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="{x:Bind ViewModel.IsReservationEnabled, Mode=OneWay}"
                                        SelectedDate="{x:Bind ViewModel.ReservationDate, Mode=TwoWay}" />
                                    <TimePicker
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="{x:Bind ViewModel.IsReservationEnabled, Mode=OneWay}"
                                        SelectedTime="{x:Bind ViewModel.ReservationTime, Mode=TwoWay}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <!--  Media attachment  -->
                    <Button
                        Width="36"
                        Height="36"
                        Padding="0"
                        BorderThickness="1"
                        Command="{x:Bind ViewModel.HandleMediaTapCommand, Mode=OneWay}"
                        CornerRadius="8"
                        ToolTipService.ToolTip="사진/영상">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE91B;" />
                    </Button>

                    <!--  Sticker  -->
                    <Button
                        Width="36"
                        Height="36"
                        Padding="0"
                        BorderThickness="1"
                        Command="{x:Bind ViewModel.HandleStickerTapCommand, Mode=OneWay}"
                        CornerRadius="8"
                        ToolTipService.ToolTip="스티커">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xF4AA;" />
                    </Button>

                    <!--  URL attach  -->
                    <Button
                        Width="36"
                        Height="36"
                        Padding="0"
                        BorderThickness="1"
                        Command="{x:Bind ViewModel.HandleUrlTapCommand, Mode=OneWay}"
                        CornerRadius="8"
                        ToolTipService.ToolTip="URL 첨부">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE71B;" />
                    </Button>

                    <!--  Poll  -->
                    <Button
                        Width="36"
                        Height="36"
                        Padding="0"
                        BorderThickness="1"
                        Command="{x:Bind ViewModel.HandlePollTapCommand, Mode=OneWay}"
                        CornerRadius="8"
                        ToolTipService.ToolTip="{x:Bind ViewModel.PollToolTip, Mode=OneWay}">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xEA98;" />
                    </Button>

                    <!--  Kakao cross-post toggle: the command reverts the toggle and shows the stub hint  -->
                    <ToggleButton
                        Height="36"
                        Padding="12,0"
                        Command="{x:Bind ViewModel.HandleKakaoPostTapCommand, Mode=OneWay}"
                        Content="카카오 게시"
                        IsChecked="{x:Bind ViewModel.IsKakaoPostEnabled, Mode=TwoWay}"
                        ToolTipService.ToolTip="카카오 게시" />

                    <!--  More options: share/repost block and comment permission  -->
                    <Button
                        Width="36"
                        Height="36"
                        Padding="0"
                        BorderThickness="1"
                        CornerRadius="8"
                        ToolTipService.ToolTip="추가 옵션">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE712;" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="260" Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Text="공유 및 리포스트 금지" />
                                        <ToggleSwitch
                                            Grid.Column="1"
                                            MinWidth="0"
                                            IsOn="{x:Bind ViewModel.IsShareRepostDisallowed, Mode=TwoWay}" />
                                    </Grid>

                                    <MenuFlyoutSeparator />

                                    <TextBlock FontWeight="SemiBold" Text="댓글 작성 권한" />
                                    <SplitButton HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Glyph="{x:Bind ViewModel.SelectedCommentPermissionGlyph, Mode=OneWay}" />
                                            <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.SelectedCommentPermissionDisplayText, Mode=OneWay}" />
                                        </StackPanel>
                                        <SplitButton.Flyout>
                                            <MenuFlyout x:Name="CommentPermissionMenuFlyout" Opening="OnCommentPermissionMenuFlyoutOpening" />
                                        </SplitButton.Flyout>
                                    </SplitButton>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <Button
                    x:Name="SubmitButton"
                    Height="40"
                    HorizontalAlignment="Stretch"
                    Click="OnSubmitButtonClicked"
                    Content="게시하기"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid
            x:Name="LoadingGrid"
            Grid.Row="1"
            Visibility="Collapsed">

            <Rectangle Fill="{ThemeResource ThemeColor}" Opacity="0.3" />

            <dev:BlurEffectControl
                BlurAmount="10"
                IsBlurEnabled="True"
                IsTintEnabled="False" />

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <dev:LoadingIndicator Foreground="{ThemeResource SystemAccentColor}" Mode="Arcs" />
                <TextBlock
                    x:Name="LoadingTextBlock"
                    HorizontalAlignment="Center"
                    FontWeight="Bold"
                    HorizontalTextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</views:BaseWindow>
