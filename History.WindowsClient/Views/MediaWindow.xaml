<?xml version="1.0" encoding="utf-8" ?>
<views:BaseWindow
    x:Class="History.WindowsClient.Views.MediaWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:History.WindowsClient.Views"
    Title="미디어"
    Width="1100"
    Height="750"
    Closed="OnWindowClosed"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeKeyInvoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TitleBar
                x:Name="AppTitleBar"
                Title="미디어"
                IsPaneToggleButtonVisible="False">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="ms-appx:///Assets/Icon.ico" />
                </TitleBar.IconSource>
            </TitleBar>
            <StackPanel
                Margin="0,0,138,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    Padding="16,0"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.DownloadAllCommand}"
                    CornerRadius="0"
                    ToolTipService.ToolTip="전체 다운로드">
                    <FontIcon FontSize="16" Glyph="&#xE8B6;" />
                </Button>
                <Button
                    Padding="16,0"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.DownloadCommand}"
                    CornerRadius="0"
                    ToolTipService.ToolTip="다운로드">
                    <FontIcon FontSize="16" Glyph="&#xE74E;" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Background="Black">
            <FlipView
                x:Name="MediaFlipView"
                Background="Black"
                ItemTemplateSelector="{StaticResource FullScreenMediaTemplateSelector}"
                ItemsSource="{x:Bind ViewModel.Medias, Mode=OneWay}"
                SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                SelectionChanged="OnMediaFlipViewSelectionChanged" />

            <!--  Zoom Controls and Position Badge  -->
            <StackPanel
                Margin="12"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="8">
                <Border
                    Padding="10,4"
                    VerticalAlignment="Center"
                    Background="#80808080"
                    CornerRadius="14"
                    Visibility="{x:Bind ViewModel.PositionBadgeVisiability, Mode=OneWay}">
                    <TextBlock
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" />
                </Border>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsZoomVisible, Mode=OneWay}">
                    <Button
                        Width="36"
                        Height="36"
                        Padding="0"
                        Background="#80808080"
                        BorderThickness="0"
                        Click="OnZoomOutClicked"
                        CornerRadius="4"
                        ToolTipService.ToolTip="축소">
                        <FontIcon
                            FontSize="14"
                            Foreground="White"
                            Glyph="&#xE71F;" />
                    </Button>
                    <Button
                        Width="36"
                        Height="36"
                        Padding="0"
                        Background="#80808080"
                        BorderThickness="0"
                        Click="OnZoomResetClicked"
                        CornerRadius="4"
                        ToolTipService.ToolTip="100%">
                        <FontIcon
                            FontSize="14"
                            Foreground="White"
                            Glyph="&#xE71E;" />
                    </Button>
                    <Button
                        Width="36"
                        Height="36"
                        Padding="0"
                        Background="#80808080"
                        BorderThickness="0"
                        Click="OnZoomInClicked"
                        CornerRadius="4"
                        ToolTipService.ToolTip="확대">
                        <FontIcon
                            FontSize="14"
                            Foreground="White"
                            Glyph="&#xE8A3;" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <Grid x:Name="LoadingGrid" Visibility="Collapsed">
                <Rectangle Fill="Black" Opacity="0.5" />
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">
                    <ProgressRing
                        Width="48"
                        Height="48"
                        IsActive="True" />
                    <TextBlock
                        x:Name="LoadingTextBlock"
                        HorizontalAlignment="Center"
                        FontWeight="Bold"
                        HorizontalTextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</views:BaseWindow>