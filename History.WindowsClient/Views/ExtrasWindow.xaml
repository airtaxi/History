<?xml version="1.0" encoding="utf-8" ?>
<views:BaseWindow
    x:Class="History.WindowsClient.Views.ExtrasWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:History.WindowsClient.Views"
    Title="부가메뉴"
    Width="760"
    Height="644"
    Closed="OnWindowClosed"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid KeyboardAcceleratorPlacementMode="Hidden" Loaded="OnWindowLoaded">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnCloseKeyInvoked" />
            <KeyboardAccelerator
                Key="W"
                Invoked="OnCloseKeyInvoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="R"
                Invoked="OnRefreshKeyInvoked"
                Modifiers="Control" />
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshKeyInvoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TitleBar
                x:Name="AppTitleBar"
                Title="부가메뉴"
                BackRequested="OnAppTitleBarBackRequested"
                IsPaneToggleButtonVisible="False">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="ms-appx:///Assets/Icon.ico" />
                </TitleBar.IconSource>
            </TitleBar>
            <StackPanel
                Margin="0,0,138,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    x:Name="AddButton"
                    Padding="16,0"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="초대 코드 요청"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnAddButtonClicked"
                    CornerRadius="0"
                    ToolTipService.ToolTip="초대 코드 요청"
                    Visibility="Collapsed">
                    <FontIcon FontSize="16" Glyph="&#xE710;" />
                </Button>
                <Button
                    x:Name="RefreshButton"
                    Padding="16,0"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnRefreshButtonClicked"
                    CornerRadius="0"
                    ToolTipService.ToolTip="새로 고침"
                    Visibility="Collapsed">
                    <FontIcon FontSize="16" Glyph="&#xE72C;" />
                </Button>
            </StackPanel>
        </Grid>

        <Frame
            x:Name="ExtrasFrame"
            Grid.Row="1"
            Navigated="OnExtrasFrameNavigated" />

        <Grid
            x:Name="LoadingGrid"
            Grid.Row="1"
            Visibility="Collapsed">

            <Rectangle Fill="{ThemeResource ThemeColor}" Opacity="0.3" />

            <dev:BlurEffectControl
                BlurAmount="10"
                IsBlurEnabled="True"
                IsTintEnabled="False" />

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <dev:LoadingIndicator Foreground="{ThemeResource SystemAccentColor}" Mode="Arcs" />
                <TextBlock
                    x:Name="LoadingTextBlock"
                    HorizontalAlignment="Center"
                    FontWeight="Bold"
                    HorizontalTextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</views:BaseWindow>
