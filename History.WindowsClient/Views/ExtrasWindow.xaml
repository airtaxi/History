<?xml version="1.0" encoding="utf-8" ?>
<views:BaseWindow
    x:Class="History.WindowsClient.Views.ExtrasWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:History.WindowsClient.Views"
    Title="부가메뉴"
    Width="760"
    Height="660"
    Closed="OnWindowClosed"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid KeyboardAcceleratorPlacementMode="Hidden" Loaded="OnWindowLoaded">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnCloseKeyInvoked" />
            <KeyboardAccelerator
                Key="W"
                Invoked="OnCloseKeyInvoked"
                Modifiers="Control" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="부가메뉴"
            BackRequested="OnAppTitleBarBackRequested"
            IsPaneToggleButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Icon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Frame
            x:Name="ExtrasFrame"
            Grid.Row="1"
            Navigated="OnExtrasFrameNavigated" />

        <Grid
            x:Name="LoadingGrid"
            Grid.Row="1"
            Visibility="Collapsed">

            <Rectangle Fill="{ThemeResource ThemeColor}" Opacity="0.3" />

            <dev:BlurEffectControl
                BlurAmount="10"
                IsBlurEnabled="True"
                IsTintEnabled="False" />

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <dev:LoadingIndicator Foreground="{ThemeResource SystemAccentColor}" Mode="Arcs" />
                <TextBlock
                    x:Name="LoadingTextBlock"
                    HorizontalAlignment="Center"
                    FontWeight="Bold"
                    HorizontalTextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</views:BaseWindow>
