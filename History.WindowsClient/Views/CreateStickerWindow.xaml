<?xml version="1.0" encoding="utf-8" ?>
<views:BaseWindow
    x:Class="History.WindowsClient.Views.CreateStickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:extras="using:History.WindowsClient.ViewModels.Extras"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:History.WindowsClient.Views"
    Title="스티커 만들기"
    Width="560"
    Height="840"
    Closed="OnWindowClosed"
    IsMaximizable="False"
    IsResizable="False"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid KeyboardAcceleratorPlacementMode="Hidden" Loaded="OnWindowLoaded">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnCloseKeyInvoked" />
            <KeyboardAccelerator
                Key="W"
                Invoked="OnCloseKeyInvoked"
                Modifiers="Control" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TitleBar
                x:Name="AppTitleBar"
                Title="스티커 만들기"
                IsPaneToggleButtonVisible="False">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="ms-appx:///Assets/Icon.ico" />
                </TitleBar.IconSource>
            </TitleBar>

            <StackPanel
                Margin="0,0,138,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    x:Name="ImportExternalButton"
                    Padding="16,0"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="외부 스티커 불러오기"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.ImportExternalCommand}"
                    CornerRadius="0"
                    ToolTipService.ToolTip="외부 스티커 불러오기">
                    <FontIcon FontSize="16" Glyph="&#xE8B5;" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="FormScrollViewer" Grid.Row="1">
            <StackPanel Padding="16,0,16,16" Spacing="16">
                <!--  Icon selection  -->
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="아이콘 *" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Width="100"
                            Height="100"
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            AutomationProperties.Name="아이콘 선택"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Command="{x:Bind ViewModel.PickIconCommand}"
                            CornerRadius="12"
                            ToolTipService.ToolTip="아이콘 선택">
                            <Grid>
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="32"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE8B9;"
                                    Visibility="{x:Bind ViewModel.IconPlaceholderVisibility, Mode=OneWay}" />
                                <Image
                                    Source="{x:Bind ViewModel.IconSource, Mode=OneWay}"
                                    Stretch="UniformToFill"
                                    Visibility="{x:Bind ViewModel.IconVisibility, Mode=OneWay}" />
                            </Grid>
                        </Button>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="4">
                            <TextBlock
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="스티커 목록에 표시될 대표 이미지입니다."
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="정적 이미지만 사용할 수 있습니다. (움짤 불가)"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!--  Name  -->
                <TextBox
                    Header="이름 *"
                    MaxLength="50"
                    PlaceholderText="스티커 이름"
                    Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!--  Category  -->
                <TextBox
                    Header="카테고리 *"
                    MaxLength="30"
                    PlaceholderText="예: 귀여운, 웃긴, 동물"
                    Text="{x:Bind ViewModel.Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!--  Description  -->
                <TextBox
                    Height="100"
                    AcceptsReturn="True"
                    Header="설명 (선택)"
                    MaxLength="200"
                    PlaceholderText="스티커에 대한 설명 (선택)"
                    Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <!--  Private toggle  -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock FontWeight="SemiBold" Text="비공개" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="비공개 스티커는 본인만 사용할 수 있습니다." />
                    </StackPanel>

                    <ToggleSwitch
                        Grid.Column="1"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        IsOn="{x:Bind ViewModel.IsPrivate, Mode=TwoWay}" />
                </Grid>

                <!--  Assets  -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="스티커 에셋 *" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.AssetCountText, Mode=OneWay}" />
                    </StackPanel>

                    <ItemsRepeater HorizontalAlignment="Center" ItemsSource="{x:Bind ViewModel.Assets, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                MinColumnSpacing="8"
                                MinItemHeight="90"
                                MinItemWidth="90"
                                MinRowSpacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="extras:CreateStickerAssetItemViewModel">
                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Border
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Image Source="{x:Bind ImageSource}" Stretch="Uniform" />
                                    </Border>

                                    <Button
                                        Width="24"
                                        Height="24"
                                        Margin="0,-8,-8,0"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        AutomationProperties.Name="에셋 삭제"
                                        Command="{x:Bind DeleteCommand}"
                                        CornerRadius="12"
                                        ToolTipService.ToolTip="삭제">
                                        <FontIcon FontSize="10" Glyph="&#xE711;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.AddAssetsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE710;" />
                            <TextBlock Text="이미지 추가" />
                        </StackPanel>
                    </Button>

                    <TextBlock
                        FontSize="{StaticResource CaptionTextBlockFontSize}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="최대 200개, 각 파일 10MB 이하, 정적 이미지 및 움짤(GIF/WebP) 가능&#10;이미지는 384x384 크기로 자동 조정되며, 움짤은 업로드에 시간이 오래 걸릴 수 있습니다."
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--  Create trigger: a single full-width button pinned below the form  -->
        <Button
            x:Name="CreateButton"
            Grid.Row="2"
            Height="48"
            HorizontalAlignment="Stretch"
            Command="{x:Bind ViewModel.CreateCommand}"
            Content="만들기"
            CornerRadius="0"
            FontSize="20"
            FontWeight="Bold"
            Style="{StaticResource AccentButtonStyle}" />

        <Grid
            x:Name="LoadingGrid"
            Grid.Row="1"
            Grid.RowSpan="2"
            Visibility="Collapsed">

            <Rectangle Fill="{ThemeResource ThemeColor}" Opacity="0.3" />

            <dev:BlurEffectControl
                BlurAmount="10"
                IsBlurEnabled="True"
                IsTintEnabled="False" />

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <dev:LoadingIndicator Foreground="{ThemeResource SystemAccentColor}" Mode="Arcs" />
                <TextBlock
                    x:Name="LoadingTextBlock"
                    HorizontalAlignment="Center"
                    FontWeight="Bold"
                    HorizontalTextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</views:BaseWindow>
