<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="History.WindowsClient.Dialogs.KakaoStoryRewriteDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:History.WindowsClient.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="욕설 감지"
    CloseButtonText="취소"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonText="수정"
    Style="{ThemeResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <Grid Width="400" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="WarningTextBlock"
            Grid.Row="0"
            TextWrapping="Wrap" />

        <controls:ContentEditorControl
            x:Name="RewriteEditor"
            Grid.Row="1"
            Height="300"
            VerticalAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Loaded="OnRewriteEditorLoaded"
            PlaceholderText="수정할 내용을 입력하세요" />

        <TextBlock
            x:Name="ValidationTextBlock"
            Grid.Row="2"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </Grid>
</ContentDialog>
