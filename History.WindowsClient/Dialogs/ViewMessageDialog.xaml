<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="History.WindowsClient.Dialogs.ViewMessageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:History.WindowsClient.ViewModels"
    Title="쪽지"
    CloseButtonText="닫기"
    DefaultButton="Close"
    PrimaryButtonText="{x:Bind ViewModel.ReplyButtonText, Mode=OneWay}"
    Style="{ThemeResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <Grid Width="420" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="14,10"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            CornerRadius="8">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="보낸 사람" />
                    <PersonPicture
                        Grid.Column="1"
                        Width="28"
                        Height="28"
                        VerticalAlignment="Center"
                        ProfilePicture="{x:Bind ViewModel.ProfileImageSource, Mode=OneWay}" />
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            Text="{x:Bind ViewModel.SenderName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#1a5bf3"
                            Glyph="&#xF760;"
                            Visibility="{x:Bind ViewModel.IsSenderModerator, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#f78501"
                            Glyph="&#xF760;"
                            Visibility="{x:Bind ViewModel.IsSenderAdmin, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="받는 사람" />
                    <PersonPicture
                        Grid.Column="1"
                        Width="28"
                        Height="28"
                        VerticalAlignment="Center"
                        ProfilePicture="{x:Bind ViewModel.ReceiverProfileImageSource, Mode=OneWay}" />
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            Text="{x:Bind ViewModel.ReceiverName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#1a5bf3"
                            Glyph="&#xF760;"
                            Visibility="{x:Bind ViewModel.IsReceiverModerator, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#f78501"
                            Glyph="&#xF760;"
                            Visibility="{x:Bind ViewModel.IsReceiverAdmin, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <TextBlock
                    Grid.Row="2"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind ViewModel.DetailedTimestampText, Mode=OneWay}" />
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            MinHeight="200"
            MaxHeight="380"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid CornerRadius="8">
                <Image
                    Source="{x:Bind ViewModel.ImageSource, Mode=OneWay}"
                    Stretch="UniformToFill"
                    Visibility="{x:Bind ViewModel.HasImage, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />

                <Rectangle
                    Fill="Black"
                    Opacity="0.5"
                    Visibility="{x:Bind ViewModel.HasImage, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />

                <ScrollViewer Padding="20,16">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{x:Bind ViewModel.MainTextForeground, Mode=OneWay}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.MainText, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
