<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="History.WindowsClient.Dialogs.DiscoveryOptionSelectUsersDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:History.WindowsClient.ViewModels.DiscoveryOptions"
    Title="친구 선택"
    CloseButtonText="취소"
    DefaultButton="Primary"
    PrimaryButtonText="선택"
    Style="{ThemeResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <Grid Width="440" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header info and preset button  -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="이 게시글을 (비)공개할 친구를 선택해보세요." />
                <TextBlock
                    FontSize="{StaticResource CaptionTextBlockFontSize}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="선택된 친구에게만 (비)공개되며, 공유는 허용되지 않습니다."
                    TextWrapping="Wrap" />
            </StackPanel>

            <Button
                Grid.Column="1"
                VerticalAlignment="Top"
                Content="프리셋">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel Width="280" Spacing="10">
                            <TextBlock FontWeight="SemiBold" Text="프리셋 관리" />

                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Grid.Column="0"
                                    PlaceholderText="새 프리셋 이름"
                                    Text="{x:Bind ViewModel.NewPresetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button
                                    Grid.Column="1"
                                    Command="{x:Bind ViewModel.SaveCurrentAsPresetCommand}"
                                    Content="저장" />
                            </Grid>

                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource SystemAccentColor}"
                                Text="{x:Bind ViewModel.PresetStatusMessage, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.HasPresetStatusMessage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <MenuFlyoutSeparator />

                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="저장된 프리셋" />

                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="저장된 프리셋이 없습니다."
                                Visibility="{x:Bind ViewModel.HasPresets, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}" />

                            <ScrollViewer MaxHeight="160">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Presets, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DiscoveryOptionPresetItemViewModel">
                                            <Grid Margin="0,3" ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Text="{x:Bind DisplayText}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <Button
                                                    Grid.Column="1"
                                                    Padding="6,2"
                                                    Click="OnLoadPresetButtonClicked"
                                                    Content="불러오기"
                                                    FontSize="11"
                                                    Tag="{x:Bind}" />
                                                <Button
                                                    Grid.Column="2"
                                                    Padding="6,2"
                                                    Click="OnDeletePresetButtonClicked"
                                                    Content="삭제"
                                                    FontSize="11"
                                                    Tag="{x:Bind}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!--  Selected users tray  -->
        <Border
            Grid.Row="1"
            MinHeight="56"
            Padding="8"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            CornerRadius="8">
            <Grid>
                <!--  Placeholder when no user is selected  -->
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource CaptionTextBlockFontSize}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="선택된 친구가 없습니다."
                    Visibility="{x:Bind ViewModel.HasSelectedUsers, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}" />

                <!--  Selected user avatar chips  -->
                <ScrollViewer
                    HorizontalScrollBarVisibility="Hidden"
                    HorizontalScrollMode="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled"
                    Visibility="{x:Bind ViewModel.HasSelectedUsers, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedUsers, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BaseSelectUserViewModel">
                                <Grid Width="46" Height="46">
                                    <Border
                                        Width="40"
                                        Height="40"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="20">
                                        <Image Source="{x:Bind ProfileThumbnailImageSource, Mode=OneWay}" Stretch="UniformToFill" />
                                    </Border>
                                    <Button
                                        Width="18"
                                        Height="18"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="{ThemeResource ControlOnImageFillColorDefaultBrush}"
                                        BorderThickness="0"
                                        Click="OnRemoveSelectedUserButtonClicked"
                                        CornerRadius="9"
                                        Tag="{x:Bind}">
                                        <FontIcon
                                            FontSize="10"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE711;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!--  Search box  -->
        <AutoSuggestBox
            Grid.Row="2"
            PlaceholderText="친구의 닉네임 또는 핸들 검색"
            QueryIcon="Find"
            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <!--  Validation message  -->
        <InfoBar
            x:Name="ValidationInfoBar"
            Grid.Row="3"
            IsOpen="False"
            Message="최소 한 명 이상의 친구를 선택해주세요."
            Severity="Warning" />

        <!--  Friends list  -->
        <Grid Grid.Row="4" MinHeight="160">
            <!--  Loading indicator  -->
            <ProgressRing
                Width="40"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

            <!--  List of friends  -->
            <ListView
                MaxHeight="260"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="4"
                IsItemClickEnabled="True"
                ItemClick="OnFriendItemClicked"
                ItemsSource="{x:Bind ViewModel.FilteredUsers, Mode=OneWay}"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:BaseSelectUserViewModel">
                        <Grid Padding="0,6" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid
                                Grid.Column="0"
                                Width="36"
                                Height="36">
                                <Border
                                    Width="36"
                                    Height="36"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="18">
                                    <Image Source="{x:Bind ProfileThumbnailImageSource, Mode=OneWay}" Stretch="UniformToFill" />
                                </Border>
                                <Border
                                    Width="12"
                                    Height="12"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="{ThemeResource ControlSolidFillColorDefaultBrush}"
                                    CornerRadius="6"
                                    Visibility="{x:Bind IsFavorite, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="2" Y="2" />
                                    </Border.RenderTransform>
                                    <FontIcon
                                        FontSize="10"
                                        Foreground="{StaticResource SystemAccentColor}"
                                        Glyph="&#xE735;" />
                                </Border>
                            </Grid>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="4">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    MaxLines="1"
                                    Text="{x:Bind Nickname, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#1a5bf3"
                                    Glyph="&#xF760;"
                                    Visibility="{x:Bind IsModerator, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#f78501"
                                    Glyph="&#xF760;"
                                    Visibility="{x:Bind IsAdmin, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>

                            <CheckBox
                                Grid.Column="2"
                                MinWidth="0"
                                Padding="0"
                                VerticalAlignment="Center"
                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!--  Empty state  -->
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="표시할 친구가 없습니다."
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>
    </Grid>
</ContentDialog>
