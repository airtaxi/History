<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="History.WindowsClient.Dialogs.ReplyMessageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:History.WindowsClient.ViewModels"
    Title="쪽지 답장"
    CloseButtonText="취소"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSend, Mode=OneWay}"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonText="보내기"
    Style="{ThemeResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <Grid Width="420" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="12,8"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            CornerRadius="8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="받는 사람:" />

                <PersonPicture
                    Grid.Column="1"
                    Width="28"
                    Height="28"
                    VerticalAlignment="Center"
                    ProfilePicture="{x:Bind ViewModel.ReceiverProfileImage, Mode=OneWay}" />

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    MaxLines="1"
                    Text="{x:Bind ViewModel.ReceiverName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <TextBox
            Grid.Row="1"
            MinHeight="130"
            MaxHeight="200"
            AcceptsReturn="True"
            MaxLength="100"
            PlaceholderText="쪽지 내용을 입력하세요 (최대 100자)"
            Text="{x:Bind ViewModel.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap" />

        <Button
            Grid.Row="2"
            Width="100"
            Height="100"
            Padding="0"
            HorizontalAlignment="Left"
            Background="Transparent"
            BorderThickness="0"
            Command="{x:Bind ViewModel.ClearAttachmentCommand, Mode=OneWay}"
            CornerRadius="8"
            ToolTipService.ToolTip="이미지 삭제"
            Visibility="{x:Bind ViewModel.AttachmentVisibility, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <Grid>
                <Image
                    Width="100"
                    Height="100"
                    Source="{x:Bind ViewModel.AttachmentImageSource, Mode=OneWay}"
                    Stretch="UniformToFill" />
                <Rectangle
                    Width="100"
                    Height="100"
                    Fill="Black"
                    Opacity="0.5" />
                <FontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="32"
                    Foreground="White"
                    Glyph="&#xE8BB;" />
            </Grid>
        </Button>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Width="32"
                Height="32"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Command="{x:Bind ViewModel.HandleMediaTapCommand, Mode=OneWay}"
                ToolTipService.ToolTip="이미지 추가">
                <FontIcon
                    FontSize="18"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE91B;" />
            </Button>

            <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.TextLengthText, Mode=OneWay}" />
        </Grid>
    </Grid>
</ContentDialog>
