<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="History.WindowsClient.Dialogs.WriteMessageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="쪽지 작성"
    CloseButtonText="취소"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSend, Mode=OneWay}"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonText="보내기"
    Style="{ThemeResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <Grid Width="420" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <AutoSuggestBox
                x:Name="ReceiverAutoSuggestBox"
                HorizontalAlignment="Stretch"
                ItemTemplate="{StaticResource FriendshipTemplate}"
                ItemsSource="{x:Bind ViewModel.SuggestedFriends, Mode=OneWay}"
                PlaceholderText="받는 사람 검색 (친구 닉네임 또는 핸들)"
                QueryIcon="Find"
                SuggestionChosen="OnReceiverSuggestionChosen"
                TextChanged="OnReceiverTextChanged"
                TextMemberPath="Nickname"
                Visibility="{x:Bind ViewModel.IsNotReceiverSelected, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />

            <Border
                Padding="12,8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.IsReceiverSelected, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="받는 사람:" />

                    <PersonPicture
                        Grid.Column="1"
                        Width="28"
                        Height="28"
                        VerticalAlignment="Center"
                        ProfilePicture="{x:Bind ViewModel.ReceiverProfileImage, Mode=OneWay}" />

                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            Text="{x:Bind ViewModel.ReceiverName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#1a5bf3"
                            Glyph="&#xF760;"
                            Visibility="{x:Bind ViewModel.IsReceiverModerator, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#f78501"
                            Glyph="&#xF760;"
                            Visibility="{x:Bind ViewModel.IsReceiverAdmin, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                    </StackPanel>

                    <Button
                        Grid.Column="3"
                        Width="28"
                        Height="28"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnClearReceiverButtonClicked"
                        ToolTipService.ToolTip="수신자 변경">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <TextBox
            Grid.Row="1"
            MinHeight="130"
            MaxHeight="200"
            AcceptsReturn="True"
            MaxLength="100"
            PlaceholderText="쪽지 내용을 입력하세요 (최대 100자)"
            Text="{x:Bind ViewModel.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap" />

        <Button
            Grid.Row="2"
            Width="100"
            Height="100"
            Padding="0"
            HorizontalAlignment="Left"
            Background="Transparent"
            BorderThickness="0"
            Command="{x:Bind ViewModel.ClearAttachmentCommand, Mode=OneWay}"
            CornerRadius="8"
            ToolTipService.ToolTip="이미지 삭제"
            Visibility="{x:Bind ViewModel.AttachmentVisibility, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <Grid>
                <Image
                    Width="100"
                    Height="100"
                    Source="{x:Bind ViewModel.AttachmentImageSource, Mode=OneWay}"
                    Stretch="UniformToFill" />
                <Rectangle
                    Width="100"
                    Height="100"
                    Fill="Black"
                    Opacity="0.5" />
                <FontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="32"
                    Foreground="White"
                    Glyph="&#xE8BB;" />
            </Grid>
        </Button>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Width="32"
                Height="32"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Command="{x:Bind ViewModel.HandleMediaTapCommand, Mode=OneWay}"
                ToolTipService.ToolTip="이미지 추가">
                <FontIcon
                    FontSize="18"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE91B;" />
            </Button>

            <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.TextLengthText, Mode=OneWay}" />
        </Grid>
    </Grid>
</ContentDialog>
